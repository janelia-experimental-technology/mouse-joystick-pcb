
(rules PCB mouse-joystick-pcb.dsn
  (snapAngle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 150.0 (type "PWR_5V_LOCAL"))
    (clearance 200.0 (type BOOTSTRAP))
    (clearance 500.0 (type "PWR_HV_ENTRY"))
    (clearance 200.0 (type "USB_HS"))
    (clearance 150.0 (type "PWR_12V_LOCAL"))
