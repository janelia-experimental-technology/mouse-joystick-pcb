	(text "${99bab957-2cfe-433d-b53f-598b050d3ea9:REFERENCE}, ${e120acbd-b411-4229-b638-bead54b224d1:REFERENCE} and ${80a264e6-bd6c-467a-b2b1-8c1cab27455c:REFERENCE} tap ENABLE, DIAG_ENABLE and ~{FAULT} through 1 k each for the INSTRUMENT ports; the block owns these signals, so the taps live here" (at 15.24 229.216 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ed525f77-5f8f-5115-aa43-5a63a0d89d48"))
	(text "(convention 14)." (at 15.24 231.756 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5f2d203c-258e-5b68-b89e-79009329a3a2"))
	(text "Instrument tap, 1 k" (at 20.32 261.366 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ef293cb7-051e-5f5e-9190-81e57090a9ea"))
	(text "Instrument tap, 1 k" (at 68.959779 261.366 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "73a2681b-f287-5703-b4ac-9e6ece630376"))
	(text "Instrument tap, 1 k" (at 128.313524 261.366 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4b85401e-51de-5dcc-b01d-2e709dc50f40"))
	(text "PLACE: Place the three taps in a row near the port side of the block; their port copper is a via each (convention 1)." (at 15.24 266.446 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2d47902d-fde2-5b10-ab0c-8108f3d4f493"))
	(text "ROUTE: INSTRUMENT class to the ports; a tap that is not probed is left open at the via." (at 15.24 270.256 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c0775d1d-c8ea-53e7-bb85-d1031b48d722"))
	(polyline (pts (xy 219.5 255.584592) (xy 399.5 255.584592)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "4781ced4-27bd-55f2-bf5e-1c8457a5faa6"))
	(text "6. Load-current sense output" (at 219.5 258.124592 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "092c5591-1ba7-545b-b286-114b96b13129"))
	(text "${f074ca38-0248-4de7-9003-e5f54f644060:REFERENCE} at the SNS pin converts the sense current to a voltage; ${fcf704b4-bee3-4733-ba64-998bdbc17627:REFERENCE} and ${37efda07-85f2-476b-ad7e-bab9b179475a:REFERENCE} filter it toward the SNS port." (at 219.5 262.274592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1bb338cb-e8f3-5878-a1f3-6941e1633678"))
	(text "SNS filter series, 1 k" (at 242.36 291.846 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "dac36a8a-bf88-5136-be76-423fb1e1a32b"))
	(text "SNS output filter" (at 242.36 328.344592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3e3442a7-acba-574a-b364-7c40e1bba393"))
	(text "PLACE: Place ${f074ca38-0248-4de7-9003-e5f54f644060:REFERENCE} directly at pin 6 with a short return to GND, then ${fcf704b4-bee3-4733-ba64-998bdbc17627:REFERENCE} and ${37efda07-85f2-476b-ad7e-bab9b179475a:REFERENCE} after it; a resistor or capacitor between the pin and ${f074ca38-0248-4de7-9003-e5f54f644060:REFERENCE} changes the" (at 219.5 333.424592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "77afc697-8df6-546e-9824-a9bc3d53bcb2"))
	(text "sense ratio." (at 219.5 335.964592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f90c92d5-06de-54a7-ba90-47afb03348ba"))
	(text "ROUTE: SNS_PROT is a low-level analog node; route it away from the HV_IN and +36V copper and give ${37efda07-85f2-476b-ad7e-bab9b179475a:REFERENCE} a return next to ${f074ca38-0248-4de7-9003-e5f54f644060:REFERENCE}'s." (at 219.5 339.774592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "285b3677-aa15-55d6-853a-679eb9eda99a"))
	(polyline (pts (xy 15.24 281.686) (xy 195.24 281.686)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "b71d2bd9-f7a7-54f8-b649-68749b339f83"))
	(text "7. Power drive declarations" (at 15.24 284.226 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "1f4f5e6f-b91d-554a-9b9c-6370f153fa4b"))
	(text "These nets have an explicit ERC power source declaration." (at 15.24 288.376 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2d28df7c-8238-54f5-87b0-c30c19b066e6"))
	(text "Power driven: HV_IN" (at 20.32 324.759567 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d71aaa52-0ae3-5dff-9e12-092f45db9989"))
	(text "INTERFACES" (at 423.76 39.182 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "df5fab03-3913-590e-9960-162ba3f875e4"))
	(text "Pull-up supply for ~{FAULT} through ${4d9e005c-2df5-444f-86f2-c10bbc334ddf:REFERENCE} (10 k); draws only the pull-up current." (at 423.76 52.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0321c622-af8f-5e80-9921-06aafeed42be"))
	(text "Logic input through ${ea304dcd-b413-4f8d-b22e-5f0f62389f7d:REFERENCE} (1 k) to EN; ${46f86808-0f12-4b59-b5d5-64d7f6fc87f2:REFERENCE} holds EN low, so the rail is off until driven." (at 423.76 64.77 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c43a19f3-456d-5e64-868b-e78ef8bee00c"))
	(text "Logic input through ${6992a98e-078f-4776-bf3b-a22e0ae0b932:REFERENCE} (10 k) to DIAG_EN; must be driven high for SNS and the diagnostics, open reads low." (at 423.76 77.47 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0b1bf2c7-ab2a-5633-9166-fd3fb7ef329a"))
	(text "Logic input through ${1c88f588-9a44-4887-9bd0-3412326f1649:REFERENCE} (10 k) to LATCH; selects latched shutdown or automatic retry after a fault." (at 423.76 90.17 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "78aacc83-9a13-5bfd-a0df-910ff825d430"))
	(text "Fault flag through ${514521ed-d44b-4f06-9722-25f9009251bb:REFERENCE} (10 k), pulled up to +3.3V_MCU by ${4d9e005c-2df5-444f-86f2-c10bbc334ddf:REFERENCE}; low during a fault." (at 423.76 102.87 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8ed433d8-ca17-51e4-ad9a-96fb9faf938e"))
	(text "Analog load-current output, about 0.31 V per ampere, filtered by ${fcf704b4-bee3-4733-ba64-998bdbc17627:REFERENCE} and ${37efda07-85f2-476b-ad7e-bab9b179475a:REFERENCE} (10 us)." (at 423.76 115.57 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "24fa3ee9-75cc-5e8e-9571-85ce97dc453f"))
	(text "Protected input after ${6584037a-df5c-481c-be6d-17e3e430d517:REFERENCE} and before the switch, bypassed by ${709c3d68-6a22-41fe-bb8f-1b3c74efa230:REFERENCE}; available to the board unswitched." (at 423.76 128.27 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b16de7b8-5e4a-58a8-992c-e2d4b1f92301"))
	(text "Switched, current-limited 36 V rail from ${fc7d50ec-17b6-455e-92c7-d4ac9f6e233b:REFERENCE} VOUT (pins 8-10); off until ENABLE is high." (at 423.76 138.43 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ea71ac45-87e2-5e73-9ae4-61e00eeea10e"))
	(text "Return: terminal pin 1, switch GND (pin 1) and thermal pad (pin 15), bypass, ILIM and sense returns." (at 423.76 148.59 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a96a5924-81bd-5c0c-96d9-3a104c83daa3"))
	(text "Instrument tap of DIAG_ENABLE through ${e120acbd-b411-4229-b638-bead54b224d1:REFERENCE} (1 k), INSTRUMENT class." (at 423.76 158.75 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b646651d-6bef-5fcb-848e-e77b5ddaf3c0"))
	(text "Instrument tap of ENABLE through ${99bab957-2cfe-433d-b53f-598b050d3ea9:REFERENCE} (1 k), INSTRUMENT class." (at 423.76 168.91 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3d5a56af-bc76-5072-9f9c-80c85affe0c8"))
	(text "Instrument tap of ~{FAULT} through ${80a264e6-bd6c-467a-b2b1-8c1cab27455c:REFERENCE} (1 k), INSTRUMENT class." (at 423.76 179.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e97f8250-c912-56e4-bcb4-43aae1333b6d"))
	(polyline (pts (xy 423.76 195.21) (xy 578.76 195.21)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "08893afc-762c-515b-8327-dc42cf32c77d"))
	(text "OPERATION" (at 423.76 197.75 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "6ad6fb04-b525-58e1-a459-7f49d97bf858"))
	(text "Signal path: ${edd8ca6e-95e5-4890-b15e-f0b0125b7404:REFERENCE} pin 2 (HV_RAW) -> ${6584037a-df5c-481c-be6d-17e3e430d517:REFERENCE} anode to cathode -> HV_IN -> ${fc7d50ec-17b6-455e-92c7-d4ac9f6e233b:REFERENCE} VS (pins 12-14) -> VOUT (pins 8-10) -> +36V;" (at 423.76 201.9 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "77015cfc-9e5a-505c-bb96-4d993dc01b7d"))
	(text "${edd8ca6e-95e5-4890-b15e-f0b0125b7404:REFERENCE} pin 1 is GND. ${6584037a-df5c-481c-be6d-17e3e430d517:REFERENCE} (SBRT15U50SP5-13, 50 V 15 A super-barrier rectifier) blocks a reversed supply and drops under 0.44 V at these" (at 423.76 204.44 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "61d69a26-66c8-5e0e-b49f-1f6adaae1dc1"))
	(text "currents. The terminal is polarity-definite: pin 2 is the supply, pin 1 the return. HV_IN is also a port, so a board can take the protected but" (at 423.76 206.98 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0f027cdd-2568-5e38-b345-c6d92c613606"))
	(text "unswitched supply. Electrically this is the horizontal hv_input_36V_terminal_2pos_5p08_protected block plus three instrument taps." (at 423.76 209.52 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "65fc90ee-54a8-5007-b683-3d60cba8e13b"))
	(text "${fc7d50ec-17b6-455e-92c7-d4ac9f6e233b:REFERENCE} (TPS1HTC100-Q1, 6 to 60 V, 83 mohm) switches the rail. EN (pin 2) is driven from ENABLE through ${ea304dcd-b413-4f8d-b22e-5f0f62389f7d:REFERENCE} (1 k) and held low by" (at 423.76 213.33 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4545800d-4ad9-5a65-9e51-f80f4c270795"))
	(text "${46f86808-0f12-4b59-b5d5-64d7f6fc87f2:REFERENCE} (10 k): +36V is off until the board drives ENABLE high; supply UVLO releases at about 5.4 V. ${ccedec14-0e0a-4e56-bdc4-483a87378948:REFERENCE} (40 k) on ILIM programs the current" (at 423.76 215.87 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8327eefa-a6be-508a-889c-e7d88b1835a5"))
	(text "limit at about 1.2 A typical (0.9 to 1.4 A) with a 1.5x transient peak allowance; ILIM must never float (an open ILIM selects the 7.3 A internal default)." (at 423.76 218.41 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d3585378-3bfb-5322-bd75-de0d0bbcf9ee"))
	(text "Thermal shutdown is 165 C typical, retry about 2 ms." (at 423.76 220.95 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c80e6ec7-4856-5949-8108-77f12ae28f71"))
	(text "DIAG_ENABLE reaches DIAG_EN (pin 3) through ${6992a98e-078f-4776-bf3b-a22e0ae0b932:REFERENCE} (10 k) and must be driven high for the analog sense and the open-load and short-to-battery" (at 423.76 224.76 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6fc5f403-d9b8-5fed-a307-4be0871ce032"))
	(text "diagnostics; open, the internal 200 to 500 k pull-down reads it low. LATCH reaches pin 5 through ${1c88f588-9a44-4887-9bd0-3412326f1649:REFERENCE} (10 k) and selects latched shutdown or" (at 423.76 227.3 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8161884f-fa48-5607-a404-445848b6e8d4"))
	(text "automatic retry. ~{FAULT} (pin 4) is open-drain, pulled up by ${4d9e005c-2df5-444f-86f2-c10bbc334ddf:REFERENCE} (10 k) to +3.3V_MCU and brought out through ${514521ed-d44b-4f06-9722-25f9009251bb:REFERENCE} (10 k); low during a" (at 423.76 230.74 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9e3ae28c-15d0-508e-8911-3dd3657a81f8"))
	(text "fault. ENABLE, DIAG_ENABLE and ~{FAULT} each have a 1 k instrument tap (${99bab957-2cfe-433d-b53f-598b050d3ea9:REFERENCE}, ${e120acbd-b411-4229-b638-bead54b224d1:REFERENCE}, ${80a264e6-bd6c-467a-b2b1-8c1cab27455c:REFERENCE}) to the INSTRUMENT-class ports; shared bus" (at 423.76 234.18 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d8458889-8ef3-506a-b86f-e694ffd0b7bd"))
	(text "lines are tapped by the board, these are the block's own signals (convention 14)." (at 423.76 236.72 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f177d23d-acc5-5867-93e8-d0e4767a3a1c"))
	(text "SNS (pin 6) sources load current divided by 800 (KSNS): ${f074ca38-0248-4de7-9003-e5f54f644060:REFERENCE} (249 ohm) at the pin converts it to about 0.311 V per ampere (about 0.37 V at the" (at 423.76 240.53 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7826d8f4-8b8a-5632-82a1-41609eb19a83"))
	(text "1.2 A limit; a fault drives about 5.2 mA, about 1.3 V). ${fcf704b4-bee3-4733-ba64-998bdbc17627:REFERENCE} (1 k) and ${37efda07-85f2-476b-ad7e-bab9b179475a:REFERENCE} (10 nF) filter it toward the SNS port (10 us); keeping ${f074ca38-0248-4de7-9003-e5f54f644060:REFERENCE} at" (at 423.76 243.07 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "77775dd2-7775-5bf0-b017-5382609924f2"))
	(text "the pin and the filter after it preserves the ratio." (at 423.76 245.61 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ee72a714-62c2-54ca-9cdb-59c0798ef5f3"))
	(text "No TVS and no power LED in this variant. ${709c3d68-6a22-41fe-bb8f-1b3c74efa230:REFERENCE} (220 nF, 100 V X7R) bypasses HV_IN; ${5c7b0e5f-9255-431b-ba8e-9839802417b5:REFERENCE} (22 nF, 100 V) holds the switched output. ${edd8ca6e-95e5-4890-b15e-f0b0125b7404:REFERENCE}" (at 423.76 249.42 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b878829a-5b08-5731-ad7c-6aded92631ec"))
	(text "is the vertical, top-entry Phoenix MSTBVA 2,5/2-G-5,08 (rated 12 A 250 V): the wire leaves perpendicular to the board, so the enclosure needs an" (at 423.76 251.96 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2956e783-03db-5a71-9489-b0dc7b7db86d"))
	(text "aperture above it plus clearance for the plug body, its screw heads and the wire loop." (at 423.76 254.5 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3074c7ed-feae-5175-9962-df7dc2487bcf"))
	(polyline (pts (xy 423.76 265.93) (xy 578.76 265.93)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "4293e345-ae58-533c-a15e-6f1c561af6c1"))
	(text "DESIGN NOTES" (at 423.76 268.47 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "34d99466-4fc5-5a62-947d-6b3a6230f240"))
	(text "R_ILIM I_CL min typ max source 49.9k / 50k 0.73 A 0.92 A 1.11 A datasheet 40k 0.9 A 1.2 A 1.4 A computed 25k 1.5 A 1.96 A 2.3 A datasheet 20k" (at 423.76 272.62 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b8865630-3a44-5de9-b5e0-fae08d31038f"))
	(text "1.9 A 2.5 A 2.9 A computed 16.7k 2.3 A 3.0 A 3.5 A datasheet 10k 4.0 A 5.3 A 6.3 A datasheet open or GND 6.1 A 7.3 A 8.6 A datasheet - do not" (at 423.76 275.16 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e81e3e38-8bcf-5289-8824-f72d5e0b0ea4"))
	(text "use" (at 423.76 277.7 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f3e87d40-b730-5221-862d-c1c414414457"))
	(polyline (pts (xy 423.76 289.13) (xy 578.76 289.13)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "a6a9e59a-c178-5418-b1b5-88bd750d1888"))
	(text "DESIGN CONTRACT" (at 423.76 291.67 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "5ce3c55f-5123-58b0-9870-292cf976c158"))
	(text "Protected and electronically switched 36 V high-voltage input front end on a VERTICAL, top-entry 2-position 5.08 mm pluggable terminal block" (at 423.76 295.82 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "52391e1b-569c-5e78-94b8-cdafa64cd9c2"))
	(text "(Phoenix MSTBVA 2,5/2-G-5,08, OW-CONN-TBH-1X02-5P08-VERT, on the local orb_weaver_tht copy of the MSTBVA footprint) with a SBRT15U50SP5" (at 423.76 298.36 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c88c5daa-7f41-5eb9-92f3-90d827ff3327"))
	(text "reverse-polarity series diode and a TPS1HTC100-Q1 smart high-side switch providing adjustable current limit, inrush/soft-start control, analog" (at 423.76 300.9 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a2e6d672-b0e8-5f47-b125-7f18fceb2e5f"))
	(text "load-current sense, thermal shutdown, and an integrated inductive discharge clamp. ENABLE is pulled low through ${46f86808-0f12-4b59-b5d5-64d7f6fc87f2:REFERENCE} (10 k) so the rail stays" (at 423.76 303.44 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "55fe6589-9146-523e-a9f7-78c2f8566e61"))
	(text "off until driven. No input TVS or power-present LED is populated in this variant, unlike the 24 V barrel-jack and terminal-block variants. Intended for" (at 423.76 305.98 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "26c171d8-ca53-5309-90ae-7397d6ffebff"))
	(text "HV/VMOT entry rails feeding stepper drivers, brake supplies, and downstream regulation." (at 423.76 308.52 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d10b7592-bf4b-5eb4-8dfa-8bbb7a1c09d7"))
	(text "Electrically the horizontal hv_input_36V_terminal_2pos_5p08_protected block, port for port (+3.3V_MCU, +36V, DIAG_ENABLE, ENABLE, GND, HV_IN, LATCH," (at 423.76 311.06 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "be6fa59a-55d1-5e77-9402-a0e10c8013e2"))
	(text "SNS, ~FAULT), plus three 1 k instrument taps (ENABLE_INST, DIAG_ENABLE_INST, ~FAULT_INST) on the block's own signals. Signal path is terminal pin 2" (at 423.76 313.6 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a126ac45-caaa-5157-8777-bc0bbf9926ab"))
	(text "to HV_RAW, through ${6584037a-df5c-481c-be6d-17e3e430d517:REFERENCE} to HV_IN and the TPS1HTC100 VS pins, out VOUT as the switched +36V rail; terminal pin 1 is GND. THE TERMINAL IS" (at 423.76 316.14 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c5d6b1e1-3c5d-56ff-a5f4-a3c3e25d3ee6"))
	(text "POLARITY-DEFINITE, not polarity-agnostic." (at 423.76 318.68 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2829397b-8fab-5751-bb01-bdf582ef69d6"))
	(text "${ccedec14-0e0a-4e56-bdc4-483a87378948:REFERENCE} = 40 kOhm on ILIM sets the current limit, giving I_CL of 0.9 A min / 1.2 A typ / 1.4 A max with a 1.5x transient peak allowance, and" (at 423.76 321.22 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b64b1fc7-6953-5e5e-b667-1e751c2f8f4f"))
	(text "${f074ca38-0248-4de7-9003-e5f54f644060:REFERENCE} = 249 Ohm at the SNS pin sets the SNS scaling (about 0.311 V per ampere); ${fcf704b4-bee3-4733-ba64-998bdbc17627:REFERENCE} (1 k) and ${37efda07-85f2-476b-ad7e-bab9b179475a:REFERENCE} (10 nF) filter it toward the SNS" (at 423.76 323.76 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a9acea08-1ca1-5208-98f4-903ebc4599b2"))
	(text "port. DIAG_EN must be driven HIGH or the analog sense and the open-load and short-to-battery diagnostics are all disabled, and ILIM must NEVER" (at 423.76 326.3 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3ec2d31f-1189-551d-ac33-7f46cc658ec4"))
	(text "float - floating selects the internal default limit and is itself a fault state per datasheet Table 4-2. ~FAULT is open-drain, pulled up by ${4d9e005c-2df5-444f-86f2-c10bbc334ddf:REFERENCE} (10" (at 423.76 328.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "250b46b9-5476-539c-825d-28360669ec68"))
	(text "k) to +3.3V_MCU, which is only that pull-up supply: it and LATCH are Default-class ports, and no placing board should class +3.3V_MCU as a rail." (at 423.76 331.38 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6353fc01-64bc-53c5-b90b-ea8bdb6b36da"))
	(text "The terminal is pad-COMPATIBLE with the horizontal 5.08 mm part, not pad-IDENTICAL: pitch is 5.08 mm in both and pin order ascends in +x in both," (at 423.76 333.92 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2a046398-3b74-5611-8444-ad80e5926760"))
	(text "but the pad goes from 2.5 x 2.5 mm on a 1.5 mm drill to 2.08 x 3.6 mm on a 1.4 mm drill, the Phoenix-recommended layout for the MSTBVA pin." (at 423.76 336.46 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4d6c77a4-bf28-50db-a783-9526e3eb642f"))
	(text "The narrow-axis annular ring shrinks from 0.50 mm to 0.34 mm, still about 1.9x the 0.18 mm JLCPCB routine PTH minimum; the pad-to-pad gap" (at 423.76 339 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f62fee44-5858-5e59-9a78-3fc0a207c218"))
	(text "improves from 2.58 mm to 3.00 mm against the 0.50 mm clearance PWR_HV_ENTRY asks of HV_IN; hole-to-hole is 3.68 mm against a 0.45 mm" (at 423.76 341.54 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "454b219a-baa9-5ecc-b628-e2fdede03130"))
	(text "minimum. Re-run DRC after placing rather than trusting these numbers." (at 423.76 344.08 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "95ade5a9-8b93-5c10-b176-9b86f6683f22"))
	(text "The footprint anchor differs: the horizontal PHOENIX_1757242 is anchored 10 mm off its own pads with pin 1 at (3.54, -10.00); the vertical puts pin" (at 423.76 346.62 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4173fdc5-f0ae-578a-849c-8dbae5b46622"))
	(text "1 at the origin. Migrating an existing placement means changing the part and then moving the footprint by (+3.54, -10.00) so pad 1 returns to its" (at 423.76 349.16 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "954e3bea-e9ca-53ab-9bd1-07d9eb8720bf"))
	(text "old absolute position; the connector is the only part whose pads move. The mechanical envelope inverts: relative to pad 1 the horizontal courtyard" (at 423.76 351.7 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c8e67ab5-cf96-5dac-b395-cb08ce6e374a"))
	(text "runs x -3.79 to +8.87, y -2.25 to +10.25; the vertical runs x -4.04 to +9.13, y -5.30 to +4.30. Outboard overhang collapses from 10.25 mm to" (at 423.76 354.24 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "55de7b2a-bd3d-54b8-a3ea-307c1dc8da1f"))
	(text "4.30 mm so the terminal can move inboard, while the inboard keepout grows from 2.25 mm to 5.30 mm, so a swap in place can collide with whatever" (at 423.76 356.78 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5bca4852-6159-58ee-8b9d-68e2181c9c68"))
	(text "sits behind the connector even though the pitch did not change." (at 423.76 359.32 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "14ead078-22b3-5f6d-8af5-e4fa9f30daf6"))
	(text "DO NOT ROTATE 180 DEGREES to make the wire entry face outboard: pin order runs the same direction in both footprints, so rotating swaps GND and" (at 423.76 361.86 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5d9e2a68-1ddc-53e6-a753-c0f96119e976"))
	(text "the +36 V raw input in board space. The series diode blocks reverse polarity only while the input supply FLOATS; on a board whose GND is shared with" (at 423.76 364.4 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "92b5462b-43d0-52d1-80d2-1a15a0475b16"))
	(text "USB, the pyControl port, and the InstrumentPort, a reversed terminal puts the supply across those grounds instead and the diode protects nothing. The" (at 423.76 366.94 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5679a46c-9ecc-514b-8ab7-8e2d96e44495"))
	(text "wire leaves perpendicular to the board, so the enclosure needs an aperture above the terminal plus clearance for the mating MSTB plug body, its" (at 423.76 369.48 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "56adab33-c55b-5603-b2ad-e292923cf51f"))
	(text "screw heads, and the wire loop." (at 423.76 372.02 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7870e899-b18b-567e-a6d7-fceb743030cb"))
	(group "Review page 01: 1. Entry and reverse-polarity protection" (uuid "d3cdef29-4d28-540a-8d4b-cf1620b5f4bb") (members "edd8ca6e-95e5-4890-b15e-f0b0125b7404" "d8635e4f-eca1-5fa7-85c0-b57eccca2125" "219dd0bd-b798-5a72-90b3-1c6715f3fd1c" "dbc46abf-32c7-56f5-963a-9c86a158145c" "df80ee10-2100-5c48-a50b-7f8b71af59af" "74b305d6-1e1f-51a5-86a5-14ce368cb0aa" "fb0b1d36-89eb-5023-a9f9-a91bebb21d01" "4a10f47f-5b96-532b-915d-19189d3f0f80" "8013ce43-93d4-5db7-852a-a9fb6fa2ccb4" "6ba0164c-a3c3-543a-b16f-d48d31d6ae18" "6f4cebc9-f929-59f9-b552-7cc38e2bdee1" "42a20333-cb15-54a0-9176-4fad793699db" "b7baa1bf-f7bd-5a98-902c-d7bc43a9c77f" "75a720ee-bb07-5025-9f3e-91dc40ae3c41" "cfd8129a-07c7-55c2-94b8-b37199b408ca"))
