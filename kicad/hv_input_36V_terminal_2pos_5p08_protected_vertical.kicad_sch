	(text "${ea304dcd-b413-4f8d-b22e-5f0f62389f7d:REFERENCE} feeds EN from ENABLE and ${46f86808-0f12-4b59-b5d5-64d7f6fc87f2:REFERENCE} holds it low; ${6992a98e-078f-4776-bf3b-a22e0ae0b932:REFERENCE} and ${1c88f588-9a44-4887-9bd0-3412326f1649:REFERENCE} bring DIAG_ENABLE and LATCH to their pins through 10 k each." (at 15.24 115.016 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e89fe744-5662-5001-bbf7-f9732fedb852"))
