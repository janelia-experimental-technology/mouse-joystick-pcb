	(text "InstrumentPort-Digital-50 DUT boundary | four SN74LV541A octets, 100 ohm damping, enabled by hardware" (at 15.24 15.24 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "4ee97382-e756-5422-ba12-1b3ecf699268"))
	(text "DUT-side InstrumentPort-Digital-50 with integrated read-only buffering, on a VERTICAL, top-entry 50-contact ZIF connector: Hirose FH12-50S-0.5SVA(54), OW-CONN-FH12-50S-0-5SVA-54, LCSC C597991, 0.5mm pitch, symbol Conn_01x50, footprint orb_weaver_connectors:Hirose_FH12-50S-0.5SVA_1x50-4MP_P0.5mm_Vertical; the four mechanical lands are unnumbered pads and carry no net." (at 15.24 21.082 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "d345a653-c47e-5132-be4c-2ea6320c4c14"))
	(text "Matching net labels are connected. Group order explains function; PCB placement priorities are stated below." (at 15.24 26.322 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "195954ab-4e39-53b6-9d7f-29370d48b806"))
	(polyline (pts (xy 15.24 36.482) (xy 195.24 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "221e9234-d17f-5849-871f-e6de0e5996c5"))
	(text "1. Octet DIG0 to DIG7: ${7e0cdabf-d9e1-4b13-ab00-5a4417fdb564:REFERENCE}" (at 15.24 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "f0f41dce-ec7a-5f46-928f-e3eebb786e6c"))
	(text "${7e0cdabf-d9e1-4b13-ab00-5a4417fdb564:REFERENCE} buffers DIG0 to DIG7 (inputs A8 to A1, pins 9 to 2) onto Y8 to Y1 (pins 11 to 18); ${fad54bc1-8b2f-4c3f-a18e-9b2430ab141a:REFERENCE} to ${fcea49a0-ea4d-4aee-9697-0faa5db34934:REFERENCE} (100 ohm) damp each output into its connector contact." (at 15.24 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8f8e72ff-3608-53fd-9e40-367ad9bd83ab"))
	(text "${32c854d3-e295-4ed0-ae67-c404202c33c2:REFERENCE} bypasses VCC (pin 20); ${84c143f8-b8f7-412f-b388-3f55d62abdd6:REFERENCE} holds both enables (pins 1 and 19) low." (at 15.24 45.712 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "81671096-ac5f-5587-add4-6e4d790ed4c4"))
	(text "VCC pin 20 bypass, 100 nF" (at 44.209141 87.044592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "268e00cd-56f7-5654-8bb2-a9967e64a0bb"))
