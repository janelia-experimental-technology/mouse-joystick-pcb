	(text "Observation input 20 into ${69119102-0ebd-473d-a7cb-d952bc88de42:REFERENCE} A4 (pin 5); leaves on contact 33." (at 670.76 295.91 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f04ff040-2be5-503a-bf66-c2aff4f67ad2"))
	(text "Observation input 21 into ${69119102-0ebd-473d-a7cb-d952bc88de42:REFERENCE} A3 (pin 4); leaves on contact 34." (at 670.76 308.61 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6f0ef04d-69b2-5694-8bc5-c3a274f11ccc"))
