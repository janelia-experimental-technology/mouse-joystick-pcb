	(text "Encoder channel B, raw 5 V push-pull from the harness; ${fcea27a1-25e8-4535-8db3-33361bde811c:REFERENCE} to GND, ${9c095d77-bc49-4401-aec8-d7ddc8bd052d:REFERENCE} in series." (at 423.76 97.79 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8cb274a2-536d-5ea3-802d-042f0668948a"))
	(text "Channel A as 3.3 V logic from ${cf752abf-0e0c-412d-a73f-c1eaff636f88:REFERENCE} 1Y (pin 6); ${e69b9f00-5592-4480-9192-6b0f166869f7:REFERENCE} holds it low when unpowered." (at 423.76 110.49 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cce8cb43-5653-5cee-ac1b-207a62c4d63d"))
	(text "Channel B as 3.3 V logic from ${cf752abf-0e0c-412d-a73f-c1eaff636f88:REFERENCE} 2Y (pin 4); ${3347de5d-a753-454e-ab35-f4f87e410fba:REFERENCE} holds it low when unpowered." (at 423.76 123.19 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b156f6df-2623-5de1-a3d0-2679e2dda47c"))
