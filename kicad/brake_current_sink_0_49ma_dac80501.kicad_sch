	(text "${08cbd8a3-a149-4ecc-b0c2-6c033868ce5a:REFERENCE} integrates V_SET minus V_SENSE (${95087510-a598-41dc-8aa9-102972a7eabc:REFERENCE}, ${21316207-7816-4227-9930-9a77fe5f89b6:REFERENCE}) into LOOP_OUT and drives GATE through ${38494b98-1b0e-4e75-a369-34fccb4e7655:REFERENCE}; ${fda58dd6-cd98-4d05-9dc4-31853c12ca38:REFERENCE} pulls the gate down;" (at 343 46.772 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1466a59b-b6c5-5fc2-abca-fe2e74a1d203"))
