	(text "Brake current sink 0-48.78 mA | DAC80501 on I2C, OPA197 loop, BUK7D36-60EX, 10 ohm Kelvin shunt, 56.4 mA ceiling" (at 15.24 15.24 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "398e3185-ee0a-5d76-b257-103bcc9f6b4e"))
	(text "DAC-programmed linear constant-current sink delivering 0-48.78 mA into a 24 V magnetic particle brake coil from a 36 V rail: a DAC80501ZDGSR at 3.3 V on I2C feeding a 0.19512 precision divider, an OPA197 integrating error amplifier on a ferrite-filtered 12 V rail driving a BUK7D36-60EX pass device over a 10 ohm Kelvin shunt, a second OPA197 as an independent 56.4 mA current ceiling that clamps the gate through a Schottky, a third as a 0-1.006 V ground-referenced current monitor behind a /2 output divider, an SN74LVC2G17 buffering the ceiling event out as active-low ~{BRAKE_FAULT}, and an S115Q flyback across the in-block 2-position 3.5 mm" (at 15.24 21.982 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "a81f5027-8b47-5cbf-9252-db2f8e3f7e78"))
	(text "vertical coil terminal." (at 15.24 24.682 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "064693ab-994d-53c4-ae2c-4cd1d1e203ca"))
	(text "Matching net labels are connected. Group order explains function; PCB placement priorities are stated below." (at 15.24 29.922 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c0f263ef-cae4-5f1e-b496-c3e3d507a0ba"))
	(polyline (pts (xy 15.24 40.082) (xy 171.5 40.082)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "226a13da-a05e-583d-bfa8-b7237cac2651"))
	(text "1. DAC and address straps" (at 15.24 42.622 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "c2e09b08-b27e-5bdb-8fbb-0014960ecd6b"))
	(text "${13e865f2-50d2-4ef4-96e5-21e4006290dd:REFERENCE} generates 0-2.5 V on its internal reference; ${493d2774-a1a7-4c9c-b48f-017c5dbcc954:REFERENCE} selects I2C, ${fdb3e77c-64e0-4135-b4df-fa9baa347a58:REFERENCE} sets the address 0x49, ${39f0b732-cf41-41c9-9a59-3df4bbf9c079:REFERENCE} bypasses VREFIO." (at 15.24 46.772 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3daf3880-b597-5159-96a2-6f649bbbd173"))
	(text "16-bit I2C DAC, internal 2.5 V reference" (at 20.32 175.148721 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2adfe2b0-3702-59c0-9756-0c3c79fb59d3"))
	(text "${fdb3e77c-64e0-4135-b4df-fa9baa347a58:REFERENCE}: A0 strap to VDD, address 0x49" (at 20.32 177.688721 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fa6048cf-df78-562b-887c-d1687a18315d"))
	(text "${493d2774-a1a7-4c9c-b48f-017c5dbcc954:REFERENCE}: SPI2C strap to VDD, I2C mode" (at 20.32 180.228721 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "719f1ea0-f8ad-5b6b-b158-61e081230359"))
	(text "${39f0b732-cf41-41c9-9a59-3df4bbf9c079:REFERENCE}: VREFIO reference bypass" (at 20.32 182.768721 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3b207f6a-bb1b-51eb-8ea7-badc44af51a7"))
	(text "${aa02be14-68dc-4538-951d-4c61efba8dff:REFERENCE}, ${e87c15c9-ff98-462b-bbf6-693983a3f27d:REFERENCE}: ${13e865f2-50d2-4ef4-96e5-21e4006290dd:REFERENCE} VDD pin 1 bypass" (at 20.32 185.308721 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b8a35838-7b28-5c4f-b078-c3bc2fdd10e8"))
	(text "PLACE: ${39f0b732-cf41-41c9-9a59-3df4bbf9c079:REFERENCE} (0.47 uF; 150 nF or more is required) hard against pin 10 with the shortest return to pin 4 (AGND)." (at 15.24 190.388721 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0f8d4474-4c0a-5d38-8f23-843f84c00740"))
	(text "PLACE: Both straps reference +3.3V_FILT, the potential the DAC calls VDD; silkscreen the address next to ${fdb3e77c-64e0-4135-b4df-fa9baa347a58:REFERENCE}." (at 15.24 194.198721 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d625a9b3-915a-5bbc-819f-15a6689660f0"))
	(text "ROUTE: SCL and SDA run straight from the ports to pins 6 and 8; no termination or tap inside the block (conventions 10 and 14)." (at 15.24 198.008721 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d1dbae9d-0a2f-56fa-a6ba-40343ee6abfb"))
	(polyline (pts (xy 179.12 40.082) (xy 335.38 40.082)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "094adb18-ad89-54de-a885-62847dd6be66"))
	(text "2. Set-point divider and command filter" (at 179.12 42.622 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "e0bb9cdf-6a88-51fd-af76-e1d81763bef8"))
	(text "${ff2b499a-7fd1-4ffd-b66c-3f4dcf8b1953:REFERENCE}, ${03867334-5f30-4efb-afba-5f14bdbf4bf2:REFERENCE} and ${5d34b14c-d963-4197-8cf8-32d9d42067e1:REFERENCE} scale DAC_VOUT by 0.19512 to VSET_RAW; ${c5a9e21d-7bef-4187-87a3-374986757999:REFERENCE} and ${91c3ce23-dc71-4c2c-84b8-338241a05559:REFERENCE} filter it at 303 Hz to V_SET." (at 179.12 46.772 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bbf3b152-bdc8-5cda-9af0-f20573ee5ca9"))
	(text "Set-point divider top, DAC_VOUT" (at 184.2 75.946 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7d481f5c-7270-5ccc-8880-41a4cb6ef646"))
	(text "Set-point divider middle leg (0.1 %)" (at 226.63858 75.946 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "89d05779-847d-5004-be64-4ad4145e615a"))
	(text "Command filter series, V_SET" (at 274.032576 75.946 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5db8ee34-60e1-5ced-89bf-25de079ce444"))
	(text "Set-point divider bottom leg (0.1 %)" (at 226.63858 122.604592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ec76db8c-35d3-57bc-9c08-5b1c759d25f2"))
	(text "PLACE: The three divider resistors are the 0.1 %, 25 ppm set; keep them together." (at 179.12 127.684592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "916da86a-b150-585e-b21b-d794649af426"))
	(text "PLACE: ${91c3ce23-dc71-4c2c-84b8-338241a05559:REFERENCE} sits after ${c5a9e21d-7bef-4187-87a3-374986757999:REFERENCE}, never on the DAC output (DAC80501 C_LOAD maximum 2 nF); the 16.4 kohm divider is far above its 0.5 kohm" (at 179.12 131.494592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "88e3fc2b-9ed9-591c-bed5-8c7e6494f930"))
	(text "minimum load." (at 179.12 134.034592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "77035fc7-6bc7-5205-b539-8e0b6d7c35a8"))
	(text "ROUTE: V_SET is the loop's reference: short, guarded by analog ground, its own netclass." (at 179.12 137.844592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "eaa883ca-2e06-5600-95b2-466c368178c7"))
	(polyline (pts (xy 343 40.082) (xy 499.26 40.082)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "5c867496-b948-58a6-bc88-15f4cf20d65c"))
