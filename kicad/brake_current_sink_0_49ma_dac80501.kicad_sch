	(text "ROUTE: +12V, +5V and +3.3V arrive at the ferrites' pad 1 (PWR_12V_LOCAL, PWR_5V_LOCAL and PWR_3V3_LOCAL vias, convention 1); the filtered rails" (at 343 413.434592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f47d3d77-97b0-5871-a52a-fcc8bc44a07d"))
