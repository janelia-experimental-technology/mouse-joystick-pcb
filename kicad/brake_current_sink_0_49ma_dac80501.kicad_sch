	(text "PLACE: One 100 nF at each supply pin it serves: ${bcffa4b9-43f2-4ce6-9ce5-f2aeb1622c3f:REFERENCE} at ${08cbd8a3-a149-4ecc-b0c2-6c033868ce5a:REFERENCE} pin 5, ${958f572c-05b5-4a76-ab24-d649289b4ba0:REFERENCE} at ${9de952b4-4e7a-459d-aed6-bdb936955c3f:REFERENCE} pin 5, ${146b31dd-c32f-465c-8cbe-4bba07e4ee40:REFERENCE} at ${f2dbb1d9-e1df-420a-8b04-0d0afb2b3670:REFERENCE} pin 5, ${b6168fae-9bc7-45f0-b346-65b05e28f7aa:REFERENCE} at" (at 343 407.084592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "17d69764-c222-5246-b686-162647beb522"))
