	(text "ESD clamp on AOUT" (at 565.478706 94.664592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ebd4ffeb-9fe0-5508-8422-996e177ae1d6"))
	(text "/2 output divider bottom (0.1 %)" (at 475.113333 132.764592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a3da8f58-6fab-5bd7-80f1-b81226c4c9b8"))
	(text "AOUT_DIV midpoint shunt (C0G)" (at 522.756497 130.224592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1e654dbe-9fac-56c1-878c-8193d374938f"))
	(text "Monitor tap isolation, AOUT_MON" (at 565.478706 121.666 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8494f381-f8ea-5171-a4f4-c235e7093bc7"))
	(text "PLACE: Place the block at the connector: ${91a88168-ae40-4390-a50e-ccae696da219:REFERENCE}'s ground via must land on the connector ground pin, or connection inductance dominates its clamping." (at 452.253333 137.844592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "16d818bb-31f9-5db7-a99a-a2ba1731f4e1"))
	(text "PLACE: ${7b03ee7f-5653-41ad-b1d6-e47721e9a1ed:REFERENCE} at AOUT_DIV with a short return; ${07ec6bf2-d007-4fb5-991b-245df92abb5c:REFERENCE} and ${6483f183-7197-416a-90e8-f0efb5e9aaab:REFERENCE} side by side (0.1 %, 25 ppm pair)." (at 452.253333 141.654592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d5c4f4af-47d3-5014-bf61-0e3fafb09c81"))
	(text "ROUTE: AOUT from ${35eb0815-f898-4c8d-b4a4-873ae717ab4f:REFERENCE} to the connector pin that carries ${91a88168-ae40-4390-a50e-ccae696da219:REFERENCE}; AOUT_MON through ${a66918c4-5eff-4880-936c-3f8914981941:REFERENCE} to its own via; keep the two apart." (at 452.253333 145.464592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c9e3bf0d-1b3e-5d3c-afdf-cecf48003750"))
	(polyline (pts (xy 452.253333 156.894592) (xy 632.253333 156.894592)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "840f7a67-241b-5ab9-89a2-131b853c7b14"))
	(text "4. Power drive declarations" (at 452.253333 159.434592 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "ecf6afd2-1e14-5148-847d-354eddda29ad"))
	(text "These nets have an explicit ERC power source declaration." (at 452.253333 163.584592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "904addd0-56b0-57c4-b33a-8bc05df000f5"))
	(text "Power driven:" (at 457.333333 205.469662 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "91014ba9-dcd9-5a4a-834e-7f7aaca97200"))
	(text "+3.3V_FILT" (at 457.333333 208.009662 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8dcfe9da-b7ce-5812-9a1b-73856a1615c4"))
	(text "Power driven:" (at 480.272541 203.60095 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "852ccac0-5cf1-5fe0-8614-c3e26c624e81"))
	(text "+5V_FILT" (at 480.272541 206.14095 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3ea1cd4a-2792-5e76-bae0-920e6d8547da"))
	(text "INTERFACES" (at 670.76 36.482 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "0d8f9dd2-9ac2-52f3-a772-b0ee5d20f56e"))
	(text "Amplifier supply, a regulated 5.0 V rail in the same switched domain, through ${63077e7f-8ada-416b-8c34-2a43286e78d9:REFERENCE} to +5V_FILT (${4431d64b-6575-4991-8a5f-ed6cdd1169e7:REFERENCE} V+, 4.5 V minimum)." (at 670.76 46.99 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f905674a-9205-5e7b-b177-5948232a4135"))
	(text "DAC supply, the switched 3.3 V domain, through ${ab409005-71d3-438b-8449-fd1b17ee5db9:REFERENCE} to +3.3V_FILT (${24d00200-3e57-477a-88e4-3a12e5d04184:REFERENCE} VDD); must be the switched rail or the DAC's input clamps" (at 670.76 59.69 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3fa49a93-c89a-551c-a485-51e4d2420232"))
	(text "back-power the domain." (at 670.76 62.23 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "206bfd40-49e6-5cbb-bf31-778b300c17b1"))
	(text "Analog return of the DAC, amplifier, filter, divider and ESD clamp; flagged once at board level, not here." (at 670.76 74.93 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2cd54ce2-a214-527a-8de3-c12162e6e2f6"))
	(text "I2C clock to ${24d00200-3e57-477a-88e4-3a12e5d04184:REFERENCE} pin 6 (SCLK/SCL); leaves as a single-pin net, the board fits the pull-up." (at 670.76 87.63 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2a8725d6-3680-585c-8dfa-27f8afba7614"))
	(text "I2C data, ${24d00200-3e57-477a-88e4-3a12e5d04184:REFERENCE} pin 8 (SDIN/SDA), address 0x48; leaves as a single-pin net, the board fits the pull-up." (at 670.76 100.33 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7e11a6a2-9d3f-547e-9cf3-1ebace99cba4"))
	(text "Delivered output, 0-1.650 V from a 1.849 kohm source (${35eb0815-f898-4c8d-b4a4-873ae717ab4f:REFERENCE} plus the divider); needs a >= 1 Mohm load; ESD-clamped by ${91a88168-ae40-4390-a50e-ccae696da219:REFERENCE}; any single" (at 670.76 113.03 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6351dc03-f884-5344-84b2-01ef47ecac74"))
	(text "fault is bounded to 2.55 V." (at 670.76 115.57 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a1412cdf-0628-5d9c-bacb-d382fcf21a01"))
	(text "Monitor tap of AOUT_DIV through ${a66918c4-5eff-4880-936c-3f8914981941:REFERENCE} (1 k): the same 0-1.650 V as AOUT, isolated from it; an instrument reads here." (at 670.76 128.27 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "157f61cc-13fb-5ef7-8352-16a9f856bf37"))
	(polyline (pts (xy 670.76 143.51) (xy 825.76 143.51)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "a354ae86-2a24-5987-b0dc-6518a1a02249"))
	(text "OPERATION" (at 670.76 146.05 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "f8c246de-ccc0-5d4b-8b27-9c080a2333af"))
	(text "Signal path: ${24d00200-3e57-477a-88e4-3a12e5d04184:REFERENCE} VOUT (pin 2, 0-2.5 V on the internal reference) -> ${12c2acd0-8430-4790-ac32-4be182d997cc:REFERENCE} (20 k) -> DAC_VOUT_FILT_MID -> ${3c358923-568c-48e4-809b-1376db674363:REFERENCE} (13 k) ->" (at 670.76 150.2 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c72d8bb5-ba12-5099-b8eb-4435e526b8f6"))
	(text "DAC_VOUT_FILT -> ${4431d64b-6575-4991-8a5f-ed6cdd1169e7:REFERENCE} + (pin 3). ${b5c142ab-08ce-4cdc-89a2-66ccda3ccf86:REFERENCE} (10 nF, midpoint to AMP_VOUT) and ${9f051feb-a78d-4a6e-95cb-c8f96096b79c:REFERENCE} (10 nF to GND) make a Sallen-Key low-pass with" (at 670.76 152.74 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fadd1c02-0a98-5a31-89c9-6268ea02879f"))
	(text "${4431d64b-6575-4991-8a5f-ed6cdd1169e7:REFERENCE} as the active element: f0 987 Hz, Q 0.61, group delay 266 us, matched to the torque block's 263 us. ${c039fa40-db02-46e8-85fc-2fd38ad08cfb:REFERENCE} (3.2 k) over ${2a0b7571-9426-44a3-ac48-cb2dd542e144:REFERENCE} (10 k)" (at 670.76 155.28 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1859fe86-0277-5a40-a0fa-f49aafb795ce"))
	(text "sets the gain 1 + 3.2/10 = 1.32, so AMP_VOUT is 0-3.300 V; ${07ec6bf2-d007-4fb5-991b-245df92abb5c:REFERENCE} and ${6483f183-7197-416a-90e8-f0efb5e9aaab:REFERENCE} (3.2 k each) halve it to AOUT_DIV, 0-1.650 V (LSB 25.2 uV);" (at 670.76 157.82 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d4e04418-419d-5d8a-84fe-82e4a336214a"))
	(text "${35eb0815-f898-4c8d-b4a4-873ae717ab4f:REFERENCE} (249 ohm) delivers AOUT and ${a66918c4-5eff-4880-936c-3f8914981941:REFERENCE} (1 k) taps AOUT_MON." (at 670.76 160.36 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e6408378-46d3-55d4-93b5-b63f37d2d3c0"))
	(text "I2C, address 0x48: ${f8688b17-aef3-4d25-a6f7-ffc6ba63afa5:REFERENCE} (1 k to +3.3V_FILT) latches SPI2C for I2C at power-up; ${8bcec26c-47a1-4f63-b2ea-af49d8755659:REFERENCE} (1 k to GND) sets A0 to 0x48 (the brake block takes" (at 670.76 164.17 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2e05b746-aa5a-5fb7-a771-1b11b285c57e"))
	(text "0x49). A0 is a four-state pin re-sampled during the first byte of every frame, so a floating A0 gives an address that changes between frames: never" (at 670.76 166.71 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8a75aa41-a459-5b9e-8ed8-7039baffcf49"))
	(text "lift ${8bcec26c-47a1-4f63-b2ea-af49d8755659:REFERENCE} without re-wiring it in the same operation. The block owns no bus termination; SCL and SDA leave as single-pin nets and the board fits" (at 670.76 169.25 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "47cdc5da-9d5f-5de8-a429-22408d3023ca"))
	(text "one 2.2 k pull-up pair per bus segment, the DAC-side pair on the switched 3.3 V rail." (at 670.76 171.79 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6e32fcf4-8bde-520e-98a8-5ff33158af8d"))
	(text "Firmware writes GAIN (4h) = 0x0101 before any DATA write. At a 3.3 V VDD the reset default is out of spec against the 2.5 V reference, so the" (at 670.76 175.6 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "dd1d28c9-aba4-576a-9a43-38b14658b2d8"))
	(text "reference alarm holds VOUT at 0 V until that write lands, and STATUS reports it over I2C. The measured output floor is 4.5 mV at AMP_VOUT, 2.25 mV" (at 670.76 178.14 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3cbe78ac-c8a4-56dd-a407-3482f6874cfd"))
	(text "at AOUT: map the signal range above it and keep 0 V for unpowered or faulted." (at 670.76 180.68 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ee684e53-815f-5162-ae06-579029d0d979"))
	(text "Loading and fault bounds: AOUT needs a >= 1 Mohm load (-0.185 % of gain into 1 Mohm, -1.82 % into 100 kohm). ${35eb0815-f898-4c8d-b4a4-873ae717ab4f:REFERENCE} bounds a short to" (at 670.76 184.49 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "26627545-5690-5123-8e48-1be190e8f348"))
	(text "ground at 6.6 mA; the /2 divider bounds any single fault, including ${4431d64b-6575-4991-8a5f-ed6cdd1169e7:REFERENCE}'s output stuck at its 5 V rail, to 2.55 V at the connector. ${91a88168-ae40-4390-a50e-ccae696da219:REFERENCE}" (at 670.76 187.03 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c5d8914f-b2eb-5693-b279-171ec600003e"))
	(text "(TPD1E05U06, 5.5 V working, +-12 kV contact) clamps ESD transients only, not a DC fault. AOUT and AOUT_MON both tap AOUT_DIV and are" (at 670.76 189.57 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cabe6bba-72f8-5759-96d9-2369dec21943"))
	(text "electrically interchangeable: verify on the netlist that ${91a88168-ae40-4390-a50e-ccae696da219:REFERENCE} shares its net with the connector pin." (at 670.76 192.11 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6f685a70-e8ff-5f21-8ef9-2173e6421300"))
	(text "Supplies: +5V from a regulated 5.0 V rail (${4431d64b-6575-4991-8a5f-ed6cdd1169e7:REFERENCE} needs 4.5 V) and +3.3V from the switched 3.3 V rail, both in the same switched domain so the" (at 670.76 195.92 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "397e1a82-4c1c-5955-908e-ddcdecdc76c3"))
	(text "output goes dark with its data source; ${63077e7f-8ada-416b-8c34-2a43286e78d9:REFERENCE} and ${ab409005-71d3-438b-8449-fd1b17ee5db9:REFERENCE} filter them to +5V_FILT and +3.3V_FILT, each carrying a PWR_FLAG. Two instances" (at 670.76 198.46 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "33acae52-ae89-5532-99ae-bf3e70eb2a49"))
	(text "need separate sheets or DAC_A0, SPI2C and the filtered rails merge." (at 670.76 201 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3764f515-29ae-5963-80a9-9fe8ffe6468e"))
	(text "${b5c142ab-08ce-4cdc-89a2-66ccda3ccf86:REFERENCE}, ${9f051feb-a78d-4a6e-95cb-c8f96096b79c:REFERENCE} and ${7b03ee7f-5653-41ad-b1d6-e47721e9a1ed:REFERENCE} are C0G: class-2 dielectric is piezoelectric and this board is coupled to a stepper and a hand-driven joystick." (at 670.76 204.81 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "926bea43-534f-57a8-9c6f-78983e90a66b"))
	(text "Retune the filter by scaling ${12c2acd0-8430-4790-ac32-4be182d997cc:REFERENCE} and ${3c358923-568c-48e4-809b-1376db674363:REFERENCE} together; do not raise f0 and do not use ${d76599b4-736e-4e7e-be47-1a194b515e41:REFERENCE} for band limiting. ${a6012404-1c13-4c25-9eca-b8f2743a9df9:REFERENCE} (100 k) stays on" (at 670.76 207.35 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f4fe8778-ce9e-569f-932c-096520f7b24d"))
	(text "AMP_VOUT, not on the midpoint, where it would become part of the ratio." (at 670.76 209.89 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d3adef45-73c3-5f6e-831d-12f9b3b90f42"))
	(polyline (pts (xy 670.76 221.32) (xy 825.76 221.32)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "795ba5ce-0557-537d-a374-abee0cd89557"))
	(text "DESIGN NOTES" (at 670.76 223.86 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "523ff1bb-1120-5177-a016-9187fb35489d"))
	(text "GAIN register (4h) reset = 0x0001 = the 0-5 V span. Write 0x0101 (REF-DIV=1, BUFF-GAIN=1) -> 0-2.5 V at the DAC, 0-3.300 V at AMP_VOUT," (at 670.76 228.01 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7d61d5d2-593c-5a2f-8ab7-1feb02e7cf12"))
	(text "0-1.650 V at AOUT. Do this before any DAC data write." (at 670.76 230.55 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "62eb5b8a-21de-5f07-a7b5-0a8918da4521"))
	(text "At a 3.3 V VDD the reset default is out of spec against the 2.5 V internal reference, so the reference alarm shuts the reference buffer down and forces" (at 670.76 233.09 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e590c15a-12e4-5e66-9f7a-6d5fa0de2483"))
	(text "VOUT to 0 V until that write lands; read that 0 V as unpowered or faulted, never as a valid end-of-travel angle. Do not use REF-DIV=0 to recover the" (at 670.76 235.63 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f18a33b5-d2f3-545c-8207-2eb3afa792a2"))
	(text "0-5 V span." (at 670.76 238.17 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5cd8dea2-83ce-5e39-958d-a933ffa73c4e"))
	(text "A0=GND 0x48" (at 670.76 241.98 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e62094ed-9fa6-5c39-a326-89cb307ee28b"))
	(text "2-POLE SALLEN-KEY RECONSTRUCTION / ANTI-ALIAS FILTER: ${12c2acd0-8430-4790-ac32-4be182d997cc:REFERENCE} (20.0 k), ${3c358923-568c-48e4-809b-1376db674363:REFERENCE} (13.0 k), ${b5c142ab-08ce-4cdc-89a2-66ccda3ccf86:REFERENCE} and ${9f051feb-a78d-4a6e-95cb-c8f96096b79c:REFERENCE} (10 nF each) around" (at 670.76 245.79 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0eea3cd9-e479-510f-b1f7-43c428788380"))
	(text "${4431d64b-6575-4991-8a5f-ed6cdd1169e7:REFERENCE}. f0 = 1/(2 pi C sqrt(${12c2acd0-8430-4790-ac32-4be182d997cc:REFERENCE} x ${3c358923-568c-48e4-809b-1376db674363:REFERENCE})) with ${b5c142ab-08ce-4cdc-89a2-66ccda3ccf86:REFERENCE} = ${9f051feb-a78d-4a6e-95cb-c8f96096b79c:REFERENCE} = C; 1/Q = 1/sqrt(a) + sqrt(a) x (2 - K), a = ${12c2acd0-8430-4790-ac32-4be182d997cc:REFERENCE}/${3c358923-568c-48e4-809b-1376db674363:REFERENCE} =" (at 670.76 248.33 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e3c6c326-450b-5e03-99dc-a445f0276d90"))
	(text "1.538, K = 1.32. As built: f0 = 987 Hz, Q = 0.606, -3 dB at 827 Hz, -52.3 dB at 20 kHz, 266 us group delay." (at 670.76 250.87 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a63f5906-42ef-5429-923c-06ae4db1729d"))
	(text "WHY IT EXISTS: the acquisition (OneBox, AD7616) samples at a fixed 30.3 kHz behind only a 1st-order 39 kHz filter, so it does not anti-alias. The" (at 670.76 253.41 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5d616cd3-67f8-555c-b1de-91f63d98c0b5"))
	(text "TMC5130A chopper runs 16-30 kHz (the datasheet-recommended range) and every value in that range folds into 0-15 kHz, where it is" (at 670.76 255.95 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "11d301ed-7e4f-52fc-8c75-ec8dc2c0f4d4"))
	(text "indistinguishable from joystick motion. This filter is the only band limit in the chain. It also cuts the DAC code-change glitch from 9.9 mV to 14 uV;" (at 670.76 258.49 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6e0ead53-a379-544a-9a52-60adbe96993d"))
	(text "the OneBox LSB is 152.6 uV on the +/-5 V range." (at 670.76 261.03 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "664da920-2450-56ae-be67-f19f76d8aba0"))
	(text "TO RETUNE: scale ${12c2acd0-8430-4790-ac32-4be182d997cc:REFERENCE} and ${3c358923-568c-48e4-809b-1376db674363:REFERENCE} by the SAME factor. Q depends only on their ratio, so the shape is preserved and only f0 moves. Do not" (at 670.76 263.57 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "812a58cf-169b-52d6-ba7f-7ea8ba69ea1d"))
	(text "change C. Ladder, ${12c2acd0-8430-4790-ac32-4be182d997cc:REFERENCE}/${3c358923-568c-48e4-809b-1376db674363:REFERENCE}: f0, rejection at 20 kHz, group delay:" (at 670.76 266.11 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ed6e6b92-3dcc-5ac7-9234-6971d024b6e0"))
	(text "- 64.9k/42.2k: 304 Hz, -72.7 dB, 864 us." (at 670.76 268.65 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a71c5b3c-a925-56e6-a5fe-fa1c9fc8b7aa"))
	(text "- 39.2k/25.5k: 503 Hz, -64.0 dB, 522 us." (at 670.76 271.19 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "450289a8-321b-5096-b7ad-a6adcf7c5073"))
	(text "- 20.0k/13.0k: 987 Hz, -52.3 dB, 266 us (as built)." (at 670.76 273.73 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "09d183eb-efe3-577d-b1a1-2ee761af5e7d"))
	(text "- 9.76k/6.34k: 2.02 kHz, -39.8 dB, 130 us." (at 670.76 276.27 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ad2d44f5-dfa4-539d-8c2b-92e4658431d9"))
	(text "- 6.49k/4.22k: 3.04 kHz, -32.7 dB, 86 us." (at 670.76 278.81 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ade21e70-0857-529e-bd64-dca0670d36c0"))
	(text "- 3.92k/2.55k: 5.03 kHz, -24.0 dB, 52 us." (at 670.76 281.35 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3d7c48c3-791f-5d30-b6b4-c6da202fd8fd"))
	(text "- 2.00k/1.30k: 9.87 kHz, -13.2 dB, 27 us (chopper barely attenuated)." (at 670.76 283.89 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d65d5120-c992-5d3b-a0e6-047c5830a468"))
	(text "SINGLE-POLE FALLBACK (same pads): ${12c2acd0-8430-4790-ac32-4be182d997cc:REFERENCE} = 0 R jumper, ${b5c142ab-08ce-4cdc-89a2-66ccda3ccf86:REFERENCE} = DNP, ${3c358923-568c-48e4-809b-1376db674363:REFERENCE} = 15.0 k, ${9f051feb-a78d-4a6e-95cb-c8f96096b79c:REFERENCE} = 10 nF -> 1.061 kHz, one pole, -25.5" (at 670.76 286.43 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "adf195e5-d9d9-519c-977c-08576ed15c78"))
	(text "dB at 20 kHz, 150 us. ${b5c142ab-08ce-4cdc-89a2-66ccda3ccf86:REFERENCE} MUST be DNP in this configuration: with ${12c2acd0-8430-4790-ac32-4be182d997cc:REFERENCE} shorted it would hang 10 nF from the DAC output to the op-amp" (at 670.76 288.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3a168279-a43f-57cd-9437-e13d7422f8d8"))
	(text "output." (at 670.76 291.51 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ebc05b2b-dddc-5fd0-b754-821260ad9fb8"))
	(text "CONSTRAINTS. C0G ONLY (TI DACx0501 datasheet 9.2.2.6): class-2 dielectric is piezoelectric and this board sits next to a stepper; the series R can" (at 670.76 294.05 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "797a63ca-9574-5af7-a730-e31f2f54728d"))
	(text "only bleed self-generated charge with time constant R x C, which is fixed by f0, so it cannot be filtered away." (at 670.76 296.59 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e462e910-9feb-5aff-a72a-7d2ec83e9049"))
	(text "${b5c142ab-08ce-4cdc-89a2-66ccda3ccf86:REFERENCE} and ${9f051feb-a78d-4a6e-95cb-c8f96096b79c:REFERENCE} must be the SAME value and ideally the same reel. Q depends on ${b5c142ab-08ce-4cdc-89a2-66ccda3ccf86:REFERENCE}/${9f051feb-a78d-4a6e-95cb-c8f96096b79c:REFERENCE} = 1; matched capacitors make Q immune" (at 670.76 299.13 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d0882ade-d50a-5323-9b97-efaa1d0d1003"))
	(text "to capacitor tolerance." (at 670.76 301.67 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "17c73098-f5c7-506b-ae22-957676d349e2"))
	(text "${12c2acd0-8430-4790-ac32-4be182d997cc:REFERENCE} and ${3c358923-568c-48e4-809b-1376db674363:REFERENCE} carry no DC current (op-amp Ib = 10 pA), so the DC gain is set ENTIRELY by ${2a0b7571-9426-44a3-ac48-cb2dd542e144:REFERENCE} and ${c039fa40-db02-46e8-85fc-2fd38ad08cfb:REFERENCE}. 1 % here is plenty; do" (at 670.76 304.21 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "828e74ac-5ee3-571f-a532-6ef6ecf869f7"))
	(text "not \"upgrade\" to 0.1 %." (at 670.76 306.75 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6abf899c-4b89-55ee-b04d-d5937c361bed"))
	(text "Keep ${d76599b4-736e-4e7e-be47-1a194b515e41:REFERENCE} = 10 pF. Its pole is at 4.97 MHz and it rolls K toward 1.0 at HF, which lowers Q up there: stabilizing, not destabilizing." (at 670.76 309.29 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3042cf44-263e-5a5a-8a01-a01f6e5d1e4c"))
	(text "Do not put a shunt capacitor on the connector side of ${35eb0815-f898-4c8d-b4a4-873ae717ab4f:REFERENCE}. One large enough to matter there (640 nF for 1 kHz) drives ${4431d64b-6575-4991-8a5f-ed6cdd1169e7:REFERENCE} into its +/-65" (at 670.76 311.83 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e3d294ac-d864-5e0e-a400-8c8f00a4975a"))
	(text "mA limit on every step, and its corner would track the researcher's cable capacitance." (at 670.76 314.37 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f50b557b-650a-5ad6-86ca-a61a9b4249c8"))
	(text "Group delay is a latency you must MEASURE and report, not assume." (at 670.76 316.91 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d6ecb4c4-327b-5c32-aad5-ded3e8f9ea16"))
	(text "The Sallen-Key stopband floors out above about 1 MHz as the op-amp output impedance rises and ${b5c142ab-08ce-4cdc-89a2-66ccda3ccf86:REFERENCE} stops bootstrapping. Irrelevant at 16-30" (at 670.76 319.45 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4c0ff3c0-6ae4-5876-8ebf-e54bed0f9bc3"))
	(text "kHz." (at 670.76 321.99 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0dc88e3a-deab-5a98-9686-559ef7eacd3d"))
	(text "LAYOUT: keep DAC_VOUT_FILT_MID and DAC_VOUT_FILT short and surrounded by analog GND." (at 670.76 324.53 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2b22e6d9-aa60-5759-aa28-3ba0fc99d23d"))
	(polyline (pts (xy 670.76 335.96) (xy 825.76 335.96)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "8fec9b2a-9189-522f-b604-197661dc3511"))
	(text "DESIGN CONTRACT" (at 670.76 338.5 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "aa77c9ce-1401-53ad-bf8c-674b9491f6da"))
	(text "Single-channel buffered 0-1.650 V precision analog voltage output, safe on a Neuropixels OneBox ADC channel or an unprotected 3.3 V MCU pin: a" (at 670.76 342.65 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "caf22774-30c6-514c-9163-6ab50f4808ef"))
	(text "DAC80501ZDGSR at 3.3 V on I2C at address 0x48 on its internal 2.5 V reference, a 2-pole 987 Hz Sallen-Key reconstruction filter, an OPA197 on a" (at 670.76 345.19 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "376bea00-b642-5388-bdd4-95bb6387c79e"))
	(text "ferrite-filtered 5 V rail at a non-inverting DC gain of 1.32 that is also the filter's active element, a /2 output divider, a 249 ohm series output" (at 670.76 347.73 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3229c7da-707c-5047-85e2-c85fc9afd3e5"))
	(text "resistor, an ESD clamp and a separately isolated monitor tap. AMP_VOUT full scale is 2.5 V x (1 + 3.2k/10k) = 3.300 V and AOUT is half of it, 1.650" (at 670.76 350.27 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6816e4c3-4899-5483-b2c6-6e9d7f92543e"))
	(text "V, LSB 25.2 uV. Built for the mouse-joystick-pcb encoder angle output, but THE CONNECTOR DELIBERATELY LIVES OUTSIDE THE BLOCK so one block" (at 670.76 352.81 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d806dfde-a41a-53b8-b1fe-2a4b425ebe28"))
	(text "serves any housing. The full derivation, values, retune ladder, layout rules and accuracy budget are in kicad-libs docs/analog-output-design.md; this" (at 670.76 355.35 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "44f30b00-e67d-5e3d-9b4b-774b7ee3a11f"))
	(text "note carries only what breaks silently without it. Designators are not stable (KiCad auto-annotation orders by sheet position), so everything below is" (at 670.76 357.89 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d1879798-e4a4-5529-9c95-dae99ed67e9b"))
	(text "named by net." (at 670.76 360.43 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4a05b336-d7c8-58b5-8342-f2ea7662ce00"))
	(text "1. I2C, NOT SPI, AND THE ADDRESS IS ONE RESISTOR. SPI2C is strapped to +3.3V_FILT through 1k for I2C mode; A0 is strapped to GND through 1k for" (at 670.76 362.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3eb68ea3-8ab1-5072-9ea3-5de32333f081"))
	(text "0x48, and brake_current_sink_0_49ma_dac80501 takes 0x49. A0 is a FOUR-STATE pin (AGND 0x48, VDD 0x49, SDA 0x4A, SCL 0x4B), so a rail strap" (at 670.76 365.51 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "61f192bb-9fba-5e5c-abe5-334c8bd0c073"))
	(text "reaches only the first two. A0 is re-sampled during the first byte of EVERY frame, so a floating A0 gives an address that changes between frames" (at 670.76 368.05 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c36bb307-cc96-5922-90bd-cb558230575b"))
	(text "rather than a clean failure; never lift that resistor without re-wiring it in the same operation." (at 670.76 370.59 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "afd536d4-093d-56bf-9863-3cd09abdb339"))
	(text "2. THIS BLOCK OWNS NO BUS TERMINATIONS and must not gain any. An earlier revision advertised three 10k SPI idle resistors as a feature; they are" (at 670.76 373.13 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "dd489944-9a55-54f7-b25a-fba720e4766b"))
	(text "DELETED, because two DAC blocks on one bus would put 5k to GND on SDA and SCL and idle the bus at 2.29 V against a 2.2k pull-up, on top of the" (at 670.76 375.67 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9863a9ee-2892-5402-b671-2d1956c010d5"))
	(text "DAC's 1.62 V VIH minimum. SCL and SDA leave as single-pin nets. The board fits ONE 2.2k pull-up pair PER BUS SEGMENT: the DAC-side pair on the" (at 670.76 378.21 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "591df0cb-97e8-52bd-9735-57b90207a429"))
	(text "SWITCHED 3.3 V rail, because an always-on pull-up reaching a DAC whose VDD is at 0 V exceeds the VDD+0.3 V digital-input absolute maximum and" (at 670.76 380.75 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1e037ece-985e-54de-8248-e6a7c14d5b27"))
	(text "back-feeds +3.3V_FILT through the internal clamps; the MCU-side pair on the ALWAYS-ON rail, because the SN74CB3Q3245 is open by default." (at 670.76 383.29 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "dd6ec35c-806f-50ae-aba8-d64c9ce1504e"))
	(text "3. AOUT AND AOUT_MON ARE TWO DIFFERENT PORTS AND CROSSING THEM IS A DEFECT ERC CANNOT CATCH. Both tap AOUT_DIV, the divider midpoint, so" (at 670.76 385.83 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e35c7ce0-7c78-5c7f-a7df-55dcec8ef136"))
	(text "the monitor and the connector read the same voltage. AOUT is the delivered output and carries the 249 ohm source resistor and the ESD clamp;" (at 670.76 388.37 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "382aad74-aa66-5bbf-ae8a-231739d45b83"))
	(text "AOUT_MON is a 1k instrument tap. Both are validly driven either way round, so verify on the netlist that the clamp shares a net with the connector pin." (at 670.76 390.91 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b2b29314-05df-53f9-8aef-aa04cb22e4c9"))
	(text "Backwards leaves the human-accessible connector with NO ESD protection. This happened once, on mouse-joystick-pcb, 2026-08-27." (at 670.76 393.45 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "15a065bc-9bc6-51fb-a39a-f57348f2a7c6"))
	(text "4. THE 100k OUTPUT PULL-DOWN STAYS ON AMP_VOUT, upstream of the /2 divider. It defines 0 V when the block is unpowered; on the midpoint it" (at 670.76 395.99 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2c42fd72-d705-5d55-a93a-8126de3d9294"))
	(text "would parallel the bottom leg for about -1.6% of ratio, and it is a 1% 100ppm/C thick film against the divider's 0.1% 25ppm/C pair. General rule:" (at 670.76 398.53 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ed1b028f-2387-5f1d-afa6-378b637ac246"))
	(text "anything whose job is to define a node when the amplifier is dead belongs on the AMP side of a divider; anything in parallel with a divider leg" (at 670.76 401.07 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e37a6c9c-453c-5340-983a-1440328689ae"))
	(text "becomes part of the RATIO." (at 670.76 403.61 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2ee502d8-58e2-5c39-96a7-3c3c584a36dd"))
	(text "5. AOUT IS 0-1.650 V FROM A 1.849 kohm SOURCE AND NEEDS A >=1 Mohm LOAD. The source is the 249 ohm series resistor PLUS the divider's 1.6" (at 670.76 406.15 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fabf232b-1208-58ea-b2fb-c2f9ef64ba3e"))
	(text "kohm, not 249 ohm alone: against the OneBox AD7616-P's 1 Mohm that is -0.185% of gain, systematic and absorbed by per-board calibration, but a" (at 670.76 408.69 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f064ada8-5a2e-5855-9586-307f5a9a5a6b"))
	(text "100 kohm load costs -1.82% and a 50 ohm terminated input reads a fraction of the correct value. The 249 ohm still bounds a short of AOUT to" (at 670.76 411.23 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1eddecec-810e-534c-9024-2016e6358e0b"))
	(text "ground at 6.6 mA and 11 mW inside a 62.5 mW 0402. The /2 divider is what bounds a single fault, including the amp's own output stage shorted to" (at 670.76 413.77 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "22fe5431-ef7a-5daf-b510-d3084617c0c9"))
	(text "its 5 V rail, to 2.55 V on a connector pin, inside an STM32F405's 4.0 V absolute maximum. That bound is a property of the copper, not of a register" (at 670.76 416.31 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b7ec45eb-ae21-5fc6-8862-e680f1e73c9a"))
	(text "write. The ESD clamp is a transient device and does NOT bound a DC fault." (at 670.76 418.85 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fb400566-3bc8-5227-a585-2b80f8de5a90"))
	(text "6. THE FILTER IS NOT OPTIONAL, ITS CAPACITORS MUST BE C0G from one reel, AND SO MUST THE 470 pF DIVIDER MIDPOINT SHUNT. Class-2 dielectric is" (at 670.76 421.39 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8760b6af-7347-5af9-b1b5-e614626018f3"))
	(text "piezoelectric, this board is coupled to a stepper and a hand-driven joystick, and on the midpoint that pickup becomes signal. Retune by scaling BOTH" (at 670.76 423.93 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "37254026-bf85-5b3b-872a-ef20baac4386"))
	(text "series resistors by the same factor and leaving the capacitors alone: Q depends only on their ratio. Do not raise f0 to buy passband: rejection falls as" (at 670.76 426.47 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f961a748-210a-57ad-9649-5f6cee291ecd"))
	(text "(f0/20kHz)^2 and the chopper is the whole point. The 266 us group delay is a latency to MEASURE and report, and it is deliberately matched to" (at 670.76 429.01 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "53e41afc-e9ba-570a-b605-36fd49912bee"))
	(text "torque_bridge_0_3v3_ina821's 263 us. The midpoint shunt is 470 pF because it adds only 0.75 us against that budget; the brake block's 10 nF would" (at 670.76 431.55 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fc068ea7-a82b-589d-bb6f-13cfc2afd0ad"))
	(text "add 16 us and land the corner a decade above the 987 Hz filter." (at 670.76 434.09 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7e4753a4-b070-5028-afa1-932fef55beea"))
	(text "7. FIRMWARE MUST WRITE GAIN (4h) = 0x0101 BEFORE ANY DATA WRITE, and at 3.3 V that is a SAFETY PROPERTY rather than a hazard. The reset" (at 670.76 436.63 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f96c9ccb-5b60-5f39-9880-6e65b9b16c11"))
	(text "default 0x0001 is out of spec against the 2.5 V internal reference at a 3.3 V VDD, so the reference alarm holds the output at 0 V until that write" (at 670.76 439.17 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1165da23-b091-5cc7-b798-2a47a87e13f9"))
	(text "lands. This block used to run its DAC at 5 V, where the same default commanded 5 V x 1.32 and the amp clipped near 4.85 V into whatever was on" (at 670.76 441.71 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "558a45f5-c83b-559c-97f5-329b258ee597"))
	(text "the connector. Over I2C the alarm is also READABLE in STATUS, which is why this block is on I2C at all. Do not use REF-DIV=0 to recover the old" (at 670.76 444.25 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3a5abc89-2497-5b22-a142-1eb7d0b29525"))
	(text "span." (at 670.76 446.79 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2f8d3823-4709-59dc-8ce2-001afce0b45d"))
	(text "8. THE OUTPUT FLOOR IS 4.5 mV MEASURED, 2.25 mV AFTER THE DIVIDER. Map the valid signal range to start above it and reserve true 0 V as the" (at 670.76 449.33 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b706951f-0aed-55da-b0b1-e4611cfdf2a1"))
	(text "out-of-band unhomed, faulted or unpowered level. That leaves only about 2 mV between a firmware-signalled fault and a dead output section, so" (at 670.76 451.87 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "dd8c0e98-67b9-5aba-82de-94d93cd69078"))
	(text "STATUS, not the analog level, is the primary discriminator." (at 670.76 454.41 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a80917ce-38be-5fc7-8ce3-08875089730f"))
	(text "9. BIND +3.3V AND +5V TO THE SAME SWITCHED DOMAIN. Feed +5V from a REGULATED 5.0 V rail, never a diode-ORed host rail, so the output goes" (at 670.76 456.95 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "dda810ac-4df0-55d7-b2d8-bb427b61d253"))
	(text "dark with its data source instead of holding a stale angle. The DAC's +3.3V MUST be the switched rail or it back-powers the switched domain through" (at 670.76 459.49 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "257641b0-2531-5956-a260-6c330a8ebf61"))
	(text "the DAC's input clamps." (at 670.76 462.03 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "df14514c-9fe4-52ec-ab97-216e511d5943"))
	(text "10. PWR_FLAG ON BOTH +3.3V_FILT AND +5V_FILT is required: there are two ferrites and each breaks driver propagation. GND is flagged once at board" (at 670.76 464.57 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fa53b0d1-ffe0-576f-9d1d-fe424cef2fdf"))
	(text "level, not here." (at 670.76 467.11 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8403afaf-cd2e-52d9-a1e6-63dec43547db"))
	(text "11. TWO INSTANCES NEED SEPARATE SHEETS or their local nets merge, and DAC_A0 merging would silently put both copies on 0x48. A twin-axis board" (at 670.76 469.65 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6019e6f8-d92a-5774-bab6-a7cf0cb6c254"))
	(text "needs the SDA and SCL strap states, 0x4A and 0x4B, which a rail strap cannot reach." (at 670.76 472.19 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "71b42b1e-1524-5072-8081-d753a9fa8a7a"))
	(group "Review page 01: 1. DAC and address straps" (uuid "89658464-f66b-57e3-a3d3-a443d0a19ba3") (members "b5882037-0345-48f5-984d-77f45c279577" "76b34a84-f2e0-5e2b-b676-1de0b1abaf37" "478407bc-5886-517e-853f-a2aada7a4b35" "5d80a51f-40e0-5deb-a25f-4353cefd6b80" "f1d7f3e4-dadb-5fc9-879b-12e38c089dd5" "1cccca69-c1c4-40d8-9493-be92cd66249f" "6b71a4cd-4fef-543f-b852-fd3bfb426015" "8195076a-2db5-551b-82fc-e47becaefdfe" "a6fbe349-960c-5164-8896-b89e080830ce" "64fa7712-6526-538c-98a2-02273eb925cb" "0e1e1678-4d78-4374-b4f2-2dc92787a59e" "133a3f86-5fba-5cc3-8feb-57b6e5993deb" "a19f8c82-350e-5a07-9375-63434afc8c02" "c917824e-61bf-511b-9983-fe651df4595d" "f423c39e-98bf-5a47-a550-394d415ac879" "02721415-8ba6-44c2-bb42-79442b7769a4" "43f4f28c-72d9-5e17-ba06-979d26c90b36" "65dd8e2a-294a-508b-90ae-0d6f1552e208" "d561eaca-640e-5182-9fe7-b2190f736fad" "3dd00d8c-d21d-59c9-a472-dc9d1cc835e8" "ab409005-71d3-438b-8449-fd1b17ee5db9" "310ceb16-72a6-5264-b32f-991f4499e3bd" "bba7776e-c231-5231-b639-b854904dcaec" "37ce021e-dfa5-5c11-82e6-3ac20864c3fc" "b10f8b42-16d3-5d45-8c98-ffb34cf9c665" "8bcec26c-47a1-4f63-b2ea-af49d8755659" "0e24c786-e70e-5a86-a869-62161fb58b85" "a7672570-b578-5e02-939e-ca0d2c92defa" "ce202e6c-500d-5c32-ad67-d3f55b212061" "3e9e5196-4286-5be1-8649-cd37d17c682d" "f8688b17-aef3-4d25-a6f7-ffc6ba63afa5" "392ee579-73e0-546a-8f85-7d6ab68e045a" "a453d10a-4259-56de-b8ef-e64b0ce29a93" "ba4c7aec-2d28-5c83-a89e-4dc52ca30ccc" "3be03712-c19c-5624-b55c-d7ec34363249" "24d00200-3e57-477a-88e4-3a12e5d04184" "bef7d776-150f-5c66-8654-90bce00b5b8e" "408cc112-62be-5144-8a7d-b307c4fb2fd0" "ec117096-044b-5d46-a2c6-1e96182514e8" "154d1bad-e3fb-59f4-ac80-e53e392485fb" "986654e9-afb6-5c68-bf33-9f2d21766b9e" "efd4298b-b5a1-51f0-bb1b-271df1e98419" "85b7f8f5-083c-5da2-8634-d75d5a6a7cb5" "60b1f7f9-935a-5e1d-b84a-256a05ea9924" "7be2b65a-7d38-549c-b2fa-afea4d76303c" "d59f101d-f5bc-5afa-a55c-06c669eede65" "2e333ee5-ebe4-53b6-90c3-3c4108ccceae" "a4e338e3-0e74-51dd-9e9f-d1ca5eab09c4" "fa1ae556-2d85-5b3c-b