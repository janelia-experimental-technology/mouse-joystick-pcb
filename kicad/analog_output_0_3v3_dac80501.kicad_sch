	(text "3. Output divider, series resistor and ESD clamp" (at 452.253333 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "17f14a37-d250-569a-a3ba-f0c42249a7ff"))
	(text "${07ec6bf2-d007-4fb5-991b-245df92abb5c:REFERENCE} and ${6483f183-7197-416a-90e8-f0efb5e9aaab:REFERENCE} halve AMP_VOUT to AOUT_DIV; ${35eb0815-f898-4c8d-b4a4-873ae717ab4f:REFERENCE} delivers AOUT with ${91a88168-ae40-4390-a50e-ccae696da219:REFERENCE} clamping it; ${a66918c4-5eff-4880-936c-3f8914981941:REFERENCE} isolates the AOUT_MON tap; ${a6012404-1c13-4c25-9eca-b8f2743a9df9:REFERENCE} defines AMP_VOUT at 0" (at 452.253333 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c3c590f7-6760-52c4-a206-894592176f0b"))
	(text "V unpowered; ${7b03ee7f-5653-41ad-b1d6-e47721e9a1ed:REFERENCE} shunts pickup on the midpoint." (at 452.253333 45.712 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2791630b-36ee-5c43-9f52-53a7314a28e1"))
	(text "/2 output divider top (0.1 %)" (at 475.113333 81.026 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b1effdd9-761b-5042-aa5c-d31fa5977fe0"))
