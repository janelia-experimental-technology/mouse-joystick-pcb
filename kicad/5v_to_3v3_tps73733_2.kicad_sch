	(text "5 V to 3.3 V regulator | TPS73733 fixed 3.3 V LDO" (at 15.24 15.24 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "8b97104c-c7cc-5a8e-b1b7-0cc5001a5ed8"))
	(text "Clean 3.3 V linear regulator from a 5 V input rail using the TI TPS73733 fixed 3.3 V 1 A LDO." (at 15.24 21.082 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "456bda9f-da67-502a-ab16-7cddc361fb9f"))
	(text "Matching net labels are connected. Group order explains function; PCB placement priorities are stated below." (at 15.24 26.322 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8a6b1f30-9c17-58b4-ba49-3304c8be675c"))
	(polyline (pts (xy 15.24 36.482) (xy 189.14 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "f3fac97d-0d98-5aaa-80de-5fe28708925f"))
	(text "1. Regulator and bypass" (at 15.24 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "b536b1ea-5d0e-55ff-99c3-205b11d70a0f"))
	(text "${243dc86c-09c3-4e67-89d3-884f6d2a89b8:REFERENCE} regulates +5V to +3.3V with EN tied to IN. ${91999db7-1f40-49d4-a7fa-8614df73114b:REFERENCE} bypasses IN to GND, ${68459500-01ed-4288-8c6d-971de7f04cb5:REFERENCE} holds OUT to GND; NR is open." (at 15.24 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "54f89ec1-df8e-50c9-8be4-84f07b49dbf1"))
	(text "Input bypass" (at 20.32 87.044592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e70c15f5-069f-5f16-8a67-9a23e38658da"))
	(text "Fixed 3.3 V LDO" (at 45.129141 89.584592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3ba1abf6-7e6b-595d-8b03-d723f187742f"))
	(text "Output capacitor" (at 91.547011 87.044592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fa11865c-e76a-533d-b7de-c86d35724d82"))
	(text "PLACE: Place ${91999db7-1f40-49d4-a7fa-8614df73114b:REFERENCE} at pins 8 and 4 and ${68459500-01ed-4288-8c6d-971de7f04cb5:REFERENCE} at pins 1 and 4 with short local ground returns; tie the thermal pad to GND copper." (at 15.24 94.664592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "456567bb-a53e-556a-a7b0-e223c6212cf5"))
	(text "ROUTE: +5V and +3.3V carry the rail classes (PWR_5V_LOCAL, PWR_3V3_LOCAL); the GND return of the pad is the regulator's heat path as well." (at 15.24 98.474592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "921c8821-468f-5fb9-9e22-70fd4bb519ca"))
	(text "INTERFACES" (at 196.76 36.482 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "65fdeb51-4cce-5658-b891-8e003239c4bd"))
	(text "Input rail; also drives EN, so the regulator is on whenever it is present." (at 196.76 46.99 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8c7a0665-31d3-58d4-ad65-ce1d583b675a"))
	(text "Common return; regulator ground pin and thermal pad." (at 196.76 59.69 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d4416645-8f47-50da-91d6-a6e194d5a63b"))
	(text "Regulated output, 3.3 V fixed." (at 196.76 72.39 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9da4c762-34a8-5d81-b7f2-770fc5f36967"))
	(polyline (pts (xy 196.76 87.63) (xy 281.76 87.63)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "a7a6a03e-bf1d-5ff1-a54e-a278585dff15"))
	(text "OPERATION" (at 196.76 90.17 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "4f4331c9-7965-5a5d-ac18-41c0bceacf6f"))
	(text "Signal path: +5V -> ${243dc86c-09c3-4e67-89d3-884f6d2a89b8:REFERENCE} (IN, pin 8) -> +3.3V (OUT, pin 1). EN (pin 5) is" (at 196.76 94.32 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3275247c-c8b9-5a2d-9bed-48ce845a02f8"))
	(text "tied to IN, so the regulator is on whenever +5V is present; there is no enable" (at 196.76 96.86 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4917cb70-efa0-547b-9b6d-351ee6c30370"))
	(text "control inside this block." (at 196.76 99.4 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c660ae93-935b-52c1-991f-2ce70df4f2f7"))
	(text "NR (pin 3) is left open: no noise-reduction capacitor is fitted. GND (pin 4) and" (at 196.76 103.21 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "05ed0696-1f8a-5cfc-afe1-91c9d6e18326"))
	(text "the thermal pad (pin 9) return to GND." (at 196.76 105.75 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e94031d7-2a69-5fe6-9ab5-a1f11416bc7a"))
	(text "${91999db7-1f40-49d4-a7fa-8614df73114b:REFERENCE} (1 uF) bypasses the input, ${68459500-01ed-4288-8c6d-971de7f04cb5:REFERENCE} (1 uF) is the output capacitor; both" (at 196.76 109.56 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b732d34c-873f-5bee-bd2c-efda815c078c"))
	(text "are the catalog 0402 1 uF part. The rail is rated by the TPS73733 (fixed 3.3 V, 1" (at 196.76 112.1 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c2c71b7e-a7ca-5544-b948-9abbcfe90fa2"))
	(text "A class per the catalog description); derate for the board's actual load and" (at 196.76 114.64 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8e3e8bff-e6b5-5e99-a37c-be3ded45c644"))
	(text "dropout." (at 196.76 117.18 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "08d6d804-9b69-508e-ba59-af8df0e50305"))
	(polyline (pts (xy 196.76 128.61) (xy 281.76 128.61)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "ed1aa747-8b7b-5016-962b-e5487368f8f8"))
	(text "DESIGN CONTRACT" (at 196.76 131.15 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "af962a43-8bf4-5af7-b1fd-dabd2faeb667"))
	(text "Clean 3.3 V linear regulator from a 5 V input rail using the TI TPS73733 fixed 3.3" (at 196.76 135.3 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1140c9f9-5cbf-5710-93bd-f8a1694b002d"))
	(text "V 1 A LDO. Intended for MCU, RP2040, TMC logic, encoder interface, and other" (at 196.76 137.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "98dabcde-fdd9-5779-8b33-7a4251788378"))
	(text "low-voltage digital circuitry." (at 196.76 140.38 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "809adc28-76e5-5dda-91a7-ed0730066fca"))
