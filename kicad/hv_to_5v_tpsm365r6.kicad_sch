	(text "TPSM365R6 fixed-output buck | 5 V or 3.3 V variant, 600 mA, PGOOD to VOUT" (at 15.24 15.24 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "e9fe722d-66f3-54a7-bfc3-aa73d7216729"))
	(text "High-voltage input to a fixed 5 V or 3.3 V rail: TI TPSM365R6V5 or V3 600 mA buck module, one family source with the regulator part and the second output capacitor as the variant" (at 15.24 21.082 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "90af38dc-2062-5f19-8980-b34f269f3f88"))
	(text "Matching net labels are connected. Group order explains function; PCB placement priorities are stated below." (at 15.24 26.322 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9aac5eb5-4fd0-545c-9785-1aad530fbda9"))
	(polyline (pts (xy 15.24 36.482) (xy 279.54 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "865e1c06-7faa-50aa-90a3-e30d0e16d105"))
	(text "1. Buck module and output capacitors" (at 15.24 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "92b883be-6476-518c-ad1b-201884c6d63b"))
	(text "${ddad1f6d-36dd-4458-97fd-aaed4355af6a:REFERENCE} converts VIN to the fixed VOUT; ${c175b797-6a17-4be1-9cbf-57b197b7b4e3:REFERENCE} and ${6fe1e8e2-9156-4c1e-9794-ff3ac844ad67:REFERENCE} (22 uF) hold the output. ${6fe1e8e2-9156-4c1e-9794-ff3ac844ad67:REFERENCE} is unpopulated on the 3v3 variant. Three 1 uF 100 V capacitors and a 100 nF high-frequency bypass across VIN to GND at the module's input. ${b32b4e25-7a70-4985-be28-976e7143be58:REFERENCE} (1" (at 15.24 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "76751f70-f9b3-5bf2-b324-0bb26bb8acdf"))
	(text "uF) bypasses the internal LDO output VCC (pin 8), which also sets MODE/SYNC to forced PWM. ${f5234c71-8faa-4921-96a5-990cd791e795:REFERENCE} (10 k) pulls the open-drain PGOOD (pin 1) up to VOUT." (at 15.24 45.712 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "22ee4e7a-cc63-5975-97c2-70162083dc76"))
	(text "regulator" (at 20.32 171.003083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7889b68f-2126-5866-aea2-b70e740c3314"))
	(text "${c175b797-6a17-4be1-9cbf-57b197b7b4e3:REFERENCE}: cout_a" (at 20.32 173.543083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "382a520f-e96f-5828-ae77-22d7ee7350d2"))
	(text "${6fe1e8e2-9156-4c1e-9794-ff3ac844ad67:REFERENCE}: cout_b" (at 20.32 176.083083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "505edde8-791c-576c-a44b-0f28499e0d2c"))
	(text "${1cd968cf-a79d-4f56-8e30-01bb888ccdcb:REFERENCE}: cin_a" (at 20.32 178.623083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d051ebfb-8411-596c-ba6e-d467abaadef0"))
	(text "${8964473b-7b06-4c52-b7f6-42dd70197b54:REFERENCE}: cin_c" (at 20.32 181.163083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bb415fa7-a28f-5aab-b5ae-1d9a8797d412"))
	(text "${2ea7f55e-6079-452f-8f7e-b79929ea53a3:REFERENCE}: cin_b" (at 20.32 183.703083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0319b7b5-14cf-56c2-ac1c-96e28bb111fa"))
	(text "${40d36c26-e1b3-45d9-a9c6-f50262c2c3bc:REFERENCE}: cin_hf" (at 20.32 186.243083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "92b5e9bf-b285-5e1c-a14e-0bdeb966f11f"))
	(text "${b32b4e25-7a70-4985-be28-976e7143be58:REFERENCE}: cvcc" (at 20.32 188.783083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8b5c66b4-c62e-5e7b-84a4-08a0d01587cd"))
	(text "${f5234c71-8faa-4921-96a5-990cd791e795:REFERENCE}: pgood_pullup" (at 20.32 191.323083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d978fee6-70ba-5622-83d9-cd8e2f071114"))
	(text "PLACE: Place ${c175b797-6a17-4be1-9cbf-57b197b7b4e3:REFERENCE} and ${6fe1e8e2-9156-4c1e-9794-ff3ac844ad67:REFERENCE} at VOUT (pin 4) with their GND ends at pin 10; keep the output loop short and on one layer." (at 15.24 196.403083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cd7ca238-4d20-58e7-83c7-c51b4ba4eaf5"))
	(text "PLACE: Place ${40d36c26-e1b3-45d9-a9c6-f50262c2c3bc:REFERENCE} (100 nF) closest to VIN (pin 3) and GND (pin 10), the 1 uF parts beside it; the input current loop is the noisiest on the block." (at 15.24 200.213083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3eb170d6-5b72-5f3f-ade3-72978955d7e7"))
	(text "PLACE: Place ${b32b4e25-7a70-4985-be28-976e7143be58:REFERENCE} at pin 8 with a short return to pin 10." (at 15.24 204.023083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "91bbf79a-fb47-59ca-bf5a-076f99259767"))
	(text "PLACE: Anywhere between VOUT and the PGOOD port; a low-current node." (at 15.24 207.833083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3393422b-59af-53cf-82a8-8d74c347cabf"))
	(text "ROUTE: VOUT is block-local copper (PWR_5V_LOCAL); the board names and classes the net on its side of the sheet pin." (at 15.24 211.643083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "540649e1-f3cb-56f5-a6e4-daf432ba68a6"))
	(text "ROUTE: Wide, short VIN copper from the capacitors into pin 3; no via between ${40d36c26-e1b3-45d9-a9c6-f50262c2c3bc:REFERENCE} and the module if the layer allows it." (at 15.24 215.453083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f7d80fdf-d069-50de-90f1-f65f9018aad0"))
	(text "ROUTE: VCC stays inside the block; nothing else loads it." (at 15.24 219.263083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "eae66a5e-91d1-5e14-8337-6fc49ae1a7d9"))
	(text "ROUTE: PGOOD is a logic flag on the Default class; its high level equals VOUT." (at 15.24 223.073083 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3b69c9dc-d2d6-5822-9b72-bbe603f201fd"))
	(text "INTERFACES" (at 287.16 36.482 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "5a68b224-9caa-52e2-bcd1-72cbf40063fd"))
	(text "3.6 to 65 V input on VIN (pin 3) and EN (pin 2, tied: always enabled)." (at 287.16 46.99 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f2b1b700-58d3-5b0c-9902-da9117de8160"))
	(text "Fixed 5 V or 3.3 V output by variant, 600 mA; FB/BIAS (pin 9) tied here." (at 287.16 59.69 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "92fa5d74-5e3e-5527-9db2-1b7ac28fece0"))
	(text "Return for the module (pin 10) and every input and output capacitor." (at 287.16 72.39 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7edf2149-62b0-5deb-9d38-4f782bcd5f18"))
	(text "Open-drain power good, pulled up to VOUT by ${f5234c71-8faa-4921-96a5-990cd791e795:REFERENCE} (10 k); high level is VOUT." (at 287.16 85.09 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "70f10b3a-a603-5034-b473-89d2ede24f09"))
	(polyline (pts (xy 287.16 100.33) (xy 404.76 100.33)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "d9dbcae1-e399-5f0e-b0bd-78e43258060e"))
	(text "INTERNAL NETS" (at 287.16 102.87 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "41c868b7-08df-58e6-af6f-f7a11b2114c0"))
	(text "VCC: Internal LDO output (pin 8), bypassed by ${b32b4e25-7a70-4985-be28-976e7143be58:REFERENCE}; MODE/SYNC (pin 11) tied here selects forced PWM." (at 287.16 107.02 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8da0139f-4b34-501d-9565-9d4bb417137a"))
	(text "SW: Switch node of the module's integrated inductor: pins 5 and 6 tied to each other, nothing external." (at 287.16 110.83 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "68e1ff86-48af-5f0a-b209-b6e275d0c485"))
	(polyline (pts (xy 287.16 122.26) (xy 404.76 122.26)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "177a614c-023d-5a36-b71e-3d892cfbe4fd"))
	(text "OPERATION" (at 287.16 124.8 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "e4166e62-e6d3-529b-9e27-0bb21f9bf542"))
	(text "Signal path: VIN (3.6 to 65 V after start-up, UVLO rising 3.4 V typical) enters VIN (pin 3) and EN (pin 2, tied to" (at 287.16 128.95 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d37e1af8-a77e-5f97-8e24-ab2ddfab6453"))
	(text "VIN, so the module runs whenever input is present); the integrated-inductor module delivers VOUT (pin 4), 600 mA" (at 287.16 131.49 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "34a1dfe7-e21c-5f5c-952e-5fda9b6e9b66"))
	(text "maximum; FB/BIAS (pin 9) is tied to VOUT for the fixed output; GND is pin 10." (at 287.16 134.03 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7e212d66-7f96-5de9-8987-1d79347fcc50"))
	(text "Variants (family.json): 5v fits ${ddad1f6d-36dd-4458-97fd-aaed4355af6a:REFERENCE} = OW-PWR-TPSM365R6V5RDNR with both 22 uF output capacitors; 3v3 fits" (at 287.16 137.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f556ef51-bcc3-5aa3-8865-8df331e8ed92"))
	(text "OW-PWR-TPSM365R6V3RDNR and leaves ${6fe1e8e2-9156-4c1e-9794-ff3ac844ad67:REFERENCE} unpopulated. One schematic and one copper; the publisher" (at 287.16 140.38 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b02d941b-2ec6-558b-b964-954cd1b72576"))
	(text "writes each variant's part and DNP into its block and judges the output voltage and capacitor ratings from the" (at 287.16 142.92 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5fc8600d-53c6-54fa-9518-df4e9d44c667"))
	(text "facts (release.json). Output accuracy is +/-1.5 % in forced PWM (5 V facts)." (at 287.16 145.46 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "85fa028b-bab7-503d-9947-57b8be94bb00"))
	(text "MODE/SYNC (pin 11) is tied to VCC (the internal LDO output, pin 8, bypassed by ${b32b4e25-7a70-4985-be28-976e7143be58:REFERENCE} 1 uF), which selects" (at 287.16 149.27 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d254fa0c-c75a-5efe-b0cd-47144e904470"))
	(text "forced PWM. BOOT (pin 7) is left open and the two SW pins (5, 6) are tied only to each other, as the block was" (at 287.16 151.81 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ce3b477f-7065-5d07-9c04-e2d7395ccc9d"))
	(text "drawn and built: the module integrates its inductor and nothing external connects there." (at 287.16 154.35 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e8bd4293-034f-5387-9ae4-7486bd8093cc"))
	(text "PGOOD (pin 1) is the module's open-drain window comparator: high once VOUT is inside the window (rising at" (at 287.16 158.16 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "35e7e7f2-86e6-5260-98a7-129acec64228"))
	(text "about 107 %, falling at about 94 % of the set point, 25 us deglitch, about 2 ms delay after regulation), pulled up" (at 287.16 160.7 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6657c11d-e130-52b5-8b9e-4e9919be8c46"))
	(text "to VOUT by ${f5234c71-8faa-4921-96a5-990cd791e795:REFERENCE} (10 k), so its high level is the output voltage itself (5 V or 3.3 V) and a 3.3 V host reads" (at 287.16 163.24 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c7e19cb5-12d5-5646-a9fb-7c9e10abcdd7"))
	(text "the 5 V variant's PGOOD only through a 5 V-tolerant input." (at 287.16 165.78 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9265c7e4-6900-56ff-9f8a-331f4954a1e6"))
	(text "Bypass: three 1 uF 100 V 1206 capacitors (${1cd968cf-a79d-4f56-8e30-01bb888ccdcb:REFERENCE} to ${8964473b-7b06-4c52-b7f6-42dd70197b54:REFERENCE}) and a 100 nF 0603 (${40d36c26-e1b3-45d9-a9c6-f50262c2c3bc:REFERENCE}) at VIN; the 22" (at 287.16 169.59 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c669d63a-6fa6-5e1c-8ea1-3219ff7b1ab8"))
	(text "uF output capacitors sit at about 50 % (5 V) and 33 % (3.3 V) of their rating, inside the family's 0.6 planning" (at 287.16 172.13 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2147ba09-23d5-58b6-aa2e-caf440a6966a"))
	(text "fraction. Current limits from the facts: high-side short-circuit 1 A typical, low-side 0.7 A typical." (at 287.16 174.67 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "506565d1-6d4e-5ff6-bcba-e8dc50138b41"))
	(text "The placing board provides the VIN entry on its own class (the block's PWR_HV_LOCAL copper is block-local), a" (at 287.16 178.48 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "501da542-0266-5145-8562-fd2dfd2b00a5"))
	(text "load of at most 600 mA, its own name for the VOUT net (the port is VOUT because the variant sets the voltage)" (at 287.16 181.02 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "57bd1fb8-f42e-5123-a1c2-2ef55008aad2"))
	(text "and the thermal path: RthJA 56.3 C/W on a JEDEC 4-layer board, so give the module's pad a ground pour and" (at 287.16 183.56 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e28edbec-52ea-53db-8ace-182569bf1ce5"))
	(text "vias." (at 287.16 186.1 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f8e3219d-8132-52c2-aadd-2f2951111b90"))
	(polyline (pts (xy 287.16 197.53) (xy 404.76 197.53)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "20978e83-7f4a-5217-b09c-b39ebde152ab"))
	(text "DESIGN CONTRACT" (at 287.16 200.07 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "f44e746a-355d-5c71-b268-33f3c7f69a94"))
	(text "High-voltage input to a fixed 5 V or 3.3 V rail: TI TPSM365R6V5 or V3 600 mA buck module, one family source" (at 287.16 204.22 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "612cecb3-1107-5698-a564-44692a88c7fe"))
	(text "with the regulator part and the second output capacitor as the variant" (at 287.16 206.76 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9d14b25b-0526-5f2b-81a6-6a5d66f3f9df"))
	(group "Review page 01: 1. Buck module and output capacitors" (uuid "0bc34e36-3b87-5f6d-8687-9d44a19a1dd4") (members "1cd968cf-a79d-4f56-8e30-01bb888ccdcb" "466c45f6-0123-525e-8f46-83c34db124b2" "361ce760-9b04-535b-9e51-0d8bf86653ba" "3ff363b3-77cb-5750-a4ef-0f90134fcccb" "b6a90876-fcb1-5dd8-bca0-7ec1698e9adf" "2ea7f55e-6079-452f-8f7e-b79929ea53a3" "2db272eb-d2f6-55eb-863f-ceda614ed195" "05026072-a346-59b6-97f0-6390b8d8af29" "56292559-b00a-5310-840b-ab3807489fca" "0fc25dec-6fe9-50c4-a459-e6df97d06ea1" "8964473b-7b06-4c52-b7f6-42dd70197b54" "2e013ed2-75b5-5b37-aa78-3766448c9e94" "93ba4468-072d-55e9-a14a-50afdb57481b" "7e89e9e6-76b0-5a79-b689-8d84d07234eb" "6429e407-bfb8-57c0-8895-3194b6be3a41" "40d36c26-e1b3-45d9-a9c6-f50262c2c3bc" "d86b3bcc-99e6-596e-8e23-6c73b89f9846" "21844b54-c137-5c0c-a720-4d4ce64c0a4e" "6eb797f2-7153-55f6-9f75-7c12cc39ff31" "9c1d69e4-c7b6-5cb2-a96e-aca06b22822f" "b32b4e25-7a70-4985-be28-976e7143be58" "5accd14b-8e75-56ab-b3e6-2d059d794ee3" "4bb29ee9-e0a3-5167-8250-c69b4f83a57f" "db18555c-9e8f-5979-8f53-26c876df329a" "ca10dfc7-1841-5ea4-83ff-563ccb074db2" "c175b797-6a17-4be1-9cbf-57b197b7b4e3" "25407dba-708e-5b46-a9be-9e8ba3a2c1ce" "f929126b-ee4c-5457-934e-b5db21b14835" "3b551717-551c-5b32-98fa-44629611ffb7" "4711c682-3421-590a-b860-40e05425d90c" "6fe1e8e2-9156-4c1e-9794-ff3ac844ad67" "80905d15-baf8-57b1-a07a-a1ffa79f35f1" "e42f0a5f-efc2-55b0-b4ea-1b7089b5a92d" "b6d53da0-e663-580e-99c7-65816972758b" "730d798f-5471-597a-8e22-921be9c71548" "f5234c71-8faa-4921-96a5-990cd791e795" "22b6806a-3072-5912-853a-7ddba292c121" "7b6b6378-0365-5b47-8c00-c5da7d27a692" "0cfc1399-e4dd-5339-869a-0f7f31869765" "2d0b1840-d01e-54e9-98f0-5fe13b20f77b" "ddad1f6d-36dd-4458-97fd-aaed4355af6a" "d9a2b034-0bc1-52b2-899d-e4f71baa8fe9" "e09f5f7a-f34e-5c9a-9d2e-15a2f033816b" "9cd22baa-8703-59b5-ac33-44d5eb11f211" "fe7b48d1-3acc-592a-a62b-812d3ac4c611" "88f136ab-ba66-540d-95b6-5a756c4f2ff6" "b87a26cb-7ef3-52bf-a7cf-6ba3fa6c983e" "a516a533-5992-5c12-a850-6a59149ed9b2" "60ec3c33-