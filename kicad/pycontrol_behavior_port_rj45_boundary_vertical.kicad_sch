	(text "pyControl behavior port, vertical shielded jack | 8P8C, 100 ohm series, USBLC6 clamp, 5 V diode-OR, instrument taps" (at 15.24 15.24 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "fc85c674-eb1e-5185-9602-a5982b9e0f39"))
	(text "pyControl behavior-port boundary on a VERTICAL, top-entry SHIELDED 8P8C RJ-45 jack: Molex 855085001, OW-CONN-RJ45-8P8C-THT-VERT, Cat5e, 16.5 mm tall, 1.5 A per contact, through-hole signal contacts plus two through-hole shell legs and two locator pegs." (at 15.24 21.082 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "f5b8f343-306d-57cf-81ea-56c85043eb9a"))
	(text "Matching net labels are connected. Group order explains function; PCB placement priorities are stated below." (at 15.24 26.322 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bd4db703-6c44-5535-989c-2cb5d9365faa"))
	(polyline (pts (xy 15.24 36.482) (xy 211.88 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "bf7462ea-2fec-53cc-88eb-a21ca3197bb4"))
	(text "1. Shielded jack and ESD clamp" (at 15.24 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "c01211f2-7e92-55ef-8033-9edfa7b4efc5"))
	(text "${dcabc325-b008-4566-9bd8-5d9f33a3ddd9:REFERENCE} brings DIO-A (pin 1), GND (pin 2), DIO-B (pin 4) and port 5 V (pin 6) onto the board; ${f93728e2-2141-439d-b216-bcf1db600f7d:REFERENCE} clamps DIO_A and DIO_B to GND and to PYC_CONN_5V at the connector. The shell" (at 15.24 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1a96888e-7a88-5345-802a-965bbaeb280c"))
	(text "pads SH return to GND." (at 15.24 45.712 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cbd89c32-73fd-5bc9-b979-d6fb9b3ebcdc"))
	(text "ESD clamp on DIO-A, DIO-B and 5 V" (at 20.32 158.164592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "32dede61-529c-52e1-accf-315a7de3988d"))
	(text "${3a18ddf5-1a49-4a68-9246-f01a86a3a8ad:REFERENCE}: Port 5 V bypass at the clamp" (at 20.32 160.704592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "11a6e780-727d-52e5-aeb9-1f99af1d223b"))
	(text "${aaadbed3-b7b1-4b40-896d-f506d8dbaf59:REFERENCE}: Polyfuse position (0.36 ohm jumper)" (at 20.32 163.244592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8c3b61fc-4c7f-5805-92d1-082467bc3941"))
	(text "modular-jack" (at 20.32 220.699183 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e3b1c658-813c-5c63-9225-010f02cb8a2a"))
	(text "PLACE: Place ${f93728e2-2141-439d-b216-bcf1db600f7d:REFERENCE} hard against ${dcabc325-b008-4566-9bd8-5d9f33a3ddd9:REFERENCE} pins 1 and 4 with a ground via at its pin 2; route DIO_A and DIO_B in one I/O pad and out the other so the clamp connection stays short." (at 15.24 225.779183 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9c40fef8-f41d-5a29-92bd-48742adf9ca7"))
	(text "PLACE: Verify ${dcabc325-b008-4566-9bd8-5d9f33a3ddd9:REFERENCE} pin 1 against the latch and keyway, not the footprint's local pad order: the vertical footprint numbers pads in the opposite direction to the horizontal one." (at 15.24 229.589183 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ad7df9e7-31cf-50fe-b660-68fba3a6562c"))
	(text "PLACE: Place the two SH shell-leg holes and the two 3.25 mm locator holes before pouring GND or routing the port; the part does not seat without them." (at 15.24 233.399183 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "73db41c9-8fa3-531f-a0c9-0cbffec23f45"))
	(text "ROUTE: DIO_A and DIO_B are short connector-side nets; GND from ${dcabc325-b008-4566-9bd8-5d9f33a3ddd9:REFERENCE} pin 2 is the clamp's return and must reach ${f93728e2-2141-439d-b216-bcf1db600f7d:REFERENCE} pin 2 directly." (at 15.24 237.209183 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9bc67e72-49ef-5ddb-ad0b-de4f0dbab8ef"))
	(polyline (pts (xy 219.5 36.482) (xy 399.5 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "e9ad43fc-aa9c-528d-a608-9d2529fef52d"))
	(text "2. DIO series resistors and instrument taps" (at 219.5 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "8a4ad627-274b-501c-afdc-135855c817f0"))
	(text "${e48050c4-7c3e-4feb-a8bf-c915c166209c:REFERENCE} and ${47e56d03-98c6-43ee-9728-332e5044ac5c:REFERENCE} (100 ohm) stand between the clamped connector-side nets and the board's PYC_DIO_A and PYC_DIO_B ports; ${e899fcb6-9ded-4f69-8a04-6d774dee2032:REFERENCE} and ${354ce1ed-5d8e-453c-a90d-2659c77a0fab:REFERENCE} (100 ohm) tap the" (at 219.5 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "483be9ca-f419-5bec-a875-01cffecec70b"))
	(text "board side of each line for the instrument port." (at 219.5 45.712 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "377fd47f-6e28-5a21-a042-6d989e79d005"))
	(text "DIO series current limit" (at 224.58 75.946 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "396b9414-7de8-5038-889a-afb011845d05"))
	(text "Instrument tap series resistor" (at 288.41871 75.946 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1851cc97-5afc-5d77-8496-3105e8e43023"))
	(text "DIO series current limit" (at 224.58 101.346 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5241e76a-c6b0-5a1f-88a6-a62a16013a82"))
	(text "Instrument tap series resistor" (at 288.41871 101.346 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "77b762b5-ec2e-51d2-85f0-8c757b335280"))
	(text "PLACE: Place ${e48050c4-7c3e-4feb-a8bf-c915c166209c:REFERENCE} and ${47e56d03-98c6-43ee-9728-332e5044ac5c:REFERENCE} just inboard of ${f93728e2-2141-439d-b216-bcf1db600f7d:REFERENCE}, so the clamp sits on the connector side; between them and the MCU it would protect nothing." (at 219.5 106.426 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a2136ac6-c029-5d8d-b462-fa6099a07e83"))
	(text "ROUTE: PYC_DIO_A and PYC_DIO_B are Default-class logic to the MCU sheet, which assigns RX to DIO-A and TX to DIO-B." (at 219.5 110.236 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8120bb6b-2f51-5b10-91e6-1aba64563e36"))
	(text "ROUTE: PYC_DIO_A_INST and PYC_DIO_B_INST are INSTRUMENT-class taps; they carry no drive." (at 219.5 114.046 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ac2bc89d-d167-5a72-8d19-164628b579b0"))
	(polyline (pts (xy 219.5 125.476) (xy 399.5 125.476)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "db4339aa-c15a-5337-ad57-7449dd5b1f53"))
	(text "3. Port 5 V, fuse position and diode-OR" (at 219.5 128.016 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "df55459a-a703-56b2-a3e5-7c925cdffe0c"))
	(text "${3a18ddf5-1a49-4a68-9246-f01a86a3a8ad:REFERENCE} bypasses the raw PYC_CONN_5V node; ${aaadbed3-b7b1-4b40-896d-f506d8dbaf59:REFERENCE} (fuse position) and ${68d4fb06-543a-4879-ba8d-7f948c719952:REFERENCE} (series Schottky) make +5V_PYC, the diode-ORable copy of the port's 5 V." (at 219.5 132.166 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c65c9e92-7fd2-5374-ae9d-647b70d7eef1"))
	(text "Diode-OR Schottky" (at 242.36 162.306 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5cc97d11-1b11-5916-bf04-40c4a57b1527"))
	(text "PLACE: Place ${3a18ddf5-1a49-4a68-9246-f01a86a3a8ad:REFERENCE} at ${dcabc325-b008-4566-9bd8-5d9f33a3ddd9:REFERENCE} pin 6 and ${f93728e2-2141-439d-b216-bcf1db600f7d:REFERENCE} pin 5 with a short return; ${aaadbed3-b7b1-4b40-896d-f506d8dbaf59:REFERENCE} is a 1206 position, keep it accessible for the PPTC swap." (at 219.5 167.386 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "af3f54d5-3bb1-5f32-bf1c-740c66e889ce"))
	(text "ROUTE: PYC_CONN_5V and +5V_PYC are Default-class rails sized for the port's 1.0 A shared budget; +5V_PYC leaves at the port via to be ORed with +5V_USB." (at 219.5 171.196 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1d0134e6-6d7f-5e9c-8d12-59d6d8726530"))
