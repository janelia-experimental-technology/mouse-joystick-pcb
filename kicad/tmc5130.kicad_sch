	(polyline (pts (xy 670.76 375.55) (xy 825.76 375.55)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "7309572b-2aa3-54e6-b1d7-96a05842195f"))
	(text "INTERNAL NETS" (at 670.76 378.09 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "fd4d867b-9858-5d0a-8eba-5a9cd73ad6da"))
	(text "5VOUT: Internal 5 V regulator output (pin 33), ${baf77421-44cb-40ec-8e1f-5b430d66d319:REFERENCE} (4.7 uF); bridged to VCC and +5V through ${9e763c16-dad3-484e-a669-01715055f5de:REFERENCE} (10 ohm)." (at 670.76 382.24 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0241bc53-e0a8-5211-af7e-c28888776893"))
	(text "BRA: Phase A bridge return (pin 44) through shunt ${d3c56657-4bda-4df0-99bc-6fe5ef977e56:REFERENCE} to GND; ${735d7528-e024-41da-8639-5a2475293264:REFERENCE} (100 nF) filters it." (at 670.76 386.05 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ec4e50e1-27ec-5724-a9f5-81d4bb29524c"))
	(text "BRB: Phase B bridge return (pin 17) through shunt ${42b0183a-56ab-4816-a3be-1e1a54bb7267:REFERENCE} to GND; ${47e64c39-7754-411a-80f2-f70556581f70:REFERENCE} (100 nF) filters it." (at 670.76 389.86 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4ce5dca5-be3d-5dc2-9d1f-154e7bd1f4de"))
	(text "CLK: 16 MHz from ${d8e9dab7-a516-4a53-9b28-2ed109176fa7:REFERENCE} OUT into CLK (pin 2)." (at 670.76 393.67 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d60bdcfc-051d-57b7-a776-c7c45f8e9643"))
	(text "CPI: Charge pump flying capacitor ${719914a8-df0e-45c3-aece-d94504f7c2a0:REFERENCE} (22 nF 100 V), CPI side (pin 37)." (at 670.76 397.48 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e5756b42-b998-5056-99e1-13ba86add1c3"))
	(text "CPO: Charge pump flying capacitor ${719914a8-df0e-45c3-aece-d94504f7c2a0:REFERENCE}, CPO side (pin 35)." (at 670.76 401.29 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d7b2c333-f208-5ed1-8e03-413dc0478de5"))
	(text "VCP: Charge pump output (pin 38), ${6cbb887c-2606-45ed-9cb3-f97f490ad7b6:REFERENCE} (100 nF) to VM." (at 670.76 405.1 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "46f4f761-7713-551f-8baf-6f6a56892068"))
	(polyline (pts (xy 670.76 416.53) (xy 825.76 416.53)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "911936cd-2f40-59c9-b971-1197ea81805d"))
	(text "OPERATION" (at 670.76 419.07 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "0bcc2eee-5af5-5943-bfc5-133dbefbb1b2"))
	(text "Supplies: VM (5.5 to 46 V, PWR_HV_BUS) on VS (pins 21, 40) with ${048d7189-492a-44cb-aa68-ec4f53470949:REFERENCE} and ${9e74d5e3-433b-48ec-9de8-b7463117718b:REFERENCE} (100 uF) bulk, ${2bd20a9e-33f0-4a32-a1b5-22084f033f7a:REFERENCE} and ${58861f02-8a9b-4956-95bc-2303cbd0efba:REFERENCE} (2.2 uF 100 V) and" (at 670.76 423.22 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2bef669f-2b05-54d4-929a-6ab8fde5df52"))
	(text "${71a16cf5-dc1e-47d5-ad3e-004ada028a7d:REFERENCE}, ${c23806c4-7518-4c6e-a155-bbf6924f9995:REFERENCE} (100 nF) bypass; +5V on VSA (39) and VCC (34), so the internal 5 V regulator is bridged: 5VOUT (33) feeds VCC through ${9e763c16-dad3-484e-a669-01715055f5de:REFERENCE}" (at 670.76 425.76 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a51e6d90-4eef-56c0-ba8d-1cc0c3e6c761"))
	(text "(10 ohm) with ${baf77421-44cb-40ec-8e1f-5b430d66d319:REFERENCE} (4.7 uF) and ${fa49200e-ca5d-4379-af3a-48bc1a3ccb1d:REFERENCE} (0.47 uF) as its capacitors (facts: 4.7 to 5.4 V with the regulator bridged, VCC 4.6 to 5.25 V); +3.3V" (at 670.76 428.3 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5f62b95d-944e-5104-a645-b71ae747ad5f"))
	(text "on VCC_IO (10) and the oscillator (3.0 to 5.25 V). Supply current about 15 mA at 16 MHz with the driver disabled." (at 670.76 430.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b03ef7c7-ac01-56ef-a0a8-32e3d367f708"))
	(text "Clock and modes: ${d8e9dab7-a516-4a53-9b28-2ed109176fa7:REFERENCE} (16 MHz oscillator, Tri-State pin 1 open) drives CLK (pin 2), which lets SCK run to 8 MHz (4 MHz on the internal clock)." (at 670.76 434.65 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8c345684-ab7b-5c84-b65f-3dd56ff890f2"))
	(text "TST_MODE (1) and SD_MODE (11) are tied to GND: motion-controller mode with the internal ramp generator, not step/dir; SPI_MODE (12) is left open" (at 670.76 437.19 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8af4e544-7f5f-592f-9e2d-5765dc238f0d"))
	(text "(internal pull-up, high) and AIN_IREF (30) open (internal reference, no analog current scaling); ENCN is pulled down by ${2fd8aedf-b327-42c6-aa3f-6f0a7df52f87:REFERENCE} (10 k); ~{DRV_EN} low" (at 670.76 440.63 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1ddeb257-6bce-5120-914e-26a22f9663ce"))
	(text "enables the bridges." (at 670.76 443.17 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "33744ba6-d96b-5fe8-b819-771e6d73e43d"))
	(text "Current sense and variants (family.json): external sensing on BRA (44) and BRB (17) through ${d3c56657-4bda-4df0-99bc-6fe5ef977e56:REFERENCE} and ${42b0183a-56ab-4816-a3be-1e1a54bb7267:REFERENCE}; the variant selects both shunts" (at 670.76 446.98 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5d943ad7-e8bc-5e84-9ef3-df6d2fb9535a"))
	(text "together, r150 = OW-PASS-RLH12FTCR150 (0.15 ohm, 1 W) and r120 = OW-PASS-KRL1632E-M-R120-F-T5 (0.12 ohm, 0.75 W). I_RMS = ((CS + 1)" (at 670.76 449.52 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fd814db3-2785-54bf-abae-fd95d3508ccd"))
	(text "/ 32) x V_FS / (R + 0.02 ohm) / sqrt(2) with V_FS 0.325 V (vsense 0) or 0.180 V (vsense 1): at CS = 31 about 1.35 / 0.75 A RMS for 0.15 ohm" (at 670.76 452.06 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "00ab0bbc-728b-57d6-8580-cdafe0a5b06c"))
	(text "and 1.64 / 0.91 A for 0.12 ohm against the 1.4 A RMS design guideline; the shunt_pair_inventory qualification judges stock and dissipation at" (at 670.76 454.6 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "decab2f8-9f2d-5b0f-85bf-b7a1540e83a6"))
	(text "publication (release.json). Firmware sets vsense, IRUN and IHOLD; the KiCad variant does not." (at 670.76 457.14 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f4e93c2f-e35b-578b-ab28-fb8911ce1836"))
	(text "Profiles (family.json): the SPI blocks are placed with SWSEL and REFR to GND (SPI_MODE high by its pull-up, SD_MODE low) and talk on SCK, COPI" (at 670.76 460.95 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e5ad9213-e0c3-5a98-bc57-745df40a8a66"))
	(text "(SDI), CIPO (SDO) and ~{CS}, each tapped by 100 ohm into an instrument port; the UART blocks are placed with SWSEL to +3.3V, SCK to GND and ~{CS} to" (at 670.76 464.39 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "54da4ce7-097d-534b-af4f-ed7d0e1c6652"))
	(text "+3.3V, SWP_DIAG1 as SWIOP and SWN_DIAG0 as SWION (the single-wire pair, RS-485-like differential or single wire), COPI and CIPO as NAI and NAO" (at 670.76 466.93 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f51e256d-9bf0-54eb-869f-0576e0db9c76"))
	(text "for the address chain; 8N1, sync 0x05, CRC8, 9000 baud minimum at 20 MHz CLK, fCLK / 16 maximum. SPI and UART blocks share one copper; they" (at 670.76 469.47 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0b519cee-8572-582e-b168-63554669b947"))
	(text "differ in description and Profile field only." (at 670.76 472.01 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b309c648-5c99-50a8-9ebb-0a747203494b"))
	(text "Charge pump: ${719914a8-df0e-45c3-aece-d94504f7c2a0:REFERENCE} (22 nF 100 V) between CPO (35) and CPI (37) and ${6cbb887c-2606-45ed-9cb3-f97f490ad7b6:REFERENCE} (100 nF) from VCP (38) to VM supply the high-side gates; the" (at 670.76 475.82 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9150923c-6d11-52fc-8bde-866e9d8e625c"))
	(text "undervoltage threshold is VCP - VS of about 3.6 V. Motor outputs OA1/OA2 (46, 42) and OB1/OB2 (15, 19) carry the MOTOR_2A class, 1.4 A RMS per" (at 670.76 478.36 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5efb88d4-28eb-547e-90cb-a01534f7b857"))
	(text "coil as the design guideline, 2 A peak." (at 670.76 480.9 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c721353c-f247-5674-882b-7fcb3d2fa51c"))
	(text "What the board provides and an inherited deviation: the motor connector and the VM entry on their own classes, the bus pulls, the mode-pin ties of" (at 670.76 484.71 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e42a0382-b351-59eb-9c4b-47d7dbdce63e"))
	(text "the chosen profile and the instrument port behind the taps. This core carries taps on the shared SPI lines SCK, COPI and CIPO (${17810de7-5ac1-427d-994c-ad82e0727783:REFERENCE} to ${2bcffe5d-94f1-4f86-bfcf-8f7201a41691:REFERENCE})" (at 670.76 487.25 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7542ff72-bbf1-5898-813f-491c8d2b44eb"))
	(text "as well as on its own ~{CS}, SWP/SWN and ~{DRV_EN}; a board that places two cores on one bus gets two taps per shared line, a deviation from layout" (at 670.76 490.69 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6edd95d2-278f-5b87-9129-33243fd5f84a"))
	(text "convention 14 (shared lines are tapped once, by the board) that the migration preserves rather than corrects." (at 670.76 493.23 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "885c7a84-25b4-5dec-98c1-b63534b0600b"))
	(polyline (pts (xy 670.76 504.66) (xy 825.76 504.66)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "d7aac4c9-ef57-54cc-a556-8ef0f32b5e62"))
	(text "DESIGN NOTES" (at 670.76 507.2 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "781612a0-810b-5d02-bd91-b4a18d61d97f"))
	(text "TMC5130 Rsense options in stock, approx full-scale current at CS=31:" (at 670.76 511.35 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "887408da-0793-56e0-9777-f92fb6d2e7c5"))
	(text "360m 1206 250mW: vsense=0 0.60A RMS / 0.86A peak; vsense=1 0.33A RMS / 0.47A peak OW-PASS-RL1206FR-070R36L 150m 1206 1W: vsense=0" (at 670.76 513.89 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c70f55e7-8893-5be6-bf6c-570fca7c508a"))
	(text "1.35A RMS / 1.91A peak; vsense=1 0.75A RMS / 1.06A peak OW-PASS-RLH12FTCR150 120m 1206 750mW: vsense=0 1.64A RMS / 2.32A peak;" (at 670.76 516.43 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5f247799-f3b7-57e0-80df-6314ba686207"))
	(text "vsense=1 0.91A RMS / 1.29A peak OW-PASS-KRL1632E-M-R120-F-T5 Set lower current in firmware; choose Rsense so normal IRUN is ~16-31." (at 670.76 518.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fa952ead-a949-542c-a55c-be8e8013eb5a"))
	(text "TMC5130 TQFP thermal behavior needs validation above ~1.2A RMS continuous." (at 670.76 521.51 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "00aa0e4b-26f5-5dbe-968b-d13d810c187d"))
	(text "SWSEL (pin 28): tie HIGH for the UART profile; its level does not matter for SPI (the SPI profile ties it to GND; left open, the internal pull-down reads" (at 670.76 525.32 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b40c4803-625c-56ea-8660-ba5dde44e901"))
	(text "low)." (at 670.76 527.86 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d5434e37-a2a0-5c9d-97b8-9e290d828810"))
	(polyline (pts (xy 670.76 539.29) (xy 825.76 539.29)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "0971e487-6700-5b19-9640-be70120ebe30"))
	(text "DESIGN CONTRACT" (at 670.76 541.83 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "d9eb3a69-eb2b-5e2f-b4a7-bf300133698a"))
	(text "TMC5130A motion-controller core with paired external current-sense resistors" (at 670.76 545.98 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a09013a2-1933-5778-8939-17aa93f413be"))
