	(text "TMC5130A motion-controller core | paired sense shunts by variant, SPI or UART profile" (at 15.24 15.24 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "d29b2a1e-2ede-5b23-843c-22a5e5b8d633"))
	(text "TMC5130A motion-controller core with paired external current-sense resistors" (at 15.24 21.082 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "11977537-e825-56bc-95cc-37f05d0bb9eb"))
	(text "Matching net labels are connected. Group order explains function; PCB placement priorities are stated below." (at 15.24 26.322 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e1d7739e-e4e7-537c-a5a0-d73acf31fea0"))
	(polyline (pts (xy 15.24 36.482) (xy 308.7 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "ded19b95-813d-5ca8-8302-ee8a6be67f56"))
	(text "1. Driver core" (at 15.24 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "a329b343-c11f-5a6a-9467-c8bc52d538b3"))
	(text "${ae35752d-d241-43df-909b-31b506731f95:REFERENCE}, the TMC5130A: SPI or UART in, encoder and reference switches in, two full bridges out on OA1/OA2 and OB1/OB2, diagnostics on SWP/SWN. ${d3c56657-4bda-4df0-99bc-6fe5ef977e56:REFERENCE} and ${42b0183a-56ab-4816-a3be-1e1a54bb7267:REFERENCE} (the variant's shunts) return BRA and BRB to GND; ${735d7528-e024-41da-8639-5a2475293264:REFERENCE} and ${47e64c39-7754-411a-80f2-f70556581f70:REFERENCE} (100 nF) filter the sense nodes." (at 15.24 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f550d8d1-71c5-5c0f-b50c-f5f8176ba59c"))
	(text "${9e763c16-dad3-484e-a669-01715055f5de:REFERENCE} (10 ohm) bridges 5VOUT to VCC and +5V; ${baf77421-44cb-40ec-8e1f-5b430d66d319:REFERENCE} (4.7 uF) is the regulator's output capacitor, ${fa49200e-ca5d-4379-af3a-48bc1a3ccb1d:REFERENCE} (0.47 uF) the VCC/VSA bypass. ${048d7189-492a-44cb-aa68-ec4f53470949:REFERENCE} and ${9e74d5e3-433b-48ec-9de8-b7463117718b:REFERENCE} (100 uF) hold VM; ${2bd20a9e-33f0-4a32-a1b5-22084f033f7a:REFERENCE} and ${58861f02-8a9b-4956-95bc-2303cbd0efba:REFERENCE} (2.2 uF 100 V) and ${71a16cf5-dc1e-47d5-ad3e-004ada028a7d:REFERENCE}, ${c23806c4-7518-4c6e-a155-bbf6924f9995:REFERENCE} (100 nF) bypass VS at the" (at 15.24 45.712 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3c9825c3-18e6-584e-8dc5-5de115e68633"))
	(text "package. ${0791d690-b611-471f-bc36-8c26ff6a5b7e:REFERENCE} and ${107b64cc-4b24-46ae-9fa0-7dea3aeaaa60:REFERENCE} (100 nF) bypass VCC_IO and the oscillator's +3.3V; ${2fd8aedf-b327-42c6-aa3f-6f0a7df52f87:REFERENCE} (10 k) pulls ENCN down." (at 15.24 48.252 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5e23899b-f02c-562e-852e-1f0ab0057a14"))
	(text "TMC5130A motion controller and driver" (at 20.32 257.224592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f5977624-8229-5f26-b0b5-cb3cca8e9e0a"))
	(text "${0791d690-b611-471f-bc36-8c26ff6a5b7e:REFERENCE}: VCC_IO bypass, 100 nF, pin 10" (at 20.32 259.764592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "769e8f2a-5ce4-596a-b105-f19638dfb591"))
