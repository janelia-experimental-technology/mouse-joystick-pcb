	(group "Review page 02: 2. CC sink declaration" (uuid "1235cc01-53de-53af-b2b0-4b3106aba7ed") (members "e0574d6f-c3cf-4023-bcca-2b89f01980b8" "50076a4c-914d-5a6c-a4d9-5bab22383932" "374173ce-671c-5e11-aae0-47c8e8381328" "d79e2796-ef18-5fbb-bdce-9b0f8da62127" "f010f93f-af0b-554d-8656-a0111c7edcf1" "e9b764a5-f224-4026-a384-e54737094fce" "ac601987-09dd-5c4f-a89b-d1d7a4aba68e" "1215c676-0b59-5425-b56c-63d181279779" "78e3b60a-34d5-5755-b377-77ea9b3bd488" "9cf15e4d-6867-56db-9f22-c24970ee176a" "0b004c04-abac-5072-b6b8-b77a7b5ac907" "ba45f9c8-3254-5cc4-a7ec-642a8d627310" "49aa0b36-a6e9-526c-a7f7-f79d814f96d1" "72ec3c3f-4d2b-5e1d-b83e-a34890a3df00" "cc5e5374-a655-5029-8bf5-59b916e3e7cd" "dc3188db-d5fc-535e-b613-de20d00f5be2" "89c1036e-1141-58b5-959a-a100705daa52"))
	(group "Review page 03: 3. Power drive declarations" (uuid "839e0262-04a3-5011-85b2-bf0782dadae4") (members "30c091a4-ef66-43a8-885e-5da175d5af5f" "72fe513c-11ff-5740-b808-496d2c648607" "df15c853-15bd-59fc-8811-79bfa028e918" "8914dfe5-b323-553c-a4a5-785e74998c04" "57026151-277d-583e-ad48-48fa52f25198" "739684c3-0db1-5c39-a6f2-0a06ea90b9fa" "92a145f9-f0bf-5076-80c7-a802969d5744"))
	(group "Review page 04: Interfaces" (uuid "dcf5b3df-48b6-5d98-b89f-e6f5e5e3a0ff") (members "f90bcf08-3887-5db3-95b9-71dfb7621198" "58131a6a-97b5-5382-8e45-c2aaf060a53f" "221c3d9a-840d-5941-bc2b-7188cb741fd0" "c3f0c09f-8d3d-5ae0-9b5a-cb9db102015f" "26ec8945-f1b6-562c-bbd1-75bf91d6d8f9" "3441fe89-7293-5b31-b163-63888dc6a81e" "e08884e4-dfc2-5827-ab9b-a5c05bebaf99" "f2b79cf3-1475-53c3-8cc0-a36177e50648" "9e553711-bf90-53e4-ba6b-bc55b5c0a510" "77111c5b-10e5-5bb5-94e6-3fb5b5aa49b8" "84cbc064-715e-5fce-b290-e88d33bbdceb" "b8c2fc5e-70f3-56f5-8026-a86928e8f670" "cc4042be-d3c8-5dd4-85bd-c639d4c42ded" "63fe8c15-9346-502a-aefe-915b0af4c1a5" "6c6c7fda-5efa-5287-aa40-a58a262ed3ed" "efb3d474-d09f-5658-8e1a-42cc7420268e" "d91d831d-46d7-5aaf-8809-134510636b85" "6cf8488e-ef5c-5bf9-b7a6-71c7a93f4d81" "6eff307f-f7be-5279-bc8c-b77f49ab8a00" "2a6b81e7-37f8-5dbe-9b07-fa6787df2e02" "534837a5-6688-50f2-b8ab-3f5cec899179"))
	(group "Review page 05: Operation and PCB guidance" (uuid "f7f6983a-4e07-55c3-85fd-35e9f05020f6") (members "994607c1-af48-5482-abfe-bb349e18bd0c" "b0dde83d-b1b5-5243-a877-88e02724336b" "842d2bae-2be7-59d3-b97f-99301b38986a" "cbea7401-08fc-58a6-bafc-019ab26d6f27" "e738e1f0-63d8-57b2-ab7f-d0f2fc873482" "d4295f30-0722-5e5d-93d1-218f6c425065" "850012bd-340c-50ec-b836-0937bdfd1482" "d5262ca6-1255-5502-9f49-02e5062207fd" "cdab4bbf-299e-51e7-9291-d3501cc02196" "ea64c571-39cb-5c00-952d-0cca4656652a" "2ccce98b-8134-5c32-b6db-fa57bff57728" "92e4b4cf-436b-5038-9309-714db1ca6781" "04484689-fd94-5b0a-bc3a-6d287cae55d1" "d52089c0-bb96-5347-80d1-47a448837340" "9862226b-6a74-5e47-9d20-c2c4da4cfe8a" "e07e9764-7b4d-59bc-9787-b325a158eb2f" "936cc93d-b765-5b72-a310-84342bccf56a" "ee4071f7-8515-5bba-b454-33120f72cae9" "1ee4923a-b115-568f-83f2-a2e81c69c1d5" "8b8a2941-4a78-5286-afd3-448786f264c1" "83a2e4be-f765-56e0-96f9-9f125cd4f738" "8797d721-ca70-5c2d-9626-09ed6530c330" "3c3560af-705a-5252-bc46-2e1c94d9b889" "06327c22-60b2-578b-99fb-4ee0b6ede5f0" "d0a63235-b2d8-50c6-9547-5c8c03b3cc66" "a581a979-b0e1-5a35-80e2-580c2a404868" "a5330c1b-e777-5a68-b850-4e6d5b4f5908" "3ae0a72d-74a7-5c0d-a955-cc25e78438c5" "0d6cd82e-3057-5544-950c-49bd8e6ec32b" "99a1272e-db6d-5247-99c6-6f98480e97ff" "0bf9e7b8-211b-5e8b-a1d2-08f21aa6dc76" "f2012fee-079b-526f-96bd-f0b2b652bc16" "bec2a2e4-6f3a-5f08-a749-0b610423cd4d" "a4d5586f-41a8-52bf-b609-41b6746af3e7" "a71513ab-e9c3-5ce9-afa3-b42a4a90cdfd" "aa0077c8-0bdd-5e96-8e40-01a0ecf70473" "4a268fc4-bef0-54ea-be25-ba94e3d194eb" "7f33c0bd-a119-5b89-b6c6-d137c41df172" "4cab1d01-395f-590f-827c-e28722627720" "cd7a5ea4-cd77-5319-910b-0f32a9630d03" "7e3a7418-a6f5-5421-b455-f21b344719e5" "873e153b-3f4c-54eb-93c2-b97b78baaa4e" "cbc70ad9-d9ef-5634-b412-46e9656a861c"))
