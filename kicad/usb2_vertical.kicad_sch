	(text "USB-C USB2 device port, vertical receptacle | USB4145, USBLC6 clamp, Rd 5.1 k, 5 V diode-OR" (at 15.24 15.24 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "0e19fe21-35f8-5f75-8829-87b7b23cf839"))
	(text "USB-C USB2 device-port front end on a VERTICAL, top-entry receptacle: GCT USB4145-03-0070-C, OW-CONN-USB-C-USB2-SMD-VERT, 16P USB2-only, SMT contacts plus four through-hole shell legs, 7.46 mm tall." (at 15.24 21.082 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "19e02f65-4487-5a06-9189-0173dc5b9104"))
	(text "Matching net labels are connected. Group order explains function; PCB placement priorities are stated below." (at 15.24 26.322 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c6d06582-3912-5174-9fa3-437e907c26f6"))
	(polyline (pts (xy 15.24 36.482) (xy 211.88 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "2b65e1f3-7c33-5563-b864-1b8d04a95747"))
	(text "1. Receptacle and ESD clamp" (at 15.24 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "3f847c63-103f-586f-8661-9a69d2e5daad"))
	(text "${209f383d-7927-4c04-b30a-21fe2c8eb9bb:REFERENCE} brings VBUS, GND, D+/D-, CC1/CC2 and the shell onto the board; ${a93e9f9a-5a6f-4043-8a0b-cad9a8361e7e:REFERENCE} clamps USB_D+, USB_D- and VBUS to GND right at the receptacle. ${7d317996-fe5e-4d1c-afb9-8653c242779c:REFERENCE} holds the raw VBUS node at" (at 15.24 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "84a22a4d-39d9-5932-9439-cab65ba40bb8"))
	(text "the clamp; ${80f6a5a7-fb59-4c71-91f3-2d3c27fa892a:REFERENCE} passes VBUS to +5V_USB and blocks the other 5 V source from feeding back into the host." (at 15.24 45.712 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fe7d1c13-05be-5bb4-9348-d228c6f61801"))
	(text "ESD clamp on D+, D- and VBUS" (at 20.32 155.624592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "88de6e5b-1205-5366-aecd-05a7f82b79eb"))
	(text "${7d317996-fe5e-4d1c-afb9-8653c242779c:REFERENCE}: VBUS bypass at the clamp" (at 20.32 158.164592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "637dc33d-821d-59de-939e-ac69d18cdfa0"))
	(text "${80f6a5a7-fb59-4c71-91f3-2d3c27fa892a:REFERENCE}: Diode-OR Schottky" (at 20.32 160.704592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "82aca449-f961-54f4-b908-bb9745f825d4"))
	(text "usb-connector" (at 20.32 246.572708 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "467950c6-7d06-5853-ae5a-cd2326dc1db2"))
	(text "PLACE: Place ${a93e9f9a-5a6f-4043-8a0b-cad9a8361e7e:REFERENCE} hard against ${209f383d-7927-4c04-b30a-21fe2c8eb9bb:REFERENCE} with a ground via at its pin 2; route each data line in one I/O pad and out the other." (at 15.24 251.652708 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0f82fa1c-1a13-509f-ba79-2893adf35b69"))
	(text "PLACE: Place ${209f383d-7927-4c04-b30a-21fe2c8eb9bb:REFERENCE}'s four shell-leg holes and two locator pegs before pouring GND or routing the port; the part does not seat without them." (at 15.24 255.462708 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bb586dee-f808-5c98-b496-18888fe73c73"))
	(text "PLACE: Place ${7d317996-fe5e-4d1c-afb9-8653c242779c:REFERENCE} between ${a93e9f9a-5a6f-4043-8a0b-cad9a8361e7e:REFERENCE} pin 5 and the GND via; ${80f6a5a7-fb59-4c71-91f3-2d3c27fa892a:REFERENCE} sits where +5V_USB leaves the block at its port via." (at 15.24 259.272708 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0e73b155-3dc5-53b6-9962-5e2f573357b2"))
	(text "ROUTE: USB_D+ and USB_D- are the USB_HS pair: equal length, coupled at the class gap, brought to the block boundary already coupled." (at 15.24 263.082708 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7953b46b-193a-5b91-a8e0-86a3938a3fc6"))
	(text "ROUTE: Jump one leg of each pair once at the body centre for the A/B tie; the 0.3 mm gap at the outer contacts is unroutable." (at 15.24 266.892708 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4d796b69-7d5a-57db-abb9-09243a6aacc3"))
	(text "ROUTE: VBUS and +5V_USB are Default-class rails for the port's 5 V budget; +5V_USB is picked up at the port via by the placing board." (at 15.24 270.702708 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "935f2bea-d55b-5e39-9010-5c13bbdb0510"))
	(polyline (pts (xy 219.5 36.482) (xy 399.5 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "0b004c04-abac-5072-b6b8-b77a7b5ac907"))
	(text "2. CC sink declaration" (at 219.5 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "ba45f9c8-3254-5cc4-a7ec-642a8d627310"))
	(text "${e0574d6f-c3cf-4023-bcca-2b89f01980b8:REFERENCE} and ${e9b764a5-f224-4026-a384-e54737094fce:REFERENCE} (5.1 k) pull CC1 and CC2 to GND: the port presents itself as a sink; nothing reads the source's advertisement." (at 219.5 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "49aa0b36-a6e9-526c-a7f7-f79d814f96d1"))
	(text "CC Rd sink pulldowns" (at 224.58 87.044592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "72ec3c3f-4d2b-5e1d-b83e-a34890a3df00"))
	(text "CC Rd sink pulldowns" (at 248.469141 87.044592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cc5e5374-a655-5029-8bf5-59b916e3e7cd"))
	(text "PLACE: Keep ${e0574d6f-c3cf-4023-bcca-2b89f01980b8:REFERENCE} at A5 and ${e9b764a5-f224-4026-a384-e54737094fce:REFERENCE} at B5 with short returns; no other load on CC1 or CC2." (at 219.5 92.124592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "dc3188db-d5fc-535e-b613-de20d00f5be2"))
	(text "ROUTE: CC1 and CC2 are Default-class local nets that end at the resistors." (at 219.5 95.934592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "89c1036e-1141-58b5-959a-a100705daa52"))
	(polyline (pts (xy 219.5 107.364592) (xy 399.5 107.364592)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "8914dfe5-b323-553c-a4a5-785e74998c04"))
	(text "3. Power drive declarations" (at 219.5 109.904592 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "57026151-277d-583e-ad48-48fa52f25198"))
	(text "These nets have an explicit ERC power source declaration." (at 219.5 114.054592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "739684c3-0db1-5c39-a6f2-0a06ea90b9fa"))
	(text "Power driven: VBUS" (at 224.58 151.603525 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "92a145f9-f0bf-5076-80c7-a802969d5744"))
	(text "INTERFACES" (at 423.76 36.482 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "efb3d474-d09f-5658-8e1a-42cc7420268e"))
	(text "Raw bus 5 V, ${209f383d-7927-4c04-b30a-21fe2c8eb9bb:REFERENCE} A4, A9, B4, B9; bypassed by ${7d317996-fe5e-4d1c-afb9-8653c242779c:REFERENCE}, the clamp's reference." (at 423.76 46.99 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d91d831d-46d7-5aaf-8809-134510636b85"))
	(text "VBUS through ${80f6a5a7-fb59-4c71-91f3-2d3c27fa892a:REFERENCE} (Schottky, about 0.3 V drop) for diode-ORing with +5V_PYC." (at 423.76 59.69 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6cf8488e-ef5c-5bf9-b7a6-71c7a93f4d81"))
	(text "USB ground: ${209f383d-7927-4c04-b30a-21fe2c8eb9bb:REFERENCE} A1, B1, A12, B12 and shell S1 to S4; clamp and Rd return." (at 423.76 72.39 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6eff307f-f7be-5279-bc8c-b77f49ab8a00"))
	(text "USB 2.0 D+, ${209f383d-7927-4c04-b30a-21fe2c8eb9bb:REFERENCE} A6 and B6, after the ${a93e9f9a-5a6f-4043-8a0b-cad9a8361e7e:REFERENCE} clamp; USB_HS pair with USB_D-." (at 423.76 85.09 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2a6b81e7-37f8-5dbe-9b07-fa6787df2e02"))
	(text "USB 2.0 D-, ${209f383d-7927-4c04-b30a-21fe2c8eb9bb:REFERENCE} A7 and B7, after the ${a93e9f9a-5a6f-4043-8a0b-cad9a8361e7e:REFERENCE} clamp; USB_HS pair with USB_D+." (at 423.76 97.79 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "534837a5-6688-50f2-b8ab-3f5cec899179"))
	(polyline (pts (xy 423.76 113.03) (xy 578.76 113.03)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "994607c1-af48-5482-abfe-bb349e18bd0c"))
	(text "INTERNAL NETS" (at 423.76 115.57 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "b0dde83d-b1b5-5243-a877-88e02724336b"))
	(text "CC1: Configuration channel for one plug orientation, ${209f383d-7927-4c04-b30a-21fe2c8eb9bb:REFERENCE} A5 to ${e0574d6f-c3cf-4023-bcca-2b89f01980b8:REFERENCE} (Rd, 5.1 k to GND); nothing reads it." (at 423.76 119.72 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "842d2bae-2be7-59d3-b97f-99301b38986a"))
	(text "CC2: Configuration channel for the other orientation, ${209f383d-7927-4c04-b30a-21fe2c8eb9bb:REFERENCE} B5 to ${e9b764a5-f224-4026-a384-e54737094fce:REFERENCE} (Rd, 5.1 k to GND); nothing reads it." (at 423.76 123.53 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cbea7401-08fc-58a6-bafc-019ab26d6f27"))
	(polyline (pts (xy 423.76 134.96) (xy 578.76 134.96)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "e738e1f0-63d8-57b2-ab7f-d0f2fc873482"))
	(text "OPERATION" (at 423.76 137.5 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "d4295f30-0722-5e5d-93d1-218f6c425065"))
	(text "Signal path: ${209f383d-7927-4c04-b30a-21fe2c8eb9bb:REFERENCE} D+ (A6, B6) and D- (A7, B7) pass ${a93e9f9a-5a6f-4043-8a0b-cad9a8361e7e:REFERENCE}'s I/O pads to USB_D+ and USB_D-; both receptacle rows are tied so either plug" (at 423.76 141.65 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "850012bd-340c-50ec-b836-0937bdfd1482"))
	(text "orientation works. SBU1 and SBU2 (A8, B8) are no-connect: USB2 only, for an RP2040-class device controller." (at 423.76 144.19 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d5262ca6-1255-5502-9f49-02e5062207fd"))
	(text "CC: ${e0574d6f-c3cf-4023-bcca-2b89f01980b8:REFERENCE} on CC1 (A5) and ${e9b764a5-f224-4026-a384-e54737094fce:REFERENCE} on CC2 (B5), 5.1 k to GND, declare a UFP (sink). Nothing reads the CC level, so budget the load against a" (at 423.76 148 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cdab4bbf-299e-51e7-9291-d3501cc02196"))
	(text "default-power source unless the host is known to advertise 1.5 A or 3 A." (at 423.76 150.54 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ea64c571-39cb-5c00-952d-0cca4656652a"))
	(text "ESD: ${a93e9f9a-5a6f-4043-8a0b-cad9a8361e7e:REFERENCE} (USBLC6-2P6) clamps D+, D- and VBUS: 3.5 pF max per line, 1.7 pF max line to line, 6 V minimum VBUS breakdown, 12 V typical" (at 423.76 154.35 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2ccce98b-8134-5c32-b6db-fa57bff57728"))
	(text "clamp at 1 A 8/20 us, IEC 61000-4-2 level 4 (15 kV air and contact). Clamp performance is set by connection inductance: pin 2 to a ground via," (at 423.76 156.89 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "92e4b4cf-436b-5038-9309-714db1ca6781"))
	(text "each data line in one I/O pad and out the other." (at 423.76 159.43 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "04484689-fd94-5b0a-bc3a-6d287cae55d1"))
	(text "VBUS: ${7d317996-fe5e-4d1c-afb9-8653c242779c:REFERENCE} (100 nF) bypasses the raw bus; ${80f6a5a7-fb59-4c71-91f3-2d3c27fa892a:REFERENCE} (MBR120VLSFT1G, 20 V 1 A Schottky, 0.34 V max at 1 A, 0.6 mA leakage at 25 C) makes" (at 423.76 163.24 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d52089c0-bb96-5347-80d1-47a448837340"))
	(text "+5V_USB for diode-ORing with the pyControl block's +5V_PYC. The shell pads S1 to S4 are tied to GND here; isolate them through a pad/cap network" (at 423.76 165.78 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9862226b-6a74-5e47-9d20-c2c4da4cfe8a"))
	(text "instead if the shield must float." (at 423.76 168.32 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e07e9764-7b4d-59bc-9787-b325a158eb2f"))
	(text "Land pattern (from the block's own record): contacts in two rows on opposite sides of the body at 0.5 mm pitch, every pad 0.3 mm wide; the A/B ties" (at 423.76 172.13 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "936cc93d-b765-5b72-a310-84342bccf56a"))
	(text "for D+ and D- cross at the body centre with one via jump per pair leg and equal lengths; VBUS and GND each land on four pads to be used in" (at 423.76 174.67 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ee4071f7-8515-5bba-b454-33120f72cae9"))
	(text "parallel for the 3 A rating. Four plated shell legs and two 0.71 mm locator pegs are mandatory for seating. The cable leaves perpendicular to the" (at 423.76 177.21 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1ee4923a-b115-568f-83f2-a2e81c69c1d5"))
	(text "board (7.46 mm connector height), so the enclosure needs an aperture above it." (at 423.76 179.75 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8b8a2941-4a78-5286-afd3-448786f264c1"))
	(polyline (pts (xy 423.76 191.18) (xy 578.76 191.18)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "83a2e4be-f765-56e0-96f9-9f125cd4f738"))
	(text "DESIGN CONTRACT" (at 423.76 193.72 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "8797d721-ca70-5c2d-9626-09ed6530c330"))
	(text "USB-C USB2 device-port front end on a VERTICAL, top-entry receptacle: GCT USB4145-03-0070-C, OW-CONN-USB-C-USB2-SMD-VERT, 16P" (at 423.76 197.87 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3c3560af-705a-5252-bc46-2e1c94d9b889"))
	(text "USB2-only, SMT contacts plus four through-hole shell legs, 7.46 mm tall. Electrically identical to the horizontal usb2 block: USBLC6-2P6 ESD clamp" (at 423.76 200.41 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "06327c22-60b2-578b-99fb-4ee0b6ede5f0"))
	(text "on D+/D- and VBUS, 5.1k Rd pulldowns on CC1 (A5) and CC2 (B5) declaring a sink, 100nF on VBUS, a MBR120VLSFT1G series Schottky from VBUS to" (at 423.76 202.95 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d0a63235-b2d8-50c6-9547-5c8c03b3cc66"))
	(text "+5V_USB for diode-ORing with other 5 V sources (pair it with pycontrol_behavior_port_rj45's +5V_PYC), PWR_FLAG on VBUS, SBU1/SBU2 deliberately" (at 423.76 205.49 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a581a979-b0e1-5a35-80e2-580c2a404868"))
	(text "unconnected, all four shell pads S1-S4 tied to GND. Ports are VBUS, +5V_USB, GND, USB_D+, USB_D-." (at 423.76 208.03 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a5330c1b-e777-5a68-b850-4e6d5b4f5908"))
	(text "Nothing reads the CC advertisement, so budget the load against a default-power source unless the host is known to advertise 1.5 A or 3 A." (at 423.76 210.57 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3ae0a72d-74a7-5c0d-a955-cc25e78438c5"))
	(text "Only the land pattern differs from usb2, and it differs completely, which is why this is a separate block and not a footprint swap: contacts sit in two" (at 423.76 213.11 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0d6cd82e-3057-5544-950c-49bd8e6ec32b"))
	(text "rows on OPPOSITE sides of the body at y = +/-1.485, 0.5 mm pitch across the six inner contacts and 1.5 mm out to the outer pads, and EVERY pad" (at 423.76 215.65 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "99a1272e-db6d-5247-99c6-6f98480e97ff"))
	(text "is 0.3 mm wide, where the horizontal GT-USB-7047C merges A and B into one row and gives VBUS and GND 0.6 mm pads. Three consequences follow" (at 423.76 218.19 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0bf9e7b8-211b-5e8b-a1d2-08f21aa6dc76"))
	(text "for the layout. The A/B ties are the layout's work: D+ (A6/B6) and D- (A7/B7) cross at the body centre and cannot be taken around the ends," (at 423.76 220.73 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f2012fee-079b-526f-96bd-f0b2b652bc16"))
	(text "because the 0.3 mm gap between the outer contact and the shell-leg pad is unroutable at 0.2/0.2 and the plated leg blocks every layer there, so" (at 423.76 223.27 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bec2a2e4-6f3a-5f08-a749-0b610423cd4d"))
	(text "budget one via jump for one leg of the pair and keep both legs equal length. VBUS lands on four 0.3 mm pads (A4/A9/B4/B9) and GND on four" (at 423.76 225.81 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a4d5586f-41a8-52bf-b609-41b6746af3e7"))
	(text "(A1/A12/B1/B12): use all four of each in parallel for the 3 A rating and drop their ties to an inner layer rather than crowding the 1.8 mm corridor" (at 423.76 228.35 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a71513ab-e9c3-5ce9-afa3-b42a4a90cdfd"))
	(text "between the rows, which the two data joins need. The four shell legs are plated ovals on a 1.1 x 0.6 drill at x = +/-4 and punch every layer, and" (at 423.76 230.89 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "aa0077c8-0bdd-5e96-8e40-01a0ecf70473"))
	(text "the two 0.71 mm NPTH locator pegs at (+/-4, 0) are mandatory for seating: place all six before pouring GND or routing the port." (at 423.76 233.43 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4a268fc4-bef0-54ea-be25-ba94e3d194eb"))
	(text "Mechanically the courtyard shrinks to x +/-5.05, y +/-2.31 from the horizontal part's x +/-6.00, y -1.25 to +6.75, so the connector stops needing" (at 423.76 235.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7f33c0bd-a119-5b89-b6c6-d137c41df172"))
	(text "about 6.75 mm of board past the contacts and can move inboard, but the cable now leaves perpendicular to the board: the enclosure needs an" (at 423.76 238.51 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4cab1d01-395f-590f-827c-e28722627720"))
	(text "aperture above it plus clearance for the plug body and its wire loop, well beyond the 7.46 mm connector height." (at 423.76 241.05 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cd7a5ea4-cd77-5319-910b-0f32a9630d03"))
	(text "Keep the USBLC6 hard against the receptacle with a ground via at its pin 2 and route each data line in one I/O pad and out the other (clamp" (at 423.76 243.59 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7e3a7418-a6f5-5421-b455-f21b344719e5"))
	(text "performance is dominated by connection inductance), and bring USB_D+/USB_D- to the block boundary already coupled at the USB_HS netclass gap." (at 423.76 246.13 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "873e153b-3f4c-54eb-93c2-b97b78baaa4e"))
	(text "+5V_USB leaves ${80f6a5a7-fb59-4c71-91f3-2d3c27fa892a:REFERENCE} pad 1 into a port via, where a placing board picks the rail up." (at 423.76 248.67 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cbc70ad9-d9ef-5634-b412-46e9656a861c"))
	(group "Review page 01: 1. Receptacle and ESD clamp" (uuid "3f836535-b8cc-5f16-b656-ca5012506274") (members "7d317996-fe5e-4d1c-afb9-8653c242779c" "05277784-e5d7-5520-abd7-ddeaa3afe9bc" "a7b7020e-b975-5bf8-b919-cad5a85e5b9a" "368527a5-29a4-52ca-acab-93bea45043ec" "32dd32f4-71b6-5ae3-a4d8-6a925e55075b" "80f6a5a7-fb59-4c71-91f3-2d3c27fa892a" "cd1e4843-1c62-586e-8e12-7a1a49284865" "125f6018-5be8-5fb1-b908-632fc606e145" "72c494d6-af6e-5753-bcbe-dde21fc4aeea" "b9450d8f-017f-5952-9f68-656ea0c68eb3" "209f383d-7927-4c04-b30a-21fe2c8eb9bb" "017c5832-4062-5c4e-a231-7c255132376b" "61e19997-301d-59c1-bd6e-a08763fca9d3" "62cef666-3b61-59ac-9d18-48b9fd6b226e" "9b25f154-6289-5a0a-8b56-b4e5a64c7a50" "cdaceabf-bf50-5a26-ae3c-d45f39b78f60" "b41f03aa-8876-5230-bac3-7526dc055802" "8d295ced-59e9-5e8b-8f98-17e31ca31c11" "a72ee312-5d7b-585a-b3be-1e3648101ff7" "a4d2fd62-8f07-5fd8-a283-eea61344d0f7" "fc25d84f-82de-5f4a-91ad-d8db7c9fdefb" "2a117173-d4f0-5daf-aead-b21f93b67abb" "f67d4072-c8e8-5540-8dd1-0a5adaa17876" "1a2bdc9f-bd00-5c60-8c0e-6b04ae746a0d" "f18dba7e-0e47-54bf-af82-449760e0d5be" "b45873b9-fed1-5326-b0fa-a3bbcfbc01c7" "18d49f4f-cb71-5642-8324-3d4e8050a223" "f637be75-e940-5236-855f-94653ec9b07c" "c5ab742f-1957-57d1-8b8a-c21f18ed3c47" "33e798c1-d363-5e5d-8bc9-acb149582b81" "a2f4124c-83fa-5d7c-8cd1-3b3757c8a96a" "81728d2f-2192-5387-b832-6a8e89ccc18d" "34cc4e7e-b74f-516d-aac6-4f933da2191e" "37707aa4-388f-598c-869c-e78dfd01382f" "9fb2be79-7caf-5160-b458-bedf7e7bef78" "a29b8254-a6f4-503d-9426-3f6e648ccdd6" "a0c43924-c771-5288-b433-62efb101b974" "2ebfeaed-9813-5d23-8d51-5189223fd537" "29f3809a-2d86-5fd8-97af-21cb162deeb0" "a93e9f9a-5a6f-4043-8a0b-cad9a8361e7e" "94f545b0-0bf9-5c91-840f-524e214809e0" "46f1bd6d-684e-51ef-a5c3-1ffd7826a45b" "b680090c-aeff-5072-945e-21a4683dc9ab" "07fef92d-6c46-50c4-8214-85cf26d2fb01" "e28a88e9-8f70-5ddf-bbdc-95cfefdd3522" "50c30fd0-413f-5eee-82a0-72e165180e35" "9cf17b0b-4b55-5ed0-b133-afdd3d264d06" "8e109675-6799-51a8-9209-bd9266a94572" "6ec06dc7-f0aa-5dae