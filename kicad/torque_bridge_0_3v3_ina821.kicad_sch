	(text "Matching net labels are connected. Group order explains function; PCB placement priorities are stated below." (at 15.24 26.322 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "826c1177-b567-5a12-b1ba-86ceabea7dfe"))
