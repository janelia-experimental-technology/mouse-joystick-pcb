	(text "REF5010 supplies VREF10. ${e1bfe9cb-0ea9-499f-9f3d-f1a491cbba69:REFERENCE} drives ${0cf28f10-9ac5-4f39-9f87-bff72c64332b:REFERENCE} through ${b9104025-3283-4fc5-b277-363d9833910b:REFERENCE}; the emitter feeds VEXC through 10 ohm ${76029bfd-17c2-49b9-b16b-5f980ba77047:REFERENCE}. Feedback senses VEXC after that resistor. A 350 ohm bridge draws 28.6" (at 233.746667 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f1610a4f-ccc9-543c-9646-cbb5c35aca16"))
	(text "mA (286 mW). ${6d02493f-6a97-4f35-a08c-f10c4d835320:REFERENCE} pulls an open reference low." (at 233.746667 45.712 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "07879155-8b16-5ed9-bedc-d2f74531a7c9"))
