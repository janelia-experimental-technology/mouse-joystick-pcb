	(text "100 ohm resistors isolate the SCK, CIPO, COPI and TQ_CONVST_CS monitor branches. The current circuit has no TQ_CONVST_CS pull-up. ${c033e40c-0431-4127-8ac2-73f467170639:REFERENCE} in group 1 similarly isolates" (at 233.746667 384.564592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ed0520df-44bf-5aeb-8551-59d9f88460a7"))
