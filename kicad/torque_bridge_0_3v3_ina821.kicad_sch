	(text "PLACE: Use ${18953c0b-da3a-439e-8a35-bf8f128367fe:REFERENCE}/${e16a9ba2-7a2a-43e8-b06f-2a404b8adffc:REFERENCE} from the same precision-resistor reel as ${90b03a17-f3a9-4b17-b836-79d57ba9a2ff:REFERENCE}/${a1f3ecfe-d54e-4eb2-adc5-e27cb4d14a49:REFERENCE}/${7ae1fa1e-929f-4b99-8482-3a0103d52cd3:REFERENCE}; keep matched resistors at similar temperature." (at 15.24 320.724592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bb4009ac-6adf-59b4-99f0-7c02857af3e1"))
