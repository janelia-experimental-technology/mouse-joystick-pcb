	(text "Two series 10k resistors above ATT_TAP and one 10k below give DC gain 1/3. ${57aecaeb-4645-4596-961d-7984488e8535:REFERENCE} and ${1ffc2acb-b7c5-47f4-a1ed-d6758c624cf1:REFERENCE} are 10 nF C0G; ${0d86c6e5-c495-435a-9e0e-73d326350a9e:REFERENCE} is 13k. ${a7f8bfa8-bc3f-40cb-976f-a175c0bdb36f:REFERENCE} buffers FILT_IN onto AMP_VOUT; ${2e0092c4-505e-4dbc-b67b-043bbe7d4abb:REFERENCE} discharges its" (at 452.253333 220.398954 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4d114bf2-7bc2-50e7-b586-4ee0a8d00e6a"))
	(text "output. Ideal filter: -3 dB about 690 Hz, DC group delay about 263 us. Retune both capacitors together; resistor changes also change the mapping." (at 452.253333 222.938954 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6109b49d-9548-5a0f-a1ca-131801df9a5b"))
