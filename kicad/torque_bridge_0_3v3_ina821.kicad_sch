	(text "PLACE: Cluster the divider and filter beside ${a7f8bfa8-bc3f-40cb-976f-a175c0bdb36f:REFERENCE}. Keep the three precision 10k parts thermally close. Put ${d1ff583f-3fdd-4bb4-bcda-9675157fc787:REFERENCE} at ${a7f8bfa8-bc3f-40cb-976f-a175c0bdb36f:REFERENCE}.5." (at 452.253333 376.604592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5bb9c7f4-5c0c-5d56-becd-86c38449fef3"))
