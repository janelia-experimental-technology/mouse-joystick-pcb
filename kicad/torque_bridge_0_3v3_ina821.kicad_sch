	(text "PLACE: Keep reference / error amp together; separate pass-device heat from precision ratios. ${0855cadc-3baf-4fe5-b321-f6f477d84c1e:REFERENCE} bypasses ${0316917d-9692-4735-892a-7db2ce63186c:REFERENCE}; ${30535314-0172-4364-a341-9559897f4e3a:REFERENCE} bypasses ${e1bfe9cb-0ea9-499f-9f3d-f1a491cbba69:REFERENCE}." (at 233.746667 211.504592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1ac6ca72-4b3b-5e9f-8eb4-aa9d40676946"))
	(text "ROUTE: Kelvin-route ${e1bfe9cb-0ea9-499f-9f3d-f1a491cbba69:REFERENCE}.4 to VEXC at ${de5971d3-210a-427e-bcf2-1b0120408c65:REFERENCE}.3. Sensing VEXC_DRV would leave the approximately 286 mV bridge-current drop uncompensated." (at 233.746667 215.314592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7a8e518b-6671-596f-a78b-0d2b2ff5971d"))
