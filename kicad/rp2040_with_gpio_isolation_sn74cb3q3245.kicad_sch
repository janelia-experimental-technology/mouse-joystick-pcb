	(text "PLACE: Next to pins 51-56, ${2ec4cb5b-c7ac-4da1-8b27-74bcde073cad:REFERENCE} at pin 8, pad 9 to GND." (at 767.88 148.004592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "deafc208-6e33-5790-acc1-916579c66a7b"))
