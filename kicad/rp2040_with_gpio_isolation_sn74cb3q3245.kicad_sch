	(text "Switched GPIO26: ${7a6a6ceb-6c8d-470b-b733-f24d95709c3b:REFERENCE} A3 (pin 4); bare pass gate, 3.3 V domain only." (at 1018.76 715.01 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0595e78a-c95e-52ab-b104-3e961d7dc841"))
