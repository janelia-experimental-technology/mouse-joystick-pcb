	(text "RP2040 core with GPIO isolation | flash, 12 MHz crystal, BOOTSEL and RUN, four SN74CB3Q3245 bus switches" (at 15.24 15.24 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "716387b6-e566-5ab5-b350-a17cfe488cb1"))
	(text "RP2040 controller core and its GPIO isolation in one block: the full rp2040 core - W25Q128JVPIQ QSPI flash, 12 MHz ABM8 crystal, decoupling, BOOTSEL and RUN switches - plus four SN74CB3Q3245RGYR 8-channel bidirectional FET bus switches, with all 29 MCU-to-switch connections made inside the block so that routing is placed once instead of re-drawn per board." (at 15.24 21.082 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "07fb7733-bae4-5292-901f-1d2f1b5a144d"))
	(text "Matching net labels are connected. Group order explains function; PCB placement priorities are stated below." (at 15.24 26.322 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "22d23f4b-3f50-544a-b8d1-7d67e57a0ee2"))
	(polyline (pts (xy 15.24 36.482) (xy 308.7 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "fb721302-2f44-5291-8440-6b52f9c268f3"))
	(text "1. Controller core" (at 15.24 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "41aa38f1-b2e9-5d1b-bbce-81348cfc8de2"))
	(text "${a5104d22-59ed-4e14-b91e-bfc4d19f5cbf:REFERENCE}: QSPI to ${8cc8a515-f16f-4003-a384-a7ebe0a902c5:REFERENCE}, USB through ${f4d604cc-a41b-4c5f-91fb-70f0f315fe11:REFERENCE}/${cedf1931-96b1-4540-9d90-bcdade76c268:REFERENCE}, GPIO0-29 to the switches' B side, GPIO9 as the enable. +3.3V: ${1cb87ed5-69f6-4075-b8d2-782238f5e635:REFERENCE} (1 uF) bulk at VREG_IN and seven 100 nF for the nine +3.3V supply pins: ${c47c854b-1bb8-4264-9ef6-7c07d0e5b560:REFERENCE} at IOVDD 1, ${efda8890-a405-4ce6-9ad3-b04f634a15a3:REFERENCE} at IOVDD 10, ${059d64bd-c321-4fcb-b0a8-cb65d8d599e7:REFERENCE} at IOVDD 22, ${afc75855-e05f-4148-a389-4918ed910b98:REFERENCE}" (at 15.24 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e67c661c-3680-5e51-a1eb-c5cc2ac76d35"))
	(text "at IOVDD 33; ${b993fd92-0e09-44ad-ad7e-5f8bc893a235:REFERENCE}, ${7ba5624c-94da-413f-84d4-c1489eecaedd:REFERENCE} and ${c61f46df-4504-4f23-8736-4f35298818a9:REFERENCE} at the corner of IOVDD 42, ADC_AVDD 43, VREG_IN 44, USB_VDD 48 and IOVDD 49, where the routed PCB fixes the pairing. +1.1V: ${bcedcf39-e20b-4bf1-8165-b45139a8ad22:REFERENCE} at DVDD 23, ${805e76c9-a5fa-45c8-8dec-3d044d3d766d:REFERENCE} at VREG_VOUT 45, ${91298403-19a6-4a9a-9476-901e047393e5:REFERENCE} (1 uF) beside DVDD 50." (at 15.24 45.712 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b7c6a60f-13b4-5165-8dd8-4c1d1797146a"))
	(text "Controller core; GPIO9 is the switch enable" (at 20.32 208.964592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "11b1913f-97aa-5fef-a16f-cf590ed42501"))
	(text "${c47c854b-1bb8-4264-9ef6-7c07d0e5b560:REFERENCE}: IOVDD pin 1 bypass, 100 nF; ${afc75855-e05f-4148-a389-4918ed910b98:REFERENCE}: IOVDD pin 33 bypass, 100 nF; ${059d64bd-c321-4fcb-b0a8-cb65d8d599e7:REFERENCE}: IOVDD pin 22 bypass, 100 nF; ${b993fd92-0e09-44ad-ad7e-5f8bc893a235:REFERENCE}: Corner bypass, pins 42-44, 48, 49, 100 nF; ${efda8890-a405-4ce6-9ad3-b04f634a15a3:REFERENCE}: IOVDD pin 10 bypass, 100 nF; one per IOVDD pins 1, 10, 22, 33, 42, 49" (at 20.32 211.504592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c2974202-d819-5906-bb54-e409162eab64"))
	(text "${91298403-19a6-4a9a-9476-901e047393e5:REFERENCE}: +1.1V bulk beside DVDD pin 50, 1 uF; ${bcedcf39-e20b-4bf1-8165-b45139a8ad22:REFERENCE}: DVDD pin 23 bypass, 100 nF; one per DVDD pins 23, 50" (at 20.32 214.044592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cb0ffdae-15ac-593a-9622-3296c257e5bc"))
	(text "${1cb87ed5-69f6-4075-b8d2-782238f5e635:REFERENCE}: +3.3V bulk at VREG_IN pin 44, 1 uF" (at 20.32 216.584592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fbb5e60f-2ce4-5dfb-8907-b562e93d6ea7"))
	(text "${7ba5624c-94da-413f-84d4-c1489eecaedd:REFERENCE}, ${c61f46df-4504-4f23-8736-4f35298818a9:REFERENCE}: Corner bypass, pins 42-44, 48, 49, 100 nF" (at 20.32 219.124592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b1127887-95be-5456-aa48-24d47d8e9901"))
	(text "${f62dac92-70b6-4e44-9437-327a35a1caeb:REFERENCE}: QSPI_SS pull-up, 10 k" (at 20.32 221.664592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "238d8103-806a-5569-8219-41d3c3e305c0"))
	(text "${805e76c9-a5fa-45c8-8dec-3d044d3d766d:REFERENCE}: VREG_VOUT pin 45 bypass, 100 nF" (at 20.32 224.204592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ef25d364-c3d6-55d8-a9ef-2961356e8bfc"))
	(text "PLACE: Exposed pad to GND copper with vias; GPIO escapes toward the switches." (at 15.24 229.284592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "895f1e51-a907-54dd-ad52-17693e599c7b"))
	(text "PLACE: Each capacitor hard against its pin with the shortest return to the GND pad (57); the corner pins 42 to 44, 48 and 49 share ${b993fd92-0e09-44ad-ad7e-5f8bc893a235:REFERENCE}, ${7ba5624c-94da-413f-84d4-c1489eecaedd:REFERENCE} and ${c61f46df-4504-4f23-8736-4f35298818a9:REFERENCE}." (at 15.24 233.094592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ca9eff60-1b57-5141-a55a-e4426fec9431"))
	(text "ROUTE: Switched signals leave on the A side; raw GPIO ports are the same B-side traces." (at 15.24 236.904592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "13556179-84a3-5696-8eb2-4aa1c26b20e6"))
	(text "ROUTE: +1.1V stays inside the block; the switches' VCC pins have their own capacitors." (at 15.24 240.714592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9f6eccaf-d623-559f-b9ab-6437c2809156"))
	(polyline (pts (xy 517 36.482) (xy 760.26 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "974f79ba-44bf-56a1-8f0e-cc755e37e6b9"))
	(text "2. Clock" (at 517 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "ccd245f5-5ba0-59f8-b3fe-fa7334845aea"))
	(text "${3f6431a7-d235-4c5b-a8c3-f3e79a8a5216:REFERENCE} (12 MHz) between XIN and XOUTB with 15 pF loads; ${da9e6438-2e15-4e59-87cc-3f2eecccbdf7:REFERENCE} (1 k) in the XOUT leg." (at 517 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "75d1c4e4-2834-5854-8c42-7e7a82f63187"))
	(text "12 MHz crystal" (at 522.08 97.204592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ffc9e6ae-a0ab-517e-a4d0-f70a446bfdc5"))
	(text "${98f52652-2300-4a88-873a-5d62116cb394:REFERENCE}, ${b8b46286-3ae0-4dd7-8d7c-301ef05bff89:REFERENCE}: Crystal load capacitors (15 pF, C0G)" (at 522.08 99.744592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4eefd91c-e612-5ad3-b7d0-4ec3511819a9"))
	(text "Crystal drive limit, 1 k, XOUT" (at 522.08 127.654592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "496d46b9-9a7b-5cc1-8f6c-6479196e6cba"))
	(text "PLACE: All four at pins 20 and 21 over a local ground; nothing else beside the crystal." (at 517 132.734592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a7522060-1c9a-5186-87eb-4393a9379976"))
	(text "ROUTE: Short traces, no vias, GND fill around; keep switching lines away." (at 517 136.544592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1955ca7a-9145-54e3-9272-c42e9625ecd2"))
	(polyline (pts (xy 767.88 36.482) (xy 1011.14 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "15162092-a6b8-53d0-8fb5-4b480d478484"))
	(text "3. QSPI flash" (at 767.88 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "8b86df43-72ce-5fc2-a70f-ba0374ef1221"))
	(text "${8cc8a515-f16f-4003-a384-a7ebe0a902c5:REFERENCE} (W25Q128JVPIQ) on QSPI_SCLK, SD0-SD3 and QSPI_SS; ${2ec4cb5b-c7ac-4da1-8b27-74bcde073cad:REFERENCE} decouples pin 8." (at 767.88 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "23a915ff-37c4-5cde-8dbc-d74a756fbe15"))
	(text "QSPI boot flash, 16 MB" (at 772.96 137.844592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a98128c0-7eb8-5615-8642-a87c9872fab2"))
	(text "${2ec4cb5b-c7ac-4da1-8b27-74bcde073cad:REFERENCE}: ${8cc8a515-f16f-4003-a384-a7ebe0a902c5:REFERENCE} VCC pin 8" (at 772.96 140.384592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "167b55c0-cf94-54d8-9fe1-1f3c229f9011"))
