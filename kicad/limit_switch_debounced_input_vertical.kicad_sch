	(text "Debounced limit-switch input, vertical terminal | MAX6816, output pull-down, instrument tap" (at 15.24 15.24 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "87ad8589-4209-5781-acdb-c7bbaf2f82ef"))
	(text "Debounced limit-switch input with its own 2-position 3.5 mm VERTICAL, top-entry pluggable screw terminal — Phoenix MCV 1,5/2-G-3,5, OW-CONN-TBH-1X02-3P5-VERT, on the local orb_weaver_tht copy of the MCV footprint — plus a MAX6816 single switch debouncer and local Vcc decoupling." (at 15.24 21.082 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "77b624bb-a971-5afa-b09d-db7099052ae1"))
	(text "Matching net labels are connected. Group order explains function; PCB placement priorities are stated below." (at 15.24 26.322 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "09a647c3-203d-5ce4-8273-6e45a8d8ffc1"))
	(polyline (pts (xy 15.24 36.482) (xy 211.88 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "15c9c593-fab7-5995-bd21-1f6c0146bc68"))
	(text "1. Switch terminal and debouncer" (at 15.24 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "6da381b1-8526-55b7-bdfd-6c527e0a0e9a"))
	(text "${fb560492-07c1-40ba-abbe-6bac76e602ff:REFERENCE} brings the dry contact onto IN (pin 2) and GND (pin 1); ${ed1d27a5-4fdc-4e73-a297-77a8487eb0d8:REFERENCE} debounces IN and drives LIMIT_SW from its push-pull OUT. ${877edc0d-8517-4bfb-9a8a-87ef2f65742a:REFERENCE} (100 nF) bypasses Vcc (pin 4) to GND (pin 1)." (at 15.24 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "edf556de-e36b-5c44-8992-fd545f8e10ed"))
	(text "Switch debouncer" (at 20.32 142.924592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b739062c-d679-5674-93d0-44ffc921cee5"))
	(text "${877edc0d-8517-4bfb-9a8a-87ef2f65742a:REFERENCE}: Vcc bypass for ${ed1d27a5-4fdc-4e73-a297-77a8487eb0d8:REFERENCE}" (at 20.32 145.464592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "227cee12-b1d9-5886-8190-979d23e0764a"))
	(text "${1a5dbbac-981b-4337-8c39-817e15b42b3f:REFERENCE}: Output pull-down for the unpowered state" (at 20.32 148.004592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "53f44c71-b88e-55ca-bb05-677e518a3e22"))
	(text "Vertical switch terminal, pin 1" (at 20.32 178.238592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "48b5b603-41e6-5809-bacf-26012e6bda90"))
	(text "GND, pin 2 IN" (at 20.32 180.778592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1a610c75-202f-566e-b6a8-9e40d7d86085"))
	(text "PLACE: Keep ${ed1d27a5-4fdc-4e73-a297-77a8487eb0d8:REFERENCE} next to ${fb560492-07c1-40ba-abbe-6bac76e602ff:REFERENCE} so IN stays short; nothing else connects to IN. Leave the 4.75 mm inboard keepout of the vertical terminal free, and give the enclosure an aperture" (at 15.24 185.858592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "31fa7b85-e705-5367-a35b-24cb13a7a7cd"))
	(text "above it for the plug, the screw head and the wire loop." (at 15.24 188.398592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "603a35ca-98ac-5c7c-84c3-7d66943a6d57"))
	(text "PLACE: Place ${877edc0d-8517-4bfb-9a8a-87ef2f65742a:REFERENCE} hard against pin 4 with a short return to pin 1." (at 15.24 192.208592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d207cac3-0d70-558b-95d3-7cf6fc577517"))
	(text "ROUTE: The LIMIT_SW and GND runs share the corridor bounded by the IN pad on 0.5 mm centres: every track in the block is 0.3 mm, which leaves the LIMIT_SW-to-GND gap at exactly the" (at 15.24 196.018592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "47a5d34e-9e6a-54eb-b341-960ddf9ad862"))
	(text "0.200 mm netclass rule. Move a run before widening it and re-run DRC after any change here." (at 15.24 198.558592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "112cf70e-3564-595f-8b82-bda1a0802416"))
	(text "ROUTE: +3.3V_SW has no reference-project class here (Default); the placing board classes the switched rail." (at 15.24 202.368592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "490a8fc6-172d-53e9-8c42-2c6566189139"))
	(polyline (pts (xy 219.5 36.482) (xy 399.5 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "640a0964-c610-5132-84b3-ddafc89fbf6b"))
	(text "2. Output pull-down and instrument tap" (at 219.5 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "bb02d968-8c6d-5db7-89aa-f08cac4eb59e"))
	(text "${1a5dbbac-981b-4337-8c39-817e15b42b3f:REFERENCE} (100 k) holds LIMIT_SW low while the debouncer is unpowered; ${fb894a4c-a934-4f36-81fc-dbadc5d06e8e:REFERENCE} (1 k) is the series tap from LIMIT_SW to LIMIT_SW_INST." (at 219.5 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "40a72f7e-7147-518d-af2e-bbac3b6485f0"))
	(text "Instrument tap series resistor" (at 224.58 73.406 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2032771d-3046-54fc-8b40-7fcd98267d4c"))
	(text "PLACE: ${1a5dbbac-981b-4337-8c39-817e15b42b3f:REFERENCE} sits above ${ed1d27a5-4fdc-4e73-a297-77a8487eb0d8:REFERENCE} with its LIMIT_SW pad on the OUT side, so LIMIT_SW and GND never need to cross; ${fb894a4c-a934-4f36-81fc-dbadc5d06e8e:REFERENCE} goes where LIMIT_SW leaves toward the" (at 219.5 78.486 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "04d10a9f-6c05-5b1b-a10c-a95c71706233"))
	(text "instrument port." (at 219.5 81.026 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5de22ce2-dd1b-5b06-8a34-e14d9182d1c9"))
	(text "ROUTE: LIMIT_SW and LIMIT_SW_INST leave through vias (port copper); LIMIT_SW_INST carries the INSTRUMENT class." (at 219.5 84.836 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8a14d134-f0c4-589d-a865-3e353951eb68"))
	(text "INTERFACES" (at 423.76 36.482 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "b740525a-4c54-53ff-b3f9-69a7fbd118db"))
	(text "Debouncer supply, 2.7 to 5.5 V; bind it to the switched domain of whatever LIMIT_SW drives, so the debouncer cannot back-power a powered-down" (at 423.76 46.99 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6c93435b-42ed-501e-97cc-c7da14d91b13"))
	(text "consumer through OUT." (at 423.76 49.53 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "03f6c7de-22fc-5b87-8909-8329e62ac6ae"))
	(text "Return; terminal pin 1 (the switch's other side), the Vcc bypass and the output pull-down." (at 423.76 59.69 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8c01f10a-fa2f-59a3-bae0-7c41ae63df4d"))
	(text "Debounced switch state, active low on contact closure and about 50 ms late; push-pull at Vcc levels while powered, held low by ${1a5dbbac-981b-4337-8c39-817e15b42b3f:REFERENCE} when" (at 423.76 72.39 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "aef2de75-2f16-5558-a718-c82342c38f7c"))
	(text "+3.3V_SW is off." (at 423.76 74.93 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "181aa209-5c11-5be3-b2b2-96d692b3e3be"))
	(text "Instrument tap of LIMIT_SW through ${fb894a4c-a934-4f36-81fc-dbadc5d06e8e:REFERENCE} (1 k), INSTRUMENT class; reads asserted while the switched rail is off." (at 423.76 87.63 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f01e8a87-321b-561c-a9a9-59aa5dd243c1"))
	(polyline (pts (xy 423.76 102.87) (xy 578.76 102.87)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "4b58c56d-f5b1-598b-9b5e-9f46c08ce14b"))
	(text "OPERATION" (at 423.76 105.41 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "c2bb8f0c-cbfa-530a-8d41-57efb02217f2"))
	(text "Signal path: ${fb560492-07c1-40ba-abbe-6bac76e602ff:REFERENCE} pin 2 -> IN -> ${ed1d27a5-4fdc-4e73-a297-77a8487eb0d8:REFERENCE} IN (pin 2) -> OUT (pin 3) -> LIMIT_SW, tapped through ${fb894a4c-a934-4f36-81fc-dbadc5d06e8e:REFERENCE} to LIMIT_SW_INST; ${fb560492-07c1-40ba-abbe-6bac76e602ff:REFERENCE} pin 1 is" (at 423.76 109.56 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5b524a0e-5a50-5ccd-a720-7b1da61c3e0e"))
	(text "GND. A closed contact pulls IN low; OUT follows IN non-inverting after the debounce (20 to 80 ms, 50 ms typical), so LIMIT_SW is active low and" (at 423.76 112.1 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cb5b00bb-8901-5cbf-9d69-da924985df44"))
	(text "asserts late: bound the homing approach velocity." (at 423.76 114.64 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ddfbadfa-657e-5986-85ae-ed05f05b098c"))
	(text "IN is complete inside ${ed1d27a5-4fdc-4e73-a297-77a8487eb0d8:REFERENCE}: internal pull-up 63 k typical, -25 to +25 V range, +/-15 kV air-gap ESD. No external pull-up, series resistor or" (at 423.76 118.45 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7150c283-b508-534e-a964-3346bd8dff45"))
	(text "capacitor on IN; a capacitor fights the debounce and degrades the ESD rating." (at 423.76 120.99 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5a413e2c-143b-5ebf-8dde-07d9913c09d8"))
	(text "Supply 2.7 to 5.5 V at 6 uA typical (UVLO 1.9 to 2.6 V). ${1a5dbbac-981b-4337-8c39-817e15b42b3f:REFERENCE} (100 k) defines LIMIT_SW low while +3.3V_SW is off, since the MAX6816 has no Ioff;" (at 423.76 124.8 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3c2adf2f-54b3-599d-b1f6-d476053fc2e8"))
	(text "the net idles high with a normally-open contact (about 33 uA at 3.3 V), so a capture on LIMIT_SW_INST reads asserted whenever the switched rail is" (at 423.76 127.34 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "877c4b8b-c762-5afa-97e1-7894b6daef7d"))
	(text "off." (at 423.76 129.88 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c1e76b1e-fd31-58be-88ed-9b7c311a8864"))
	(text "Same circuit as limit_switch_debounced_input plus the tap. ${fb560492-07c1-40ba-abbe-6bac76e602ff:REFERENCE} (Phoenix MCV 1,5/2-G-3,5) is pad-identical to the horizontal MC 1,5 but" (at 423.76 133.69 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2c6ef056-758b-5f29-a919-d5d1eea52b40"))
	(text "anchored on pin 1, with a 4.75 mm inboard courtyard and the wire leaving perpendicular to the board. Never rotate it 180 degrees to face outboard:" (at 423.76 136.23 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "44a73ff0-d93c-5cca-8375-69a3480b5584"))
	(text "that swaps GND and the switch node in board space." (at 423.76 138.77 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "794a6ad8-8739-588b-9703-bfba9194177a"))
	(polyline (pts (xy 423.76 150.2) (xy 578.76 150.2)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "54724404-d1ad-5824-83ad-d2a461268f5b"))
	(text "DESIGN CONTRACT" (at 423.76 152.74 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "74e365ed-f92e-591d-93ba-1fa306013fa2"))
	(text "Debounced limit-switch input with its own 2-position 3.5 mm VERTICAL, top-entry pluggable screw terminal — Phoenix MCV 1,5/2-G-3,5," (at 423.76 156.89 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cddcc864-8fca-587a-a396-d04df4d50fb6"))
	(text "OW-CONN-TBH-1X02-3P5-VERT, on the local orb_weaver_tht copy of the MCV footprint — plus a MAX6816 single switch debouncer and local Vcc" (at 423.76 159.43 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4add9f7f-71e7-5b23-a7e3-277826dd8fc8"))
	(text "decoupling. Four parts: nothing external belongs on the IN side, because the MAX6816 supplies its own IN pull-up and +/-15 kV ESD protection and" (at 423.76 161.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1d84c9ae-8929-53eb-95c8-27514b6a41b0"))
	(text "needs no external pull-up, series resistor, or input capacitor — the fourth part is a 100 kohm pull-down on the OUTPUT, doing an unrelated job." (at 423.76 164.51 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3e567156-3363-5571-9abc-00cd61e75ccc"))
	(text "Electrically identical to the horizontal limit_switch_debounced_input block, port for port and part for part including the pull-down: +3.3V_SW, GND," (at 423.76 167.05 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "58c73c39-d65f-5059-bc8f-c637cce0cf1f"))
	(text "LIMIT_SW." (at 423.76 169.59 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b72fe2bb-27f4-5e16-9c8f-e4cf3832ca73"))
	(text "Connect a dry-contact mechanical switch across the terminal; pin 1 is GND, pin 2 is the switch node, and the contact is polarity-agnostic. OUT" (at 423.76 172.13 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f08d39ef-1f8e-59e1-871f-02d1a616a8cb"))
	(text "follows IN non-inverting after roughly 50 ms of debounce, so LIMIT_SW is ACTIVE LOW on switch closure and asserts ~50 ms late — bound homing" (at 423.76 174.67 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1a006328-a47f-51da-ab3d-8f67454786a0"))
	(text "approach velocity so that delay cannot overshoot the mechanical stop." (at 423.76 177.21 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b5ebd625-8b69-508e-a079-8ceb86130a47"))
	(text "Supply +3.3V from the SWITCHED power domain on any board where LIMIT_SW drives a chip that can be powered down: if the debouncer stays alive" (at 423.76 179.75 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "99ae5ba2-2cc5-51fd-a896-83911d5fe7b9"))
	(text "while its consumer does not, OUT back-powers that chip through its input pin, by a route a GPIO bus switch cannot cover. On mouse-joystick-pcb" (at 423.76 182.29 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "288b69f9-b4a8-5a42-a9ef-125c5c6db324"))
	(text "that means +3V3_SW, and LIMIT_SW fans out to the TMC5130A REFL pin and to an always-on instrumentation buffer — it reaches no MCU GPIO in any" (at 423.76 184.83 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "99387886-dbdd-5f2b-93c8-fcf583c624c7"))
	(text "revision, decided 2026-08-16, so nothing downstream defines this net either." (at 423.76 187.37 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3724df80-c67e-5340-bca1-a17aae1b11bd"))
	(text "${1a5dbbac-981b-4337-8c39-817e15b42b3f:REFERENCE}, 100 kohm from LIMIT_SW to GND (OW-PASS-RC0402JR-07100KL, LCSC C106234), is what defines it while that domain is down, and it is" (at 423.76 189.91 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5f022e95-d61a-59f3-af3a-ba4e10562b08"))
	(text "REQUIRED, not optional: THE MAX6816 HAS NO Ioff. With Vcc at 0 V its push-pull OUT is undefined, and a board that taps LIMIT_SW for instrumentation" (at 423.76 192.45 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d09ca199-9f9c-5743-b6f6-d98d6efe8dc8"))
	(text "must put the tap buffer on the ALWAYS-ON rail — a buffer on the switched rail cannot observe the domain it is powering down with — so without this" (at 423.76 194.99 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3015bd11-46a3-5383-ad4a-418214d5f7cf"))
	(text "resistor a live, non-Schmitt CMOS input sees a floating source every time the switched domain is cycled, which on that board is the normal reset" (at 423.76 197.53 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "66f9f2bb-fdfd-52e4-a66c-6a12781c46c0"))
	(text "path. IT BELONGS IN THE BLOCK, NOT AT BOARD LEVEL, and that does not contradict the usual rule: that rule exists because a net shared between two" (at 423.76 200.07 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3b98be17-1651-5763-9209-ded679ce3ae1"))
	(text "instances of one block gets its pull halved, and LIMIT_SW is point-to-point inside a single instance — place this block twice and you get two" (at 423.76 202.61 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8fa059aa-d138-5aef-86ac-5904d54cda3f"))
	(text "switches, two debouncers and two independent LIMIT_SW nets, each with its own pull-down. The same call is already made in" (at 423.76 205.15 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "52710c99-a903-5391-b369-796e033f2dd4"))
	(text "quadrature_encoder_input_5v_sn74lvc2g17, whose R30005/R30006 cover Ioff high-Z on that block's outputs for exactly this reason; the case here is" (at 423.76 207.69 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c8494346-b3f7-5bfe-933c-990bb0e86b32"))
	(text "stronger, because the SN74LVC2G17 has Ioff and the MAX6816 does not." (at 423.76 210.23 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f6d1ea19-99ea-57f3-9ec5-cf4c469f0856"))
	(text "100 kohm AND NOT 10 kohm: this net idles HIGH, since a normally-open contact plus the internal IN pull-up puts OUT high whenever the axis is away" (at 423.76 212.77 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6c5744cf-c2f7-5eef-8c6c-0d062260f310"))
	(text "from the limit, so the pull-down conducts continuously in the normal state — 33 uA at 100 kohm against 330 uA at 10 kohm — and 100 kohm" (at 423.76 215.31 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "30ba381e-f988-52a3-8901-eff22165539f"))
	(text "spends no meaningful VOH margin either." (at 423.76 217.85 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8029ceb5-db24-5120-bb67-135abb8891a0"))
	(text "KNOW THE POLARITY CONSEQUENCE BEFORE TRUSTING A CAPTURE: LIMIT_SW is active low, so this resistor makes an instrument tap read ASSERTED, limit" (at 423.76 220.39 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a7d5013a-3d70-5a07-9631-78a050a01b82"))
	(text "reached, whenever the switched rail is off. Defined-but-untrue is the deliberate trade against floating, and the analysis layer must gate the channel" (at 423.76 222.93 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7eaeb040-4830-5700-b11e-2b88d35b0202"))
	(text "on rail state. A pull-up is not an alternative — it would have to reference the switched rail, which is at 0 V exactly when it would be needed." (at 423.76 225.47 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1b9f632e-190c-529f-87ae-00061d468a19"))
	(text "Bring REFL to a labelled test pad at board level so a jumper can force a closure during bring-up. Add no capacitor on IN — it fights the debounce" (at 423.76 228.01 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "395c353f-e9b0-52bd-9ea7-260687efd334"))
	(text "and degrades the ESD rating. Keep the decoupling hard against Vcc." (at 423.76 230.55 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d5a054aa-8cd7-50a4-aecc-7280d2dd21c4"))
	(text "ROUTING THE PULL-DOWN IS TIGHT, AND IT IS AT THE LIMIT: ${1a5dbbac-981b-4337-8c39-817e15b42b3f:REFERENCE} sits above the MAX6816 with its LIMIT_SW pad on the same side as the IC's OUT" (at 423.76 233.09 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6f767ee4-b505-5928-a49d-49f94cb489a0"))
	(text "pin, so the two nets never need to cross — but they share a corridor bounded by the IN pad and sit on 0.5 mm centres. EVERY TRACK IN THIS BLOCK" (at 423.76 235.63 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7f0b5847-411c-5ad9-a6a8-a223a9cbf76c"))
	(text "IS THEREFORE 0.3 mm, not the 0.4 mm it was authored at, which puts the LIMIT_SW-to-GND gap at exactly 0.200 mm against a 0.200 mm netclass" (at 423.76 238.17 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fb340e65-727b-5e3b-99b7-116a3bb9dd03"))
	(text "rule and the GND-to-IN-pad gap at 0.225 mm: DRC-clean with ZERO MARGIN on the first of those. Do not widen either run without moving it first —" (at 423.76 240.71 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "035026b3-c2ad-524d-8b69-d99beba12863"))
	(text "0.4 mm on these centres is a 0.100 mm gap, which sits exactly on the JLCPCB routine copper floor in .kicad_dru and errors under any 0.2 mm" (at 423.76 243.25 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d025f0d0-a7c9-538d-bd76-6b942cc3646b"))
	(text "netclass. There is room to move: the LIMIT_SW column can go about 0.5 mm further from GND, straight up out of OUT. Re-run DRC after any change" (at 423.76 245.79 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a2ba90e1-d5ab-50e3-bc48-68caedc1bf3c"))
	(text "here, because design_block_tools.py check counts only unconnected items and is blind to a clearance error." (at 423.76 248.33 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3e4f9b13-d453-54e5-984a-af9005545a3c"))
	(text "THIS BLOCK IS A FORK BY CHOICE, NOT BY GEOMETRY. Unlike usb2_vertical and pycontrol_behavior_port_rj45_boundary_vertical, whose land patterns are" (at 423.76 250.87 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1183e4bc-8337-5e72-bc6e-a8db178b9ec2"))
	(text "unrelated to their horizontal counterparts, this footprint is pad-identical to the horizontal MC 1,5/2-G-3,5: both are 1.8 x 3.6 mm pads on a 1.2 mm" (at 423.76 253.41 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "89bd1e78-dabc-5d9e-973f-3b3c6a00024c"))
	(text "drill at 3.50 mm pitch, pin order ascending in +x. The copper is a drop-in; only the footprint ANCHOR moves, because the horizontal is centred on" (at 423.76 255.95 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2034e683-d1dc-579c-92c9-3d4664f40329"))
	(text "the pad array with pin 1 at (-1.75, 0) while the vertical puts pin 1 at the origin. Migrating an existing placement therefore means changing the part" (at 423.76 258.49 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "193c5d42-6024-5a93-a6fb-c610217b5406"))
	(text "and then MOVING THE FOOTPRINT BY (-1.75, 0) so pad 1 returns to its old absolute position; skip that and the whole connector translates by 1.75" (at 423.76 261.03 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9a50ffd5-921d-53d5-a017-91ac1847d8cb"))
	(text "mm and drags every attached track with it. The two parts are genuinely interchangeable at the catalog level and belong to equiv_group" (at 423.76 263.57 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f61b60c6-27a1-512c-b62f-f52f4be4864d"))
	(text "conn-tbh-1x02-3p5, which docs/connector-orientation-plan.md specifies but which is not yet populated on any row — treat it as owed. Because the" (at 423.76 266.11 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "da344b97-5747-5dea-b249-de5a4ccc592a"))
	(text "pads are identical, the two layouts stay transferable in either direction once the connector is shifted by (-1.75, 0)." (at 423.76 268.65 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "20933b07-23fd-567e-8df7-8798ca0ecec5"))
	(text "What actually changes is the mechanical envelope, and it inverts. Relative to pad 1 the horizontal courtyard runs x -2.45 to +5.95, y -2.00 to +8.25;" (at 423.76 271.19 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f1de9e88-b179-5096-8638-6f64009b0fbe"))
	(text "the vertical runs x -2.95 to +6.45, y -4.75 to +3.50. The outboard overhang collapses from 8.25 mm to 3.50 mm, so the terminal can move inboard" (at 423.76 273.73 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9aabf1f6-29f6-59ea-a73f-a48bbe331c1d"))
	(text "and the board outline notes change — but the INBOARD KEEPOUT GROWS from 2.00 mm to 4.75 mm, so a swap in place can collide with whatever sits" (at 423.76 276.27 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bcf68739-481f-523a-9cb4-6ba1d88bafcd"))
	(text "behind the connector even though no pad moved. DO NOT ROTATE 180 DEGREES to make the wire entry face outboard: pin order runs the same" (at 423.76 278.81 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c9957fbe-4e7e-58dd-8ed0-806e806a9caa"))
	(text "direction in both footprints, and rotating reverses it in board space, silently swapping GND and the switch node. The wire now leaves perpendicular to" (at 423.76 281.35 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ffa4b32a-414a-55f0-866b-db698abbe1a7"))
	(text "the board, so the enclosure in ../mouse-joysticks-mech needs an aperture above the terminal plus clearance for the screw head, the mating plug," (at 423.76 283.89 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4612e08d-79cd-5eef-9cd0-0cfa2986496c"))
	(text "and the wire loop." (at 423.76 286.43 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "64bf62fa-b526-5384-8bf7-0f5736b0cf03"))
	(text "Project-local pending bench verification; promotable once a second board uses it." (at 423.76 288.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "217a36b2-12b7-5325-a949-c37c2e5743b6"))
	(group "Review page 01: 1. Switch terminal and debouncer" (uuid "9b0cf95f-51e9-5f18-a103-91534e9538dc") (members "877edc0d-8517-4bfb-9a8a-87ef2f65742a" "0e2bb513-e56d-5c80-904b-83c90045fecb" "6e733d23-d811-5766-9018-c9f458eb416d" "d0a1154c-7106-583f-8fdb-d0be56960584" "b8084bf6-4717-5ba0-ab12-6a542be0a304" "fb560492-07c1-40ba-abbe-6bac76e602ff" "2d6c55ba-eba8-51d9-a3c3-4219d79e8c44" "83e4bcec-370a-5bf0-8521-d4ae24b76274" "630013f6-cf18-51f7-a984-1afaa8988b16" "87080ebf-6335-51d9-94d4-67f8f6011bb5" "1a5dbbac-981b-4337-8c39-817e15b42b3f" "d1f9ded9-a43e-595f-8c42-a09450ce3cef" "82eb9393-376c-5fc6-926d-ee857f125599" "895bb29f-b8ac-5c7d-b841-30805280952e" "9e107436-0d2b-5588-849d-6a35edfeb557" "ed1d27a5-4fdc-4e73-a297-77a8487eb0d8" "3080a60d-3fa1-5e84-ad28-9dc674e57124" "2870ebdb-6e06-5d1d-8a22-a5cb7d5a1447" "9fdf7590-a39d-5ee9-b742-567480b2ec3a" "b8f76227-c94e-53aa-84da-602e10686fa7" "b0a58337-b774-5066-a28b-0b0eb314e776" "6b2f3129-31a2-57e1-82e4-4d20eaac750d" "d4b295f7-7fcd-5d48-b505-2fb5bef6a492" "91590efe-c86b-5e08-8d14-9a4194d25892" "15c9c593-fab7-5995-bd21-1f6c0146bc68" "6da381b1-8526-55b7-bdfd-6c527e0a0e9a" "edf556de-e36b-5c44-8992-fd545f8e10ed" "b739062c-d679-5674-93d0-44ffc921cee5" "227cee12-b1d9-5886-8190-979d23e0764a" "53f44c71-b88e-55ca-bb05-677e518a3e22" "48b5b603-41e6-5809-bacf-26012e6bda90" "1a610c75-202f-566e-b6a8-9e40d7d86085" "31fa7b85-e705-5367-a35b-24cb13a7a7cd" "603a35ca-98ac-5c7c-84c3-7d66943a6d57" "d207cac3-0d70-558b-95d3-7cf6fc577517" "47a5d34e-9e6a-54eb-b341-960ddf9ad862" "112cf70e-3564-595f-8b82-bda1a0802416" "490a8fc6-172d-53e9-8c42-2c6566189139"))
	(group "Review page 02: 2. Output pull-down and instrument tap" (uuid "ec45625c-338e-58a4-a6d8-49706b6a4523") (members "fb894a4c-a934-4f36-81fc-dbadc5d06e8e" "eacaa034-ad3a-5f7e-ab0f-20a851f6ec00" "b7e4acd2-0f76-5bc8-9c52-97e5ce717b60" "4199592f-f8c5-5867-8eef-547dd592e5e2" "432109e4-3f72-56c2-a24f-1f6d9efddf67" "640a0964-c610-5132-84b3-ddafc89fbf6b" "bb02d968-8c6d-5db7-89aa-f08cac4eb59e" "40a72f7e-7147-518d-af2e-bbac3b6485f0" "2032771d-3046-54fc-8b40-7fcd98267d4c" "04d10a9f-6c05-5b1b-a10c-a95c71706233" "5de22ce2-dd1b-5b06-8a34-e14d9182d1c9" "8a14d134-f0c4-589d-a865-3e353951eb68"))
	(group "Review page 03: Interfaces" (uuid "c2b9e9ea-27c0-53cd-8ac7-6b1b1ffedb7f") (members "24b3492c-1f5c-5d21-b3e5-118dae09c674" "a4676273-da4d-5ef5-92f1-07f23fb85398" "8ed0df95-5fae-58ac-b47a-77e397ad3a12" "38eae518-5b4c-550f-9698-18f5d3db6211" "918ce313-6cb8-5720-9d85-9d467da3d645" "0bc94d36-ebd5-5438-a727-ce5b573c9201" "a4e794f8-bf4f-5e2f-9cdb-80b17b656b82" "209b4843-c27c-5f52-98e1-be01bdf1fcc6" "934b8cec-64b8-58ed-accb-4fd8714b935c" "c91cca25-beb7-5aa4-92b6-740aa4b114e4" "40a740c0-01ed-53c6-8ffe-ffd054931a61" "939ba411-2251-5e4f-8305-85d911e8b4f9" "b740525a-4c54-53ff-b3f9-69a7fbd118db" "6c93435b-42ed-501e-97cc-c7da14d91b13" "03f6c7de-22fc-5b87-8909-8329e62ac6ae" "8c01f10a-fa2f-59a3-bae0-7c41ae63df4d" "aef2de75-2f16-5558-a718-c82342c38f7c" "181aa209-5c11-5be3-b2b2-96d692b3e3be" "f01e8a87-321b-561c-a9a9-59aa5dd243c1"))
	(group "Review page 04: Operation and PCB guidance" (uuid "ae60211e-2989-5d6f-8992-5d6aa0c49d71") (members "4b58c56d-f5b1-598b-9b5e-9f46c08ce14b" "c2bb8f0c-cbfa-530a-8d41-57efb02217f2" "5b524a0e-5a50-5ccd-a720-7b1da61c3e0e" "cb5b00bb-8901-5cbf-9d69-da924985df44" "ddfbadfa-657e-5986-85ae-ed05f05b098c" "7150c283-b508-534e-a964-3346bd8dff45" "5a413e2c-143b-5ebf-8dde-07d9913c09d8" "3c2adf2f-54b3-599d-b1f6-d476053fc2e8" "877c4b8b-c762-5afa-97e1-7894b6daef7d" "c1e76b1e-fd31-58be-88ed-9b7c311a8864" "2c6ef056-758b-5f29-a919-d5d1eea52b40" "44a73ff0-d93c-5cca-8375-69a3480b5584" "794a6ad8-8739-588b-9703-bfba9194177a" "54724404-d1ad-5824-83ad-d2a461268f5b" "74e365ed-f92e-591d-93ba-1fa306013fa2" "cddcc864-8fca-587a-a396-d04df4d50fb6" "4add9f7f-71e7-5b23-a7e3-277826dd8fc8" "1d84c9ae-8929-53eb-95c8-27514b6a41b0" "3e567156-3363-5571-9abc-00cd61e75ccc" "58c73c39-d65f-5059-bc8f-c637cce0cf1f" "b72fe2bb-27f4-5e16-9c8f-e4cf3832ca73" "f08d39ef-1f8e-59e1-871f-02d1a616a8cb" "1a006328-a47f-51da-ab3d-8f67454786a0" "b5ebd625-8b69-508e-a079-8ceb86130a47" "99ae5ba2-2cc5-51fd-a896-83911d5fe7b9" "288b69f9-b4a8-5a42-a9ef-125c5c6db324" "99387886-dbdd-5f2b-93c8-fcf583c624c7" "3724df80-c67e-5340-bca1-a17aae1b11bd" "5f022e95-d61a-59f3-af3a-ba4e10562b08" "d09ca199-9f9c-5743-b6f6-d98d6efe8dc8" "3015bd11-46a3-5383-ad4a-418214d5f7cf" "66f9f2bb-fdfd-52e4-a66c-6a12781c46c0" "3b98be17-1651-5763-9209-ded679ce3ae1" "8fa059aa-d138-5aef-86ac-5904d54cda3f" "52710c99-a903-5391-b369-796e033f2dd4" "c8494346-b3f7-5bfe-933c-990bb0e86b32" "f6d1ea19-99ea-57f3-9ec5-cf4c469f0856" "6c5744cf-c2f7-5eef-8c6c-0d062260f310" "30ba381e-f988-52a3-8901-eff22165539f" "8029ceb5-db24-5120-bb67-135abb8891a0" "a7d5013a-3d70-5a07-9631-78a050a01b82" "7eaeb040-4830-5700-b11e-2b88d35b0202" "1b9f632e-190c-529f-87ae-00061d468a19" "395c353f-e9b0-52bd-9ea7-260687efd334" "d5a054aa-8cd7-50a4-aecc-7280d2dd21c4" "6f767ee4-b505-5928-a49d-49f94cb489a0" "7f0b5847-411c-5ad9-a6a8-a223a9cbf76c" "fb340e65-727b-5e3b-99b7-116a3bb9dd03" "035026b3-c2ad-524d-8b69-d99beba12863" "d025f0d0-a7c9-538d-bd76-6b942cc3646b" "a2ba90e1-d5ab-50e3-bc48-68caedc1bf3c" "3e4f9b13-d453-54e5-984a-af9005545a3c" "1183e4bc-8337-5e72-bc6e-a8db178b9ec2" "89bd1e78-dabc-5d9e-973f-3b3c6a00024c" "2034e683-d1dc-579c-92c9-3d4664f40329" "193c5d42-6024-5a93-a6fb-c610217b5406" "9a50ffd5-921d-53d5-a017-91ac1847d8cb" "f61b60c6-27a1-512c-b62f-f52f4be4864d" "da344b97-5747-5dea-b249-de5a4ccc592a" "20933b07-23fd-567e-8df7-8798ca0ecec5" "f1de9e88-b179-5096-8638-6f64009b0fbe" "9aabf1f6-29f6-59ea-a73f-a48bbe331c1d" "bcf68739-481f-523a-9cb4-6ba1d88bafcd" "c9957fbe-4e7e-58dd-8ed0-806e806a9caa" "ffa4b32a-414a-55f0-866b-db698abbe1a7" "4612e08d-79cd-5eef-9cd0-0cfa2986496c" "64bf62fa-b526-5384-8bf7-0f5736b0cf03" "217a36b2-12b7-5325-a949-c37c2e5743b6"))
	(embedded_fonts no)
)
